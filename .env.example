# Konfigurasi Backend API (auto-fill OHLC)
# HANYA untuk DEV LOKAL saat menjalankan backend Python sendiri:
#   python -m uvicorn api.trading:app --host 127.0.0.1 --port 8000
# JANGAN set variabel ini di Vercel/production — biarkan KOSONG/unset supaya
# frontend memakai path relative "/api/trading" (fungsi Python Vercel).
# Mengisinya dengan URL localhost di production = mixed-content → "Koneksi bermasalah".
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Konfigurasi Bot Telegram (Gatekeeper)
BOT_TOKEN=telegram_bot_token_kamu
GROUP_ID=-1001234567890
JWT_SECRET=super_secret_jwt_key_kamu
NEXT_PUBLIC_SITE_URL=https://nama-aplikasi-kamu.vercel.app

# Konfigurasi AI Analisa (Google Gemini)
# Dapatkan API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=gemini_api_key_kamu
# Opsional, default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
