//@version=5
indicator("SMC Matrix + LuxAlgo + Yata S&R [Combined - Auto Backtest + Fresh Zone Engine]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =====================================================================================================================
// 🌟 BAGIAN 1: INPUT PARAMETER (SCALPING MATRIX)
// =====================================================================================================================
marketMode    = input.string("Forex/Gold", title="Pilih Market", options=["Forex/Gold", "Saham Indonesia (IDX)"], group="Matrix: Inti")
swingLength   = input.int(10, title="Sensitivitas Swing (Scalping)", minval=2, group="Matrix: Inti")
extendLines   = input.bool(true, title="Perpanjang Garis ke Kanan", group="Matrix: Inti")
showDash      = input.bool(true, title="Tampilkan Dashboard Panel", group="Matrix: Inti")
showFibo      = input.bool(true, title="Tampilkan Level Fibo + Zona", group="Matrix: Inti")
showBigSignal = input.bool(true, title="Tampilkan Tulisan Besar di Chart", group="Matrix: Inti")

autoMTF       = input.bool(true, title="Auto MTF (ikut TF chart)",      group="Matrix: Hierarki MTF", tooltip="ON: TF Bias & Zona otomatis menyesuaikan chart yang sedang dibuka — cocok scalping M1/M3/M5/M15. OFF: pakai TF manual di bawah.\n\nPeta auto (Chart : Zona : Bias):\nM1  : M5  : M15\nM3  : M15 : H1\nM5  : M15 : H1\nM15 : H1  : H4")
tfBias        = input.timeframe("15", title="TF Bias / Arah (manual)",       group="Matrix: Hierarki MTF")
tfZone        = input.timeframe("5",  title="TF Konfirmasi / Zona (manual)",  group="Matrix: Hierarki MTF")

useRSI        = input.bool(true,  title="Aktifkan Filter RSI",        group="Matrix: Filter Konfirmasi")
matrixRsiLen  = input.int(14,     title="Panjang RSI Matrix",         group="Matrix: Filter Konfirmasi", minval=2)
rsiBuyMax     = input.int(72,     title="RSI Maks untuk BUY",         group="Matrix: Filter Konfirmasi")
rsiSellMin    = input.int(28,     title="RSI Min untuk SELL",         group="Matrix: Filter Konfirmasi")
maxEmaDistPct = input.float(0.8,  title="Maks Jarak dari EMA200 (%)",  group="Matrix: Filter Konfirmasi", step=0.1)
minFvgPct     = input.float(0.03, title="Ukuran Minimal FVG (%)",      group="Matrix: Filter Konfirmasi", step=0.01)
minScore      = input.int(5,      title="Skor Minimal Sinyal Sniper",  group="Matrix: Filter Konfirmasi", minval=1, maxval=6)
requireOBEntry    = input.bool(true, title="Entry WAJIB di Order Block (Sniper)", group="Matrix: Filter Konfirmasi", tooltip="Sinyal hanya valid jika harga berada di dalam Order Block internal yang searah. Mengurangi jumlah sinyal tapi menaikkan kualitas.")
useConfirmedClose = input.bool(true, title="Anti-Repaint (Tunggu Candle Close)",  group="Matrix: Filter Konfirmasi", tooltip="Sinyal eksekusi hanya dikunci setelah candle ditutup. Sedikit lebih lambat tapi tidak repaint (tidak berpindah/hilang).")

useSession    = input.bool(true,  title="Hanya Entry di Killzone (Forex)", group="Matrix: Filter Sesi", tooltip="Otomatis Nonaktif jika Mode Saham")
killzone      = input.session("1300-1700", title="Jam Killzone (UTC)",  group="Matrix: Filter Sesi")

atrLen        = input.int(14,     title="Panjang ATR",                 group="Matrix: Manajemen Risiko", minval=1)
slAtrMult     = input.float(1.2,  title="SL = ATR x ... (fallback)",   group="Matrix: Manajemen Risiko", step=0.1)
useStructSL   = input.bool(true,  title="SL Berbasis Struktur",        group="Matrix: Manajemen Risiko")
structBuffer  = input.float(0.5,  title="Buffer Struktur (x ATR)",     group="Matrix: Manajemen Risiko", step=0.1)

tp1RR         = input.float(0.5,  title="Target TP 1 (Parsial)",       group="Matrix: Manajemen Risiko", step=0.1)
tp2RR         = input.float(1.0,  title="Target TP 2 (Aman)",          group="Matrix: Manajemen Risiko", step=0.1)
tpRR          = input.float(1.5,  title="Target R:R Final",            group="Matrix: Manajemen Risiko", step=0.1)

spreadBuffer  = input.float(3.0,  title="Buffer Spread/Fee",           group="Matrix: Manajemen Risiko", step=0.1)
accountSize   = input.float(1000, title="Modal Akun (USD/IDR)",        group="Matrix: Manajemen Risiko", minval=1, tooltip="Gunakan USD untuk Forex, IDR (Rupiah) untuk Saham")
riskPct       = input.float(1.0,  title="Risiko per Trade (%)",        group="Matrix: Manajemen Risiko", step=0.1)
goldValPerPt  = input.float(100.0, title="Nilai/Poin per 1 lot ($) Forex", group="Matrix: Manajemen Risiko", step=0.01, tooltip="Nilai uang dari 1.0 pergerakan harga penuh, per 1 lot. XAUUSD umumnya 100 (1 lot = $100 per gerak $1.0). SESUAIKAN dengan kontrak broker Anda.")
wrTargetMode  = input.string("TP Final", title="Backtest: Ukur Menang di", options=["TP1 (0.5R)","TP2 (1.0R)","TP Final"], group="Matrix: Manajemen Risiko", tooltip="Target yang dipakai engine backtest untuk hitung Menang/Kalah. 'TP Final' = paling jujur. 'TP1' menggembungkan win rate (tidak disarankan).")

// =====================================================================================================================
// 🌟 BAGIAN 1B: INPUT PARAMETER (DYNAMIC FRESH ZONE ENGINE) — BARU (ADDITIVE)
// =====================================================================================================================
ZE_GROUP = "Zone Engine: Dynamic Fresh Zone (S&D)"
zoneEngineOn    = input.bool(true,  title="Aktifkan Dynamic Fresh Zone Engine", group=ZE_GROUP, tooltip="Supply & Demand dinamis: zona yang ditembus CLOSE penuh otomatis dihapus, hitung mitigasi (touch), kualitas, prioritas, auto-merge, dan expired. Semua validasi memakai candle close (anti-repaint).")
freshOnlyInput  = input.bool(true,  title="Enable Fresh Zone Only",             group=ZE_GROUP, tooltip="ON: zona yang sudah break langsung DIHAPUS, tidak dipakai entry, tidak dihitung dashboard. OFF: zona break tetap tampil abu-abu (seperti versi lama) tapi tetap tidak dipakai entry.")
useZoneEntry    = input.bool(true,  title="Entry WAJIB di Zona Berkualitas",    group=ZE_GROUP, tooltip="BUY hanya boleh di Demand fresh/berkualitas, SELL hanya boleh di Supply fresh/berkualitas (FITUR 13). Matikan untuk kembali ke logika entry lama.")
minZoneQuality  = input.int(75,     title="Kualitas Minimal Entry (%)",         group=ZE_GROUP, minval=25, maxval=100, step=25, tooltip="Fresh=100%, 1 Touch=75%, 2 Touch=50%, 3 Touch=25%, Broken=0%.")
maxTouchInput   = input.int(2,      title="Maximum Touch Before Delete",        group=ZE_GROUP, minval=1, maxval=5, tooltip="Zona yang disentuh LEBIH dari batas ini dihapus otomatis (FITUR 5).")
maxZoneAgeInput = input.int(100,    title="Maximum Zone Age (candle)",          group=ZE_GROUP, minval=20, tooltip="Zona yang tidak terpakai selama N candle dihapus otomatis (FITUR 10).")
zoneMTFOn       = input.bool(true,  title="Zona dari TF Konfirmasi (MTF)",      group=ZE_GROUP, tooltip="ON: zona diambil dari TF Konfirmasi/Zona hierarki MTF — chart M5 memakai zona M15, trigger & retest tetap di M5 (FITUR 14). OFF: zona dari TF chart.")
zonePivotLen    = input.int(5,      title="Sensitivitas Pivot Zona (HTF)",      group=ZE_GROUP, minval=2, tooltip="Kiri/kanan bar pivot di TF zona untuk mendeteksi Swing High/Low pembentuk Supply & Demand.")
maxZonesPerSide = input.int(4,      title="Maks Zona per Sisi (Supply/Demand)", group=ZE_GROUP, minval=1, maxval=10, tooltip="Pembatas jumlah box agar chart bersih & ringan (FITUR 16). Zona tertua dihapus jika penuh.")
showZoneEngine  = input.bool(true,  title="Tampilkan Box Zona di Chart",        group=ZE_GROUP)

// =====================================================================================================================
// 🌟 BAGIAN 1C: INPUT PARAMETER (PHASE 2 — INSTITUTIONAL SNIPER ENGINE) — BARU (ADDITIVE)
// =====================================================================================================================
INST_GROUP = "Institutional: Phase 2 Sniper Engine"
instEngineOn     = input.bool(true,  title="Aktifkan Institutional Sniper Engine", group=INST_GROUP, tooltip="Master switch Phase 2: Liquidity Sweep, Liquidity Map, OTE, Confluence, OB Quality, Premium/Discount, Session Scoring, Confidence Engine, Smart TP/SL. OFF = indikator bekerja persis seperti sebelumnya.")
requireLiqSweep  = input.bool(true,  title="Require Liquidity Sweep",              group=INST_GROUP, tooltip="BUY hanya setelah Sell Side Liquidity diambil; SELL hanya setelah Buy Side Liquidity diambil (FITUR 19). OFF = indikator bekerja seperti sekarang.")
liqSweepLookback = input.int(30,     title="Masa Berlaku Sweep (bar)",             group=INST_GROUP, minval=5, tooltip="Sweep dianggap masih relevan selama N bar setelah terjadi.")
showLiqMap       = input.bool(true,  title="Tampilkan Liquidity Map",              group=INST_GROUP, tooltip="Garis tipis abu-abu: BSL/SSL/EQH/EQL, internal & eksternal. Liquidity yang sudah diambil dibuat transparan (FITUR 20).")
maxLiqPerSide    = input.int(6,      title="Maks Garis Liquidity per Sisi",        group=INST_GROUP, minval=2, maxval=12, tooltip="Pembatas jumlah garis agar chart bersih & ringan (FITUR 33).")
requireOTE       = input.bool(true,  title="Require OTE Zone (0.618–0.786)",       group=INST_GROUP, tooltip="Entry hanya valid saat retracement berada di dalam OTE Zone Fibonacci 0.618 / 0.705 / 0.786 (FITUR 21).")
showOTEBox       = input.bool(true,  title="Tampilkan Box OTE",                    group=INST_GROUP)
requirePremDisc  = input.bool(true,  title="Require Premium/Discount",             group=INST_GROUP, tooltip="BUY hanya di zona Discount, SELL hanya di zona Premium (FITUR 24).")
minConfidence    = input.int(90,     title="Minimum Confidence (%)",               group=INST_GROUP, minval=0, maxval=100, tooltip="Entry hanya muncul jika Confidence >= nilai ini (FITUR 27-28). Di bawah 70 selalu ditolak saat engine aktif.")
minATRInput      = input.float(0.0,  title="Minimum ATR (satuan harga)",           group=INST_GROUP, minval=0, step=0.01, tooltip="0 = nonaktif. Jika ATR di bawah nilai ini, jangan entry — pasar terlalu sepi (FITUR 26).")
maxSpreadPct     = input.float(30.0, title="Maximum Spread Buffer (% dari ATR)",   group=INST_GROUP, minval=0, step=5, tooltip="0 = nonaktif. Jika Buffer Spread/Fee lebih besar dari persentase ATR ini, jangan entry — biaya terlalu mahal dibanding volatilitas (FITUR 26).")
sessAsia         = input.session("2300-0700", title="Sesi Asia (UTC)",             group=INST_GROUP)
sessLondon       = input.session("0700-1200", title="Sesi London (UTC)",           group=INST_GROUP)
sessOverlap      = input.session("1200-1600", title="Sesi Overlap LDN+NY (UTC)",   group=INST_GROUP)
sessNY           = input.session("1600-2100", title="Sesi New York (UTC)",         group=INST_GROUP)
showInstDash     = input.bool(true,  title="Tampilkan Dashboard Institutional",    group=INST_GROUP)
showSniperBig    = input.bool(true,  title="Tampilkan Label SNIPER BUY/SELL",      group=INST_GROUP)

// =====================================================================================================================
// 🌟 BAGIAN 1D: INPUT PARAMETER (PHASE 3 — ADAPTIVE AI ENGINE) — BARU (ADDITIVE)
// =====================================================================================================================
AI_GROUP = "AI Engine: Phase 3 Adaptive"
aiEngineOn     = input.bool(true, title="Aktifkan Adaptive AI Engine (Phase 3)",      group=AI_GROUP, tooltip="Master switch Phase 3: Market Regime, Adaptive Confidence, Entry Quality, Institutional Grade, Dynamic Risk/TP, Order Flow Bias, Smart Trade Management, Performance & panel AI. OFF = perilaku persis Phase 2.")
adaptiveConfOn = input.bool(true, title="Adaptive Confidence (ikut Market Regime)",   group=AI_GROUP, tooltip="Bobot Confidence berubah otomatis sesuai kondisi market (FITUR 37). OFF = bobot statis Phase 2.")
entryQualityOn = input.bool(true, title="Filter Kualitas Candle Entry",               group=AI_GROUP, tooltip="Tolak entry jika candle jelek: momentum lemah, wick besar, ATR rendah, volume rendah, spread mahal (FITUR 38). Alasan penolakan tampil di panel AI.")
showAIDash     = input.bool(true, title="Tampilkan Panel AI Engine (kiri-tengah)",    group=AI_GROUP)

// =====================================================================================================================
// 🌟 BAGIAN 1E: INPUT PARAMETER (PHASE 3.5 — DECISION CORE) — BARU (ADDITIVE)
// =====================================================================================================================
DC_GROUP = "Decision Core: Phase 3.5"
dcEngineOn   = input.bool(true, title="Aktifkan Decision Core (Hakim Akhir)",          group=DC_GROUP, tooltip="Satu-satunya sumber keputusan final: BUY / SELL / WAIT. Semua engine lain hanya penyedia data. Keputusan mengikuti hierarki: HTF Bias → Regime → Fresh S&D → Liquidity Sweep → OTE → Order Block → FVG → Premium/Discount → Entry Quality → Confidence. OFF = perilaku persis Phase 3.")
dcConflictOn = input.bool(true, title="Conflict Detection + Consistency Validator",    group=DC_GROUP, tooltip="Trend Bullish tapi harga di Fresh Supply aktif → WAIT (dan sebaliknya). Validator berjalan SEBELUM sinyal muncul (FITUR 52 & 59).")
dcSignalLock = input.bool(true, title="Signal Lock (sembunyikan sinyal saat WAIT)",    group=DC_GROUP, tooltip="Saat Decision Core = WAIT: label BUY/SELL tidak muncul, alert BUY/SELL tidak terkirim, tulisan besar disembunyikan, status panel = WAIT (FITUR 53).")
showDCDash   = input.bool(true, title="Tampilkan Panel 🧠 DECISION CORE (bawah-tengah)", group=DC_GROUP)

// =====================================================================================================================
// 🌟 BAGIAN 1F: INPUT PARAMETER (FINAL RELEASE — UX, TEMA, WIZARD) — BARU (ADDITIVE)
// =====================================================================================================================
UX_GROUP  = "Final Release: Tampilan & Mode"
WIZ_GROUP = "Final Release: 🧭 Setup Wizard & Preset"

dashModeInput  = input.string("Professional", title="Dashboard Mode", options=["Simple", "Professional"], group=UX_GROUP, tooltip="Simple: hanya 1 panel ringkas berbahasa mudah — status 🟢 Siap Beli / 🔴 Siap Jual / ⏸ Tunggu Dulu, SL, TP, 🎯 Tingkat Keyakinan, alasan singkat, dan 📌 Yang Harus Dilakukan. Professional: seluruh panel detail seperti biasa.")
simplePosInput = input.string("Kanan Atas", title="Posisi Panel Simple", options=["Kanan Atas", "Kanan Tengah", "Kanan Bawah", "Kiri Atas", "Kiri Tengah", "Kiri Bawah"], group=UX_GROUP)
simpleSizeInput= input.string("Sedang", title="Ukuran Panel Simple", options=["Kecil", "Sedang", "Besar"], group=UX_GROUP)
dashPosInput   = input.string("Kanan Atas", title="Posisi Dashboard Utama (Pro)", options=["Kanan Atas", "Kanan Tengah", "Kanan Bawah", "Kiri Atas", "Kiri Tengah", "Kiri Bawah"], group=UX_GROUP)
themeInput     = input.string("Dark", title="Theme", options=["Dark", "Light", "Minimal", "Professional Blue"], group=UX_GROUP, tooltip="Warna konsisten di semua panel: Hijau=Bullish, Merah=Bearish, Kuning=Peringatan/Wait, Abu=Informasi, Biru=Header.")
autoHideOn     = input.bool(true, title="Auto Hide Objek Arah Berlawanan", group=UX_GROUP, tooltip="Saat 🟢 Siap Beli: zona Supply diredupkan. Saat 🔴 Siap Jual: zona Demand diredupkan. Saat ⏸ Tunggu Dulu: garis SL/TP & box OTE disembunyikan. Chart jadi jauh lebih bersih.")
smartAlertOn   = input.bool(true, title="Smart Alert (pesan lengkap & mudah dibaca)", group=UX_GROUP, tooltip="Alert dinamis berisi: simbol, timeframe, status, harga, SL, TP, 🎯 Tingkat Keyakinan, ⭐ Kualitas Setup, dan alasan singkat. Aktifkan lewat 'Any alert() function call' saat membuat alert di TradingView.")
waitAlertOn    = input.bool(false, title="Alert Saat Status WAIT Berubah", group=UX_GROUP, tooltip="Kirim pesan '⏸ BELUM ADA ENTRY — sedang menunggu: ...' setiap syarat yang ditunggu berganti. Default OFF agar tidak ramai.")

wizMarket      = input.string("Gold", title="🧭 Apa yang akan Anda trading?", options=["Gold", "Forex", "Crypto", "Index"], group=WIZ_GROUP, tooltip="Setup Wizard: pilihan Anda dipakai untuk menampilkan SARAN pengaturan terbaik di panel ⚙ STATUS SISTEM. Catatan: TradingView tidak mengizinkan script mengubah nilai input secara otomatis, jadi saran diterapkan manual 1×.")
wizStyle       = input.string("Scalping", title="🧭 Gaya Trading", options=["Scalping", "Intraday", "Swing"], group=WIZ_GROUP)
presetInput    = input.string("Gold Scalping", title="Market Preset (rekomendasi)", options=["Manual", "Gold Scalping", "Forex Major", "Crypto", "NASDAQ", "US30"], group=WIZ_GROUP, tooltip="Setiap preset menampilkan parameter terbaik yang disarankan untuk market tsb di panel ⚙ STATUS SISTEM — cocokkan input Anda dengan saran tersebut.")
showSystemPanel= input.bool(true, title="Tampilkan Panel ⚙ STATUS SISTEM (kiri-atas)", group=WIZ_GROUP, tooltip="Berisi: Setup Wizard, saran preset, SETUP SCORE, Health Check engine, dan Error Checker (peringatan pengaturan terlalu ketat / bertentangan).")

// Mode & helper posisi/ukuran panel (dipakai juga oleh panel-panel lama via gerbang tampilan)
bool proMode = dashModeInput == "Professional"
f_panelPos(string p) =>
    p == "Kanan Atas" ? position.top_right : p == "Kanan Tengah" ? position.middle_right : p == "Kanan Bawah" ? position.bottom_right : p == "Kiri Atas" ? position.top_left : p == "Kiri Tengah" ? position.middle_left : position.bottom_left
// TOKEN-FIX: f_szMain/f_szText dihapus bersama panel Simple lama (tak ada pemakai tersisa)

// =====================================================================================================================
// 🌟 BAGIAN 1G: INPUT PARAMETER (PHASE 4 — EXECUTION ENGINE) — BARU (ADDITIVE)
// =====================================================================================================================
EXEC_GROUP = "Execution Engine: Phase 4"
execEngineOn       = input.bool(true,  title="Aktifkan Execution Engine (lapisan final)",   group=EXEC_GROUP, tooltip="Lapisan eksekusi FINAL di atas Decision Core: entry hanya lolos jika ada Trigger Candle + Pullback sehat + tanpa fake break. OFF = perilaku 100% IDENTIK dengan versi sebelumnya.")
requireTrigger     = input.bool(true,  title="Entry WAJIB Trigger Candle",                  group=EXEC_GROUP, tooltip="Harga menyentuh Demand saja TIDAK cukup (FITUR 63). BUY/SELL butuh minimal 1 candle konfirmasi: Engulfing, Marubozu kuat, Pin Bar, Morning/Evening Star, Shooting Star, Micro BOS/CHoCH, atau Momentum Break.")
requirePullback    = input.bool(true,  title="Entry WAJIB Pullback (EMA cepat/lambat)",     group=EXEC_GROUP, tooltip="Jangan beli setelah harga sudah lari terlalu jauh (FITUR 66): BUY hanya saat candle menyentuh kembali EMA pullback; selain itu status = WAIT PULLBACK.")
pullbackEmaFast    = input.int(20,     title="EMA Pullback Cepat",                          group=EXEC_GROUP, minval=2)
pullbackEmaSlow    = input.int(50,     title="EMA Pullback Lambat",                         group=EXEC_GROUP, minval=2)
useFakeBreakFilter = input.bool(true,  title="Fake Break Filter",                           group=EXEC_GROUP, tooltip="Abaikan sapuan wick (FITUR 67): Micro BOS/CHoCH hanya dihitung jika break terjadi dengan CLOSE + candle momentum. Status retest juga dilacak.")
minProbability     = input.int(0,      title="Minimum Entry Probability (%)",               group=EXEC_GROUP, minval=0, maxval=100, tooltip="0 = nonaktif (Probability hanya ditampilkan — FITUR 68). Jika diisi, entry ditolak bila Probability di bawah nilai ini.")
smartRetryOn       = input.bool(true,  title="Smart Retry (anti balik arah setelah SL)",    group=EXEC_GROUP, tooltip="Setelah entry kena SL, JANGAN langsung membalik arah (FITUR 73) — tampilkan 'FAILED — Tunggu Retest Baru' dan blokir entry arah sebaliknya selama N bar.")
retryBars          = input.int(10,     title="Jeda Retry Setelah SL (bar)",                 group=EXEC_GROUP, minval=1)
earlyExitOn        = input.bool(true,  title="Early Exit Engine",                           group=EXEC_GROUP, tooltip="Saat posisi berjalan: deteksi BOS/CHoCH berlawanan, zona pecah, keyakinan runtuh, momentum hilang → saran ⚠ EXIT EARLY (FITUR 74).")
showExecDash       = input.bool(true,  title="Tampilkan Panel 🚀 EKSEKUSI (kanan-tengah)",  group=EXEC_GROUP)
showBestEntry      = input.bool(true,  title="Tampilkan Label 🎯 BEST ENTRY",               group=EXEC_GROUP)

// =====================================================================================================================
// 🌟 BAGIAN 1H: INPUT PARAMETER (OPTIMIZATION UPDATE — MODE, CORE SCORE, DEBUG) — BARU
// =====================================================================================================================
CORE_GROUP = "⚡ 1. MULAI DI SINI — Mode & Core Engine"
tradeModeInput  = input.string("SMC", title="Trading Mode", options=["SCALPING", "SMC", "SWING"], group=CORE_GROUP, tooltip="SCALPING: Trend + Structure + Liquidity + ATR (tercepat). SMC: + FVG, OTE, Order Block (default). SWING: + Market Regime & Volume, target dinamis. Modul yang tidak relevan otomatis diabaikan oleh pipeline & disembunyikan dari chart.")
pipelineInput   = input.string("LEGACY (Full Filter)", title="Pipeline Sinyal", options=["SIMPLE (Score Engine)", "LEGACY (Full Filter)"], group=CORE_GROUP, tooltip="SIMPLE (default): skor berbobot 5 faktor — Trend 30%, Liquidity Sweep 25%, BOS/CHoCH 20%, FVG 15%, OTE 10% — dengan prioritas Trend > Structure > Liquidity > Presisi Entry. Filter minor TIDAK bisa memveto. Latensi keputusan jauh lebih rendah.\n\nLEGACY: seluruh rantai filter Phase 1-4 persis seperti versi sebelumnya (100% identik).")
coreMinScore    = input.int(70, title="Minimum Core Confidence (%)", minval=50, maxval=100, step=5, group=CORE_GROUP, tooltip="Band skor: 0-49 NO TRADE • 50-69 WAIT • 70-84 VALID • 85-100 HIGH QUALITY. Default 70 = hanya entry VALID ke atas.")
debugMode       = input.bool(true, title="🔧 Debug Mode", group=CORE_GROUP, tooltip="OFF (default): hanya 1 dashboard compact + trade plan — bersih & jelas dalam 10 detik. ON: tampilkan SEMUA panel diagnostik lama (Scalping Matrix, Institutional, Adaptive AI, Decision Core, Eksekusi, Sistem, label SNIPER/BEST ENTRY) beserta kalkulasi internal.")
showCleanDash   = input.bool(true, title="Tampilkan Dashboard Compact", group=CORE_GROUP)
showTradePlan   = input.bool(true, title="Gambar Trade Plan (ENTRY / STOP LOSS / TP1-TP3)", group=CORE_GROUP)
autoOptimizerOn = input.bool(true, title="Auto Filter Optimizer (statistik rolling, tanpa ML)", group=CORE_GROUP, tooltip="Faktor minor (FVG/OTE) yang terbukti MERUGIKAN di riwayat trading (win rate faktor ≤ win rate total − 10%) dinonaktifkan otomatis; yang terbukti menguntungkan (≥ +10%) bobotnya dinaikkan 25%. Skor dinormalisasi tetap 0-100.")
optMinTrades    = input.int(10, title="Min. Trade untuk Optimizer", minval=5, group=CORE_GROUP)
bool useSimplePipeline = pipelineInput == "SIMPLE (Score Engine)"

// =====================================================================================================================
// 🌟 BAGIAN 2: INPUT PARAMETER (LUXALGO SMC)
// =====================================================================================================================
BULLISH_LEG = 1
BEARISH_LEG = 0
BULLISH = +1
BEARISH = -1

GREEN = #089981
RED = #F23645
BLUE = #2157f3
GRAY = #878b94

MONO_BULLISH = #b2b5be
MONO_BEARISH = #5d606b

HISTORICAL = 'Historical'
PRESENT = 'Present'
COLORED = 'Colored'
MONOCHROME = 'Monochrome'

ALL = 'Semua'
BOS = 'Tembus Struktur'
CHOCH = 'Ganti Arah'

TINY = size.tiny
SMALL = size.small
NORMAL = size.normal

ATR = 'Atr'
RANGE = 'Cumulative Mean Range'
CLOSE = 'Close'
HIGHLOW = 'High/Low'

SOLID = '⎯⎯⎯'
DASHED = '----'
DOTTED = '····'

SMART_GROUP = 'SMC: General'
INTERNAL_GROUP = 'SMC: Internal Structure'
SWING_GROUP = 'SMC: Swing Structure'
BLOCKS_GROUP = 'SMC: Order Blocks'
EQUAL_GROUP = 'SMC: EQH/EQL'
GAPS_GROUP = 'SMC: Fair Value Gaps'
LEVELS_GROUP = 'SMC: Highs & Lows MTF'
ZONES_GROUP = 'SMC: Premium & Discount Zones'

modeInput               = input.string( HISTORICAL, 'Mode',                 group = SMART_GROUP, options = [HISTORICAL, PRESENT])
styleInput              = input.string( COLORED,    'Style',                group = SMART_GROUP, options = [COLORED, MONOCHROME])
showTrendInput          = input(        false,      'Color Candles (SMC)',  group = SMART_GROUP)

showInternalsInput      = input(        true,       'Show Internal Structure',  group = INTERNAL_GROUP)
showInternalBullInput   = input.string( ALL,        'Bullish Structure',        group = INTERNAL_GROUP, inline = 'ibull', options = [ALL,BOS,CHOCH])
internalBullColorInput  = input(        GREEN,      '',                         group = INTERNAL_GROUP, inline = 'ibull')
showInternalBearInput   = input.string( ALL,        'Bearish Structure' ,       group = INTERNAL_GROUP, inline = 'ibear', options = [ALL,BOS,CHOCH])
internalBearColorInput  = input(        RED,        '',                         group = INTERNAL_GROUP, inline = 'ibear')
internalFilterConfluenceInput = input(  false,      'Confluence Filter',        group = INTERNAL_GROUP)
internalStructureSize   = input.string( TINY,       'Internal Label Size',      group = INTERNAL_GROUP, options = [TINY,SMALL,NORMAL])

showStructureInput      = input(        true,       'Show Swing Structure',     group = SWING_GROUP)
showSwingBullInput      = input.string( ALL,        'Bullish Structure',        group = SWING_GROUP, inline = 'bull', options = [ALL,BOS,CHOCH])
swingBullColorInput     = input(        GREEN,      '',                         group = SWING_GROUP, inline = 'bull')
showSwingBearInput      = input.string( ALL,        'Bearish Structure',        group = SWING_GROUP, inline = 'bear', options = [ALL,BOS,CHOCH])
swingBearColorInput     = input(        RED,        '',                         group = SWING_GROUP, inline = 'bear')
swingStructureSize      = input.string( SMALL,      'Swing Label Size',         group = SWING_GROUP, options = [TINY,SMALL,NORMAL])
showSwingsInput         = input(        false,      'Show Swings Points',       group = SWING_GROUP, inline = 'swings')
swingsLengthInput       = input.int(    50,         '',                         group = SWING_GROUP, minval = 10, inline = 'swings')
showHighLowSwingsInput  = input(        true,       'Show Strong/Weak High/Low',group = SWING_GROUP)

showInternalOrderBlocksInput = input(   true,       'Internal Order Blocks' ,   group = BLOCKS_GROUP, inline = 'iob')
internalOrderBlocksSizeInput = input.int(5,         '',                         group = BLOCKS_GROUP, minval = 1, maxval = 20, inline = 'iob')
showSwingOrderBlocksInput    = input(   false,      'Swing Order Blocks',       group = BLOCKS_GROUP, inline = 'ob')
swingOrderBlocksSizeInput    = input.int(5,         '',                         group = BLOCKS_GROUP, minval = 1, maxval = 20, inline = 'ob')
orderBlockFilterInput        = input.string( 'Atr', 'Order Block Filter',       group = BLOCKS_GROUP, options = [ATR, RANGE])
orderBlockMitigationInput    = input.string( HIGHLOW,'Order Block Mitigation',  group = BLOCKS_GROUP, options = [CLOSE,HIGHLOW])
internalBullishOrderBlockColor = input.color(color.new(#3179f5, 80), 'Internal Bullish OB', group = BLOCKS_GROUP)
internalBearishOrderBlockColor = input.color(color.new(#f77c80, 80), 'Internal Bearish OB', group = BLOCKS_GROUP)
swingBullishOrderBlockColor    = input.color(color.new(#1848cc, 80), 'Bullish OB',          group = BLOCKS_GROUP)
swingBearishOrderBlockColor    = input.color(color.new(#b22833, 80), 'Bearish OB',          group = BLOCKS_GROUP)

showEqualHighsLowsInput      = input(   true,       'Equal High/Low',           group = EQUAL_GROUP)
equalHighsLowsLengthInput    = input.int(3,         'Bars Confirmation',        group = EQUAL_GROUP, minval = 1)
equalHighsLowsThresholdInput = input.float(0.1,     'Threshold',                group = EQUAL_GROUP, minval = 0, maxval = 0.5, step = 0.1)
equalHighsLowsSizeInput      = input.string( TINY,  'Label Size',               group = EQUAL_GROUP, options = [TINY,SMALL,NORMAL])

showFairValueGapsInput       = input(   false,      'Fair Value Gaps',          group = GAPS_GROUP)
fairValueGapsThresholdInput  = input(   true,       'Auto Threshold',           group = GAPS_GROUP)
fairValueGapsTimeframeInput  = input.timeframe('',  'Timeframe',                group = GAPS_GROUP)
fairValueGapsBullColorInput  = input.color(color.new(#00ff68, 70), 'Bullish FVG' , group = GAPS_GROUP)
fairValueGapsBearColorInput  = input.color(color.new(#ff0008, 70), 'Bearish FVG' , group = GAPS_GROUP)
fairValueGapsExtendInput     = input.int(1,         'Extend FVG',               group = GAPS_GROUP, minval = 0)

showPremiumDiscountZonesInput= input(   false,      'Premium/Discount Zones',   group = ZONES_GROUP)
premiumZoneColorInput        = input.color( RED,    'Premium Zone',             group = ZONES_GROUP)
equilibriumZoneColorInput    = input.color( GRAY,   'Equilibrium Zone',         group = ZONES_GROUP)
discountZoneColorInput       = input.color( GREEN,  'Discount Zone',            group = ZONES_GROUP)

// =====================================================================================================================
// 🌟 BAGIAN 3: INPUT PARAMETER (YATA PIVOTS & S&R)
// =====================================================================================================================
groupPP = "Yata: Pivot Points"
groupPL = "Yata: Pivot Labels & Lines"
groupSR = "Yata: Support & Resistance"
groupFR = "Yata: Fibonacci Retracement"
groupFE = "Yata: Fibonacci Extension"

yata_length        = input(21, title="Length", inline="PP1", group=groupPP)
max_pivot_points   = input.float(5, minval=2, title="Pivot Points Lookback" , inline="PP2", group=groupPP)
max_h_pivot_points = max_pivot_points
max_l_pivot_points = max_pivot_points
min_difference     = 0.0
channel_ext_length = input(14, title="Lines Extension", inline="EXT", group=groupPP)
source             = input(close, title="Source", inline="PP1", group=groupPP)

show_plabels = input.bool(true, title="Show Pivot Labels", inline="PP4", group=groupPL)
d_lbl_pivh = show_plabels ? true : false
d_lbl_pivl = show_plabels ? true : false

ALB1 = input.color(color.new(#99D31B, 25), title="Active", inline="PP4A", group=groupPL)
ALB2 = input.color(color.new(#FA5032, 25), title="", inline="PP4A", group=groupPL)
ILB1 = input.color(color.new(#99D31B, 75), title="| Inactive",inline="PP4A", group=groupPL)
ILB2 = input.color(color.new(#FF4500, 75), title="", inline="PP4A", group=groupPL)

show_plines = input.bool(true, title="Show Pivot Lines", inline="PP5", group=groupPL)
d_pivh = show_plines ? true : false
d_pivl = show_plines ? true : false

ALN1 = input.color(color.new(#99D31B, 50), title="Active", inline="PP5A", group=groupPL)
ALN2 = input.color(color.new(#FA5032, 50), title="", inline="PP5A", group=groupPL)
ILN1 = input.color(color.new(#99D31B, 50), title="Inactive" , inline="PP5B", group=groupPL)
ILN2 = input.color(color.new(#FF4500, 50), title="", inline="PP5B", group=groupPL)

show_chan = input.bool(true, title="Show Channel Lines", inline="CH1", group=groupSR)
d_chanh = show_chan ? true : false
d_chanl = show_chan ? true : false

show_extendL = input.bool(false, title="Extend Channel Lines", inline="CH1B", group=groupSR)
extendL = show_extendL ? extend.left : extend.none

RLN = input.color(color.new(#99D31B, 25), title="High", inline="CH1A", group=groupSR)
SLN = input.color(color.new(#FA5032, 25), title="Low", inline="CH1A", group=groupSR)

d_fib = input.bool(true, title="Draw Fib. Retr. Lines", inline="CH2", group=groupFR)
FRH = input.color(color.new(#99D31B, 25), title="High", inline="CH2A", group=groupFR)
FRL = input.color(color.new(#FA5032, 25), title="Low", inline="CH2A", group=groupFR)

sfib_R01 = input.bool(true, title="01", inline="CH21", group=groupFR)
sfib_R02 = input.bool(true, title="02", inline="CH22", group=groupFR)
sfib_R03 = input.bool(true, title="03", inline="CH23", group=groupFR)
fib_R01 = sfib_R01 ? input.float(0.236, title="", inline="CH21", group=groupFR) : na
fib_R02 = sfib_R02 ? input.float(0.382, title="", inline="CH22", group=groupFR) : na
fib_R03 = sfib_R03 ? input.float(0.5, title="", inline="CH23", group=groupFR) : na

d_fib2 = input.bool(true, title="Draw Fib. Ext. Lines", inline="CH3", group=groupFE)
FEH = input.color(color.new(#99D31B, 25), title="High", inline="CH3A", group=groupFE)
FEL = input.color(color.new(#FA5032, 25), title="Low", inline="CH3A", group=groupFE)
sfib_E01 = input.bool(true, title="01", inline="CH31", group=groupFE)
fib_E01 = sfib_E01 ? input.float(1.618, title="", inline="CH31", group=groupFE) : na

f_bg = input.bool(true, title="Fill Channel Background", inline="CH4", group=groupSR)
GF2 = input.color(color.new(#99D31B, 0), title="Rising", inline="CH4A", group=groupSR)
GF1 = input.color(color.new(#FF4500, 0), title="Falling", inline="CH4A", group=groupSR)
f_transp = input.float(97, title="| Tra.", inline="CH4A", group=groupSR)

lwidth_piv  = input.int(1, minval=0, title="| Width", inline="PP5", group=groupPL)
lwidth_chan = input.int(2, minval=0, title="| Width", inline="CH1", group=groupSR)
lwidth_FR   = input.int(1, minval=0, title="| Width", inline="CH2", group=groupFR)
lwidth_FE   = input.int(1, minval=0, title="| Width", inline="CH3", group=groupFE)

i_line0 = "Solid"
i_line1 = "Dotted"
i_line2 = "Dashed"

ppstyleAHL_input = input.string(i_line2, title="|", options=[i_line0, i_line1, i_line2], inline="PP5A", group=groupPL)
ppstyleIHL_input = input.string(i_line1, title="|", options=[i_line0, i_line1, i_line2], inline="PP5B", group=groupPL)
ppstyleSRL_input = input.string(i_line0, title="|", options=[i_line0, i_line1, i_line2], inline="CH1A", group=groupSR)
ppstyleFRL_input = input.string(i_line1, title="|", options=[i_line0, i_line1, i_line2], inline="CH2A", group=groupFR)
ppstyleFEL_input = input.string(i_line1, title="|", options=[i_line0, i_line1, i_line2], inline="CH3A", group=groupFE)

f_getLineStyle(_inputStyle) =>
    _return = _inputStyle == i_line1 ? line.style_dotted : _inputStyle == i_line2 ? line.style_dashed : line.style_solid
    _return

// =====================================================================================================================
// 🌟 BAGIAN 4: LOGIKA MATRIX SCALPING
// =====================================================================================================================
ema200 = ta.ema(close, 200)
plot(ema200, title="EMA 200 (Batas Alam)", color=color.new(#FFD54F, 0), linewidth=2)

var color C_BG       = color.new(#0E1117, 8)
var color C_HEADER   = color.new(#1F6FEB, 15)
var color C_SUBHEAD  = color.new(#21262D, 20)
var color C_LABEL    = color.new(#8B949E, 0)
var color C_VALUE    = color.new(#E6EDF3, 0)
var color C_BORDER   = color.new(#30363D, 40)
var color C_BULL     = color.new(#238636, 25)
var color C_BEAR     = color.new(#DA3633, 25)
var color C_NEUTRAL  = color.new(#484F58, 45)
var color C_ACCENT   = color.new(#8957E5, 30)
var color C_INFO     = color.new(#1F6FEB, 55)
var color C_WARN     = color.new(#D29922, 30)

// FINAL RELEASE (ADDITIVE — FITUR 5): THEME ENGINE — palet warna ditimpa 1× di bar pertama sesuai tema terpilih.
// Konsisten: Hijau=Bullish, Merah=Bearish, Kuning=Peringatan, Abu=Informasi, Biru=Header. Default "Dark" = warna asli.
// SCOPE-FIX: rantai if/else diganti ternary (1 scope) — hasil warna identik per tema
if barstate.isfirst and themeInput != "Dark"
    bool thL = themeInput == "Light"
    bool thM = themeInput == "Minimal"
    C_BG      := thL ? color.new(#FFFFFF, 6)  : thM ? color.new(#0E1117, 65) : color.new(#0A1A2F, 5)
    C_HEADER  := thL ? color.new(#1F6FEB, 0)  : thM ? color.new(#30363D, 40) : color.new(#0D47A1, 0)
    C_SUBHEAD := thL ? color.new(#EAEEF2, 10) : thM ? color.new(#21262D, 60) : color.new(#123156, 15)
    C_LABEL   := thL ? color.new(#57606A, 0)  : thM ? C_LABEL : color.new(#9FB6D4, 0)
    C_VALUE   := thL ? color.new(#1F2328, 0)  : thM ? C_VALUE : color.new(#E3F2FD, 0)
    C_BORDER  := thL ? color.new(#D0D7DE, 20) : thM ? color.new(#30363D, 80) : color.new(#1E4976, 30)
    C_BULL    := thL ? color.new(#1A7F37, 20) : thM ? color.new(#238636, 60) : color.new(#00897B, 20)
    C_BEAR    := thL ? color.new(#CF222E, 20) : thM ? color.new(#DA3633, 60) : color.new(#E53935, 20)
    C_NEUTRAL := thL ? color.new(#AFB8C1, 40) : thM ? color.new(#484F58, 75) : color.new(#37474F, 40)
    C_ACCENT  := thL ? color.new(#8250DF, 20) : thM ? color.new(#8957E5, 65) : color.new(#5E35B1, 25)
    C_INFO    := thL ? color.new(#54A3FF, 45) : thM ? color.new(#1F6FEB, 75) : color.new(#1565C0, 45)
    C_WARN    := thL ? color.new(#D4A72C, 25) : thM ? color.new(#D29922, 60) : color.new(#F9A825, 25)

// PENYESUAIAN TEKS & MODE
string STR_SELL_ACT = marketMode == "Saham Indonesia (IDX)" ? "TAKE PROFIT" : "SCALP SELL"
string STR_HARAM_B  = marketMode == "Saham Indonesia (IDX)" ? "⛔ Wait & See (Bawah EMA)" : "⛔ Haram BUY (Bawah EMA)"
string STR_HARAM_S  = marketMode == "Saham Indonesia (IDX)" ? "⛔ Hold (Atas EMA)" : "⛔ Haram SELL (Atas EMA)"
string STR_AYO_SELL = marketMode == "Saham Indonesia (IDX)" ? "🚀 AYO TAKE PROFIT SEKARANG! 🚀" : "🚀 AYO SELL SEKARANG! 🚀"
string STR_SIAP_SELL= marketMode == "Saham Indonesia (IDX)" ? "🔔 SIAP-SIAP TAKE PROFIT" : "🔔 SIAP-SIAP SELL"
string STR_HAMPIR_S = marketMode == "Saham Indonesia (IDX)" ? "⏳ HAMPIR TAKE PROFIT" : "⏳ HAMPIR SELL"

matrix_ph = ta.pivothigh(high, swingLength, swingLength)
matrix_pl = ta.pivotlow(low, swingLength, swingLength)

var float lastPH = na
var float lastPL = na
var int   lastPH_index = na
var int   lastPL_index = na
var float baseSupplyBottom = na
var float baseDemandTop = na
var string microTrend = "SIDEWAYS"

if not na(matrix_ph)
    lastPH := matrix_ph
    lastPH_index := bar_index[swingLength]
    baseSupplyBottom := low[swingLength]
    microTrend := "BEARISH 🔴"

if not na(matrix_pl)
    lastPL := matrix_pl
    lastPL_index := bar_index[swingLength]
    baseDemandTop := high[swingLength]
    microTrend := "BULLISH 🟢"

f_tfTrend(tf) =>
    c = request.security(syminfo.tickerid, tf, close, lookahead=barmerge.lookahead_off)
    e = request.security(syminfo.tickerid, tf, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
    c > e ? 1 : c < e ? -1 : 0

// Auto-MTF: tentukan TF Zona & Bias dari TF chart saat ini (scalping M1/M3/M5/M15)
f_autoZone(simple string manual) =>
    switch
        timeframe.in_seconds() <= 60  => "5"
        timeframe.in_seconds() <= 180 => "15"
        timeframe.in_seconds() <= 300 => "15"
        timeframe.in_seconds() <= 900 => "60"
        => manual
f_autoBias(simple string manual) =>
    switch
        timeframe.in_seconds() <= 60  => "15"
        timeframe.in_seconds() <= 180 => "60"
        timeframe.in_seconds() <= 300 => "60"
        timeframe.in_seconds() <= 900 => "240"
        => manual
string tfZoneUsed = autoMTF ? f_autoZone(tfZone) : tfZone
string tfBiasUsed = autoMTF ? f_autoBias(tfBias) : tfBias

int biasDir = f_tfTrend(tfBiasUsed)
int zoneDir = f_tfTrend(tfZoneUsed)
string biasTrend = biasDir == 1 ? "BULLISH 🟢" : biasDir == -1 ? "BEARISH 🔴" : "NETRAL ⚪"
string zoneTrend = zoneDir == 1 ? "BULLISH 🟢" : zoneDir == -1 ? "BEARISH 🔴" : "NETRAL ⚪"
bool alignedBull = biasDir == 1 and zoneDir == 1
bool alignedBear = biasDir == -1 and zoneDir == -1

vol_sma = ta.sma(volume, 20)
bool highVolume = volume > (vol_sma * 1.5)

bool hasFVG = false
float minGapSize = close * (minFvgPct / 100.0)
for i = 1 to 5
    bool bullGap = (low[i] - high[i+2]) > minGapSize
    bool bearGap = (low[i+2] - high[i]) > minGapSize
    if bullGap or bearGap
        hasFVG := true

bool isBullishRejection = (close > open) and ((open - low) > (close - open) * 1.5)
bool isBearishRejection = (close < open) and ((high - open) > (open - close) * 1.5)

matrixRsiVal = ta.rsi(close, matrixRsiLen)
atrVal = ta.atr(atrLen)
float emaDistPct = math.abs((close - ema200) / ema200) * 100.0
bool notOverextended = emaDistPct <= maxEmaDistPct

bool inKillzone = not na(time(timeframe.period, killzone))
bool sessionOK = marketMode == "Saham Indonesia (IDX)" ? true : (not useSession or inKillzone)

// Plumbing OB internal: tetap lacak Order Block untuk filter entry walau tampilan OB dimatikan
bool trackInternalOB = showInternalOrderBlocksInput or requireOBEntry

float spreadInPrice = spreadBuffer * syminfo.mintick
float structBufPrice = atrVal * structBuffer
float entryRef = close

float buySL = na
float sellSL = na
float buySLDist = na
float sellSLDist = na

if useStructSL and not na(lastPL) and not na(lastPH)
    float rawBuySL  = lastPL - structBufPrice - spreadInPrice
    float rawSellSL = lastPH + structBufPrice + spreadInPrice
    float minDist   = (atrVal * slAtrMult) + spreadInPrice

    buySLDist  := math.max(entryRef - rawBuySL, minDist)
    sellSLDist := math.max(rawSellSL - entryRef, minDist)
    buySL      := entryRef - buySLDist
    sellSL     := entryRef + sellSLDist
else
    float atrDist = (atrVal * slAtrMult) + spreadInPrice
    buySLDist  := atrDist
    sellSLDist := atrDist
    buySL      := entryRef - atrDist
    sellSL     := entryRef + atrDist

float buyTP1  = entryRef + (buySLDist * tp1RR)
float buyTP2  = entryRef + (buySLDist * tp2RR)
float buyTP   = entryRef + (buySLDist * tpRR)

float sellTP1 = entryRef - (sellSLDist * tp1RR)
float sellTP2 = entryRef - (sellSLDist * tp2RR)
float sellTP  = entryRef - (sellSLDist * tpRR)

// Target yang dipakai engine backtest WR (sesuai pilihan wrTargetMode)
float buyWinTarget  = wrTargetMode == "TP1 (0.5R)" ? buyTP1  : wrTargetMode == "TP2 (1.0R)" ? buyTP2  : buyTP
float sellWinTarget = wrTargetMode == "TP1 (0.5R)" ? sellTP1 : wrTargetMode == "TP2 (1.0R)" ? sellTP2 : sellTP

float slDistance = microTrend == "BEARISH 🔴" ? sellSLDist : buySLDist
float riskAmount = accountSize * (riskPct / 100.0)

float activeSLDist = microTrend == "BEARISH 🔴" ? sellSLDist : buySLDist
float recommendedLotForex = (activeSLDist > 0 and goldValPerPt > 0) ? (riskAmount / (activeSLDist * goldValPerPt)) : na
float lossPerShare = activeSLDist
float recommendedLotSaham = lossPerShare > 0 ? math.floor((riskAmount / lossPerShare) / 100) : na
float recommendedLot = marketMode == "Forex/Gold" ? recommendedLotForex : recommendedLotSaham

var float[]  fibLevels = array.from(-0.272, -0.130, 0.114, 0.214, 0.382, 0.500, 0.618, 0.786, 0.886, 1.130, 1.272)
var string[] fibNames  = array.from("🎯 TP BUY", "🛑 SL SELL", "🔴 SELL 3 (0.88)", "🔴 SELL 2 (0.78)", "🔴 SELL 1 (0.61)", "⚖️ 50%", "🟢 BUY 1 (0.61)", "🟢 BUY 2 (0.78)", "🟢 BUY 3 (0.88)", "🛑 SL BUY", "🎯 TP SELL")
var color[]  fibColors = array.from(color.new(color.green, 0), color.new(color.red, 0), color.new(color.orange, 0), color.new(color.orange, 0), color.new(color.orange, 0), color.new(color.gray, 0), color.new(color.teal, 0), color.new(color.teal, 0), color.new(color.teal, 0), color.new(color.red, 0), color.new(color.green, 0))

var line[]  matrixFibLines  = array.new_line()
var label[] matrixFibLabels = array.new_label()
var box sndBox = na
var line slLine = na
var line tpLine = na
var label slLabel = na
var label tpLabel = na

if barstate.islast and not na(lastPH) and not na(lastPL) and showFibo
    if array.size(matrixFibLines) > 0
        for i = 0 to array.size(matrixFibLines) - 1
            line.delete(array.get(matrixFibLines, i))
            label.delete(array.get(matrixFibLabels, i))
        array.clear(matrixFibLines)
        array.clear(matrixFibLabels)
    if not na(sndBox)
        box.delete(sndBox)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)

    diff = lastPH - lastPL
    startIndex = math.max(lastPH_index, lastPL_index)

    if lastPH_index > lastPL_index
        sndBox := box.new(left=lastPL_index, top=baseDemandTop, right=bar_index, bottom=lastPL, bgcolor=color.new(color.teal, 85), border_color=color.teal, text="🟩 DEMAND", text_color=color.teal, text_size=size.small, text_valign=text.align_bottom, text_halign=text.align_right)
    else
        sndBox := box.new(left=lastPH_index, top=lastPH, right=bar_index, bottom=baseSupplyBottom, bgcolor=color.new(color.orange, 85), border_color=color.orange, text="🟥 SUPPLY", text_color=color.orange, text_size=size.small, text_valign=text.align_top, text_halign=text.align_right)

    if extendLines
        box.set_extend(sndBox, extend.right)

    for i = 0 to array.size(fibLevels) - 1
        level = array.get(fibLevels, i)
        name  = array.get(fibNames, i)
        c     = array.get(fibColors, i)
        price = lastPH - (diff * level)

        lStyle = level == 0.5 ? line.style_solid : line.style_dashed
        lWidth = level == 0.5 ? 2 : 1

        l = line.new(startIndex, price, bar_index, price, color=c, width=lWidth, style=lStyle)
        if extendLines
            line.set_extend(l, extend.right)
        array.push(matrixFibLines, l)

        labelText = name + " : " + str.tostring(price, format.mintick)
        lbl = label.new(bar_index, price, text=labelText, style=label.style_label_left, textcolor=color.white, color=c, size=size.small)
        array.push(matrixFibLabels, lbl)

    bool aboveEMA_plot = close > ema200
    if microTrend == "BULLISH 🟢" and aboveEMA_plot
        slLine := line.new(bar_index - 10, buySL, bar_index, buySL, color=color.red, width=2, style=line.style_dotted)
        tpLine := line.new(bar_index - 10, buyTP, bar_index, buyTP, color=color.lime, width=2, style=line.style_dotted)
        if extendLines
            line.set_extend(slLine, extend.right)
            line.set_extend(tpLine, extend.right)
        slLabel := label.new(bar_index, buySL, text="🛑 SL : " + str.tostring(buySL, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.new(color.red, 20), size=size.small)
        tpLabel := label.new(bar_index, buyTP, text="🎯 TP Final : " + str.tostring(buyTP, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.new(color.green, 20), size=size.small)

    else if microTrend == "BEARISH 🔴" and not aboveEMA_plot
        slLine := line.new(bar_index - 10, sellSL, bar_index, sellSL, color=color.red, width=2, style=line.style_dotted)
        tpLine := line.new(bar_index - 10, sellTP, bar_index, sellTP, color=color.lime, width=2, style=line.style_dotted)
        if extendLines
            line.set_extend(slLine, extend.right)
            line.set_extend(tpLine, extend.right)
        slLabel := label.new(bar_index, sellSL, text="🛑 SL : " + str.tostring(sellSL, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.new(color.red, 20), size=size.small)
        tpLabel := label.new(bar_index, sellTP, text="🎯 TP Final : " + str.tostring(sellTP, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.new(color.green, 20), size=size.small)

bgcolor(useSession and inKillzone and marketMode == "Forex/Gold" ? color.new(color.blue, 92) : na, title="Killzone Aktif")


// =====================================================================================================================
// 🌟 BAGIAN 5.5: VIRTUAL BACKTEST TRACKER (WR ENGINE)
// =====================================================================================================================
var int totalTrades = 0
var int winTrades   = 0
var int lossTrades  = 0
var int activePos   = 0 // 0 = flat, 1 = long, -1 = short
var float activeSL  = na
var float activeTP  = na

if activePos == 1
    if low <= activeSL
        lossTrades += 1
        totalTrades += 1
        activePos := 0
    else if high >= activeTP
        winTrades += 1
        totalTrades += 1
        activePos := 0
else if activePos == -1
    if high >= activeSL
        lossTrades += 1
        totalTrades += 1
        activePos := 0
    else if low <= activeTP
        winTrades += 1
        totalTrades += 1
        activePos := 0

float winRate = totalTrades > 0 ? (winTrades / totalTrades) * 100 : 0


// =====================================================================================================================
// 🌟 BAGIAN 5: PANEL DASHBOARD & ARAH UTAMA
// =====================================================================================================================
// TOKEN-FIX (CE10117): dashboard lama & baris zona (9.6) DIHAPUS — seluruh informasinya sudah ada di
// Dashboard Compact (BAGIAN 12) + panel 🧠/🚀 (Debug Mode). Tidak ada logika trading yang berubah.

// =====================================================================================================================
// 🌟 BAGIAN 6: LOGIKA & PANEL SINYAL UTAMA (BUY/SELL)
// =====================================================================================================================
float eqPrice = (not na(lastPH) and not na(lastPL)) ? lastPH - ((lastPH - lastPL) * 0.5) : na
string actionStatus = "Menunggu Momen..."
color actionColor = color.gray
int score = 0
bool isAboveEMA = close > ema200

// Hitung Sinyal
if microTrend == "BULLISH 🟢"
    if not na(eqPrice) and close < eqPrice and close > lastPL and isAboveEMA
        score += alignedBull ? 1 : 0
        score += highVolume ? 1 : 0
        score += hasFVG ? 1 : 0
        score += isBullishRejection ? 1 : 0
        score += sessionOK ? 1 : 0
        score += (not useRSI or matrixRsiVal <= rsiBuyMax) and notOverextended ? 1 : 0

        if score >= minScore and sessionOK
            actionStatus := "🎯 SCALP BUY (" + str.tostring(score) + "/6)"
            actionColor := color.new(color.teal, 10)
        else if not sessionOK
            actionStatus := "🌙 Di Luar Waktu Aktif"
            actionColor := color.new(color.gray, 30)
        else
            actionStatus := "⚠️ Sabar (" + str.tostring(score) + "/6)"
            actionColor := color.new(color.orange, 30)
    else if not isAboveEMA
        actionStatus := STR_HARAM_B
        actionColor := color.new(color.red, 30)
    else
        actionStatus := "⏳ Retracement"

else if microTrend == "BEARISH 🔴"
    if not na(eqPrice) and close > eqPrice and close < lastPH and not isAboveEMA
        score += alignedBear ? 1 : 0
        score += highVolume ? 1 : 0
        score += hasFVG ? 1 : 0
        score += isBearishRejection ? 1 : 0
        score += sessionOK ? 1 : 0
        score += (not useRSI or matrixRsiVal >= rsiSellMin) and notOverextended ? 1 : 0

        if score >= minScore and sessionOK
            actionStatus := "🎯 " + STR_SELL_ACT + " (" + str.tostring(score) + "/6)"
            actionColor := color.new(color.red, 10)
        else if not sessionOK
            actionStatus := "🌙 Di Luar Waktu Aktif"
            actionColor := color.new(color.gray, 30)
        else
            actionStatus := "⚠️ Sabar (" + str.tostring(score) + "/6)"
            actionColor := color.new(color.orange, 30)
    else if isAboveEMA
        actionStatus := STR_HARAM_S
        actionColor := color.new(color.red, 30)
    else
        actionStatus := "⏳ Retracement"

// --- LOGIKA UTAMA BUY & SELL ---
bool buySetupRaw  = microTrend == "BULLISH 🟢" and not na(eqPrice) and close < eqPrice and close > lastPL and close > ema200 and alignedBull and highVolume and hasFVG and isBullishRejection and notOverextended and sessionOK and (not useRSI or matrixRsiVal <= rsiBuyMax)
bool sellSetupRaw = microTrend == "BEARISH 🔴" and not na(eqPrice) and close > eqPrice and close < lastPH and close < ema200 and alignedBear and highVolume and hasFVG and isBearishRejection and notOverextended and sessionOK and (not useRSI or matrixRsiVal >= rsiSellMin)

// Catatan: trigger WR engine + plotshape BUY/SELL DIPINDAH ke BAGIAN 9.5
// (setelah Order Block internal di-update), agar filter OB & anti-repaint bisa diterapkan.

// TOKEN-FIX (CE10117): panel Fokus Arah & Status Eksekusi DIHAPUS — status final kini tunggal di Dashboard Compact.

var label bigSignal = na
if barstate.islast and showBigSignal
    if not na(bigSignal)
        label.delete(bigSignal)

    string bigText = na
    color bigColor = na
    bool placeAbove = false

    if microTrend == "BULLISH 🟢" and isAboveEMA and not na(eqPrice) and close < eqPrice and close > lastPL
        if score >= minScore and sessionOK
            bigText := "🚀 AYO BUY SEKARANG! 🚀\n(" + str.tostring(score) + "/6 — Semua syarat OK)"
            bigColor := color.new(color.teal, 0)
            placeAbove := false
        else if score >= (minScore - 1) and sessionOK
            bigText := "⏳ HAMPIR BUY — TUNGGU 1 LAGI\n(" + str.tostring(score) + "/6)"
            bigColor := color.new(color.green, 25)
            placeAbove := false
        else if score >= 2 and sessionOK
            bigText := "🔔 SIAP-SIAP BUY\n(Pantau terus, " + str.tostring(score) + "/6)"
            bigColor := color.new(color.green, 45)
            placeAbove := false

    else if microTrend == "BEARISH 🔴" and not isAboveEMA and not na(eqPrice) and close > eqPrice and close < lastPH
        if score >= minScore and sessionOK
            bigText := STR_AYO_SELL + "\n(" + str.tostring(score) + "/6 — Semua syarat OK)"
            bigColor := color.new(color.red, 0)
            placeAbove := true
        else if score >= (minScore - 1) and sessionOK
            bigText := STR_HAMPIR_S + " — TUNGGU 1 LAGI\n(" + str.tostring(score) + "/6)"
            bigColor := color.new(color.red, 25)
            placeAbove := true
        else if score >= 2 and sessionOK
            bigText := STR_SIAP_SELL + "\n(Pantau terus, " + str.tostring(score) + "/6)"
            bigColor := color.new(color.orange, 35)
            placeAbove := true

    if not na(bigText)
        float yPos = placeAbove ? high + (atrVal * 2) : low - (atrVal * 2)
        labelStyle = placeAbove ? label.style_label_down : label.style_label_up
        bigSignal := label.new(bar_index, yPos, text=bigText, style=labelStyle, textcolor=color.white, color=bigColor, size=size.huge)


// =====================================================================================================================
// 🌟 BAGIAN 7: LOGIKA LUXALGO SMC
// =====================================================================================================================
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox

type trend
    int bias

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime
    int bias
    // PHASE 2 (ADDITIVE — FITUR 23): field kualitas OB, ber-default agar konstruktor lama tetap valid
    int  touchCount = 0
    bool wasInside  = false
    int  createdBar = 0

var pivot swingHigh                 = pivot.new(na,na,false)
var pivot swingLow                  = pivot.new(na,na,false)
var pivot internalHigh              = pivot.new(na,na,false)
var pivot internalLow               = pivot.new(na,na,false)
var pivot equalHigh                 = pivot.new(na,na,false)
var pivot equalLow                  = pivot.new(na,na,false)
var trend swingTrend                = trend.new(0)
var trend internalTrend             = trend.new(0)
var equalDisplay equalHighDisplay   = equalDisplay.new()
var equalDisplay equalLowDisplay    = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<float> parsedHighs        = array.new<float>()
var array<float> parsedLows         = array.new<float>()
var array<float> highs              = array.new<float>()
var array<float> lows               = array.new<float>()
var array<int> times                = array.new<int>()
var trailingExtremes trailing       = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks      = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks   = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes        = array.new<box>()
var array<box> internalOrderBlocksBoxes     = array.new<box>()
var swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor        = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor        = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor                = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor               = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput
varip int currentBarIndex           = bar_index
varip int lastBarIndex              = bar_index
alerts currentAlerts                = alerts.new()
var initialTime                     = time

if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))

bearishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure                          = ta.atr(200)
volatilityMeasure                   = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr)/bar_index
highVolatilityBar                   = (high - low) >= (2 * volatilityMeasure)
parsedHigh                          = highVolatilityBar ? low : high
parsedLow                           = highVolatilityBar ? high : low

parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)

leg(int size) =>
    var leg     = 0
    newLegHigh  = high[size] > ta.highest( size)
    newLegLow   = low[size]  < ta.lowest(  size)
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)      => ta.change(leg) != 0
startOfBearishLeg(int leg)  => ta.change(leg) == -1
startOfBullishLeg(int leg)  => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    var label l_abel = na
    if modeInput == PRESENT
        l_abel.delete()
    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    string tag          = 'Lembah Kembar'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up
    if equalHigh
        tag          := 'Puncak Kembar'
        equalColor   := swingBearishColor
        labelStyle   := label.style_label_down
    if modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)

    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition           = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

getCurrentStructure(int size,bool equalHighLow = false, bool internal = false) =>
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow
            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'Lembah Turun' : 'Lembah Naik', swingBullishColor, label.style_label_up)
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh
            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot,high[size],size,true)
                currentAlerts.equalHighs := true
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'Puncak Naik' : 'Puncak Turun', swingBearishColor, label.style_label_down)

drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>
    var line l_ine      = line.new(na,na,na,na,xloc = xloc.bar_time)
    var label l_abel    = label.new(na,na)
    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()
    l_ine   := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel  := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size = labelSize)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    for [index,eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false
        if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true
        if crossedOderBlock
            orderBlocks.remove(index)

storeOrdeBlock(pivot p_ivot,bool internal = false,int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and trackInternalOB)
        array<float> a_rray = na
        int parsedIndex = na
        if bias == BEARISH
            a_rray      := parsedHighs.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())
        else
            a_rray      := parsedLows.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())
        orderBlock o_rderBlock          = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex),bias)
        array<orderBlock> orderBlocks   = internal ? internalOrderBlocks : swingOrderBlocks
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()
    if orderBlocksSize > 0
        maxOrderBlocks                              = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks  = orderBlocks.slice(0, math.min(maxOrderBlocks,orderBlocksSize))
        array<box> b_oxes                   = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
        for [index,eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)
            box b_ox        = b_oxes.get(index)
            b_ox.set_top_left_point(    chart.point.new(eachOrderBlock.barTime,na,eachOrderBlock.barHigh))
            b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,eachOrderBlock.barLow))
            b_ox.set_border_color(      internal ? na : orderBlockColor)
            b_ox.set_bgcolor(           orderBlockColor)

displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true
    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend
    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize
    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput
    if ta.crossover(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBullishCHoCH  := tag == CHOCH
            currentAlerts.internalBullishBOS    := tag == BOS
        else
            currentAlerts.swingBullishCHoCH     := tag == CHOCH
            currentAlerts.swingBullishBOS       := tag == BOS
        p_ivot.crossed  := true
        t_rend.bias     := BULLISH
        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))
        if displayCondition
            drawStructure(p_ivot,tag,bullishColor,lineStyle,label.style_label_down,labelSize)
        if (internal and trackInternalOB) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BULLISH)
    p_ivot          := internal ? internalLow : swingLow
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput
    if ta.crossunder(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBearishCHoCH  := tag == CHOCH
            currentAlerts.internalBearishBOS    := tag == BOS
        else
            currentAlerts.swingBearishCHoCH     := tag == CHOCH
            currentAlerts.swingBearishBOS       := tag == BOS
        p_ivot.crossed := true
        t_rend.bias := BEARISH
        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        if displayCondition
            drawStructure(p_ivot,tag,bearishColor,lineStyle,label.style_label_up,labelSize)
        if (internal and trackInternalOB) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BEARISH)

fairValueGapBox(leftTime,rightTime,topPrice,bottomPrice,boxColor) => box.new(chart.point.new(leftTime,na,topPrice),chart.point.new(rightTime + fairValueGapsExtendInput * (time-time[1]),na,bottomPrice), xloc=xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

deleteFairValueGaps() =>
    for [index,eachFairValueGap] in fairValueGaps
        if (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)

drawFairValueGaps() =>
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]],lookahead = barmerge.lookahead_on)
    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0
    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe
    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow,last2High,BULLISH,fairValueGapBox(lastTime,currentTime,currentLow,math.avg(currentLow,last2High),fairValueGapBullishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentLow,last2High),last2High,fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh,last2Low,BEARISH,fairValueGapBox(lastTime,currentTime,currentHigh,math.avg(currentHigh,last2Low),fairValueGapBearishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentHigh,last2Low),last2Low,fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time],lookahead = barmerge.lookahead_on)
    float parsedTop             = sameTimeframe ? high : topLevel
    float parsedBottom          = sameTimeframe ? low : bottomLevel
    int parsedLeftTime          = sameTimeframe ? time : leftTime
    int parsedRightTime         = sameTimeframe ? time : rightTime
    int parsedTopTime           = time
    int parsedBottomTime        = time
    if not sameTimeframe
        int leftIndex               = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = times.binary_search_rightmost(parsedRightTime)
        array<int> timeArray        = times.slice(leftIndex,rightIndex)
        array<float> topArray       = highs.slice(leftIndex,rightIndex)
        array<float> bottomArray    = lows.slice(leftIndex,rightIndex)
        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime
    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    topLine.set_first_point(    chart.point.new(parsedTopTime,na,parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))
    bottomLine.set_first_point( chart.point.new(parsedBottomTime,na,parsedBottom))
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high,trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color=color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color=color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)
    rightTimeBar            = last_bar_time + 20 * (time - time[1])
    topLine.set_first_point(    chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(          swingTrend.bias == BEARISH ? 'Puncak Kuat' : 'Puncak Lemah')
    bottomLine.set_first_point( chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(       swingTrend.bias == BULLISH ? 'Lembah Kuat' : 'Lembah Lemah')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)
    b_ox.set_top_left_point(    chart.point.new(trailing.barTime,na,top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))
    l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)
    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)
    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

// =====================================================================================================================
// 🌟 BAGIAN 8: LOGIKA YATA S&R
// =====================================================================================================================
var ph_index = array.new_int()
var pl_index = array.new_int()
var ph_value = array.new_float()
var pl_value = array.new_float()

interp(l, h, s) => l + (h - l) * s

yata_ph = ta.pivothigh(source, yata_length, yata_length)
if not na(yata_ph)
    ok = true
    yata_ph := high[yata_length]
    if array.size(ph_index) > 0
        if array.size(ph_index) >= max_h_pivot_points
            array.shift(ph_index)
            array.shift(ph_value)
        for i = 0 to array.size(ph_value) - 1
            if math.abs(yata_ph - array.get(ph_value, i)) < min_difference
                ok := false
                if yata_ph > array.get(ph_value, i)
                    array.set(ph_value, i , yata_ph)
                    array.set(ph_index, i , bar_index[yata_length])
    if ok
        array.push(ph_index, bar_index[yata_length])
        array.push(ph_value, yata_ph)

yata_pl = ta.pivotlow(source, yata_length, yata_length)
if not na(yata_pl)
    ok = true
    yata_pl := low[yata_length]
    if array.size(pl_index) > 0
        if array.size(pl_index) >= max_l_pivot_points
            array.shift(pl_index)
            array.shift(pl_value)
        for i = 0 to array.size(pl_value) - 1
            if math.abs(yata_pl - array.get(pl_value, i)) < min_difference
                ok := false
                if yata_pl < array.get(pl_value, i)
                    array.set(pl_value, i , yata_pl)
                    array.set(pl_index, i , bar_index[yata_length])
    if ok
        array.push(pl_index, bar_index[yata_length])
        array.push(pl_value, yata_pl)

var yata_lines  = array.new_line()
var yata_labels = array.new_label()
var yata_fibs   = array.new_line()

var line line_fc_up   = line(na)
var line line_fc_down = line(na)
var linefill fill_fc  = linefill(na)

rsiValueYata = ta.rsi(close, 14)

if barstate.isconfirmed
    ph_count = array.size(ph_index)
    pl_count = array.size(pl_index)

    if array.size(yata_lines) > 0
        for i = 0 to array.size(yata_lines) - 1
            line.delete(array.get(yata_lines, i))
        array.clear(yata_lines)

    if array.size(yata_labels) > 0
        for i = 0 to array.size(yata_labels) - 1
            label.delete(array.get(yata_labels, i))
        array.clear(yata_labels)

    if ph_count > 0
        for i = 0 to ph_count - 1
            if d_lbl_pivh
                array.push(yata_labels, label.new(array.get(ph_index, i), array.get(ph_value, i), "", style=label.style_label_down, color=ILB1, size=size.tiny))
            if d_pivh
                array.push(yata_lines, line.new(array.get(ph_index, i), array.get(ph_value, i), bar_index + channel_ext_length, array.get(ph_value, i), color=ILN1, width=lwidth_piv, style=f_getLineStyle(ppstyleIHL_input), extend=extend.none))
    if pl_count > 0
        for i = 0 to pl_count - 1
            if d_lbl_pivl
                array.push(yata_labels, label.new(array.get(pl_index, i), array.get(pl_value, i), "", style=label.style_label_up, color=ILB2, size=size.tiny))
            if  d_pivl
                array.push(yata_lines, line.new(array.get(pl_index, i), array.get(pl_value, i), bar_index + channel_ext_length, array.get(pl_value, i), color=ILN2, width=lwidth_piv, style=f_getLineStyle(ppstyleIHL_input), extend=extend.none))

    if d_chanh
        if ph_count > 1
            tmp_arr = array.new_line()
            for i = 0 to ph_count - 1
                for j = 0 to ph_count - 1
                    h0  = array.get(ph_value, i)
                    h1  = array.get(ph_value, j)
                    h0i = array.get(ph_index, i)
                    h1i = array.get(ph_index, j)
                    if h0i < h1i
                        array.push(tmp_arr, line.new(h0i, h0, h1i, h1, color=RLN, width=lwidth_chan, extend=extend.none, style=f_getLineStyle(ppstyleSRL_input)))
                    if h0i > h1i
                        array.push(tmp_arr, line.new(h1i, h1, h0i, h0, color=RLN, width=lwidth_chan, extend=extend.none, style=f_getLineStyle(ppstyleSRL_input)))

            int   min_ind = na
            float min_val = 100000.0
            for i = 0 to array.size(tmp_arr) - 1
                lp = line.get_price(array.get(tmp_arr, i), bar_index)
                if lp > high
                    if min_val > math.abs(lp - close)
                        min_val := math.abs(lp - close)
                        min_ind := i

            if not na(min_ind)
                line.delete(line_fc_up[1])
                best_line = array.get(tmp_arr, min_ind)
                line_fc_up := line.new(line.get_x1(best_line), line.get_y1(best_line), line.get_x2(best_line), line.get_y2(best_line), color=RLN, width=lwidth_chan, extend=extendL, style=f_getLineStyle(ppstyleSRL_input))

            if array.size(tmp_arr) > 0
                for i = 0 to array.size(tmp_arr) - 1
                    line.delete(array.get(tmp_arr, i))
                array.clear(tmp_arr)

            for l in yata_labels
                if label.get_x(l) == line.get_x1(line_fc_up) or label.get_x(l) == line.get_x2(line_fc_up)
                    label.set_color(l, ALB1)

            for l in yata_lines
                if line.get_x1(l) == line.get_x1(line_fc_up) or line.get_x1(l) == line.get_x2(line_fc_up)
                    line.set_color(l, ALN1)
                    line.set_style(l, f_getLineStyle(ppstyleAHL_input))
                    line.set_width(l, lwidth_piv)

        line.set_y2(line_fc_up, line.get_price(line_fc_up, bar_index + channel_ext_length))
        line.set_x2(line_fc_up, bar_index + channel_ext_length)

    if d_chanl
        if pl_count > 1
            tmp_arr = array.new_line()
            for i = 0 to pl_count - 1
                for j = 0 to pl_count - 1
                    l0  = array.get(pl_value, i)
                    l1  = array.get(pl_value, j)
                    l0i = array.get(pl_index, i)
                    l1i = array.get(pl_index, j)
                    if l0i < l1i
                        array.push(tmp_arr, line.new(l0i, l0, l1i, l1, color=SLN, width=lwidth_chan, extend=extend.none, style=f_getLineStyle(ppstyleSRL_input)))
                    if l0i > l1i
                        array.push(tmp_arr, line.new(l1i, l1, l0i, l0, color=SLN, width=lwidth_chan, extend=extend.none, style=f_getLineStyle(ppstyleSRL_input)))

            int   min_ind = na
            float min_val = 100000.0
            for i = 0 to array.size(tmp_arr) - 1
                lp = line.get_price(array.get(tmp_arr, i), bar_index)
                if lp < low
                    if min_val > math.abs(lp - close)
                        min_val := math.abs(lp - close)
                        min_ind := i

            if not na(min_ind)
                line.delete(line_fc_down[1])
                best_line = array.get(tmp_arr, min_ind)
                line_fc_down := line.new(line.get_x1(best_line), line.get_y1(best_line), line.get_x2(best_line), line.get_y2(best_line), color=SLN, width=lwidth_chan, extend=extendL, style=f_getLineStyle(ppstyleSRL_input))

            if array.size(tmp_arr) > 0
                for i = 0 to array.size(tmp_arr) - 1
                    line.delete(array.get(tmp_arr, i))
                array.clear(tmp_arr)

            for l in yata_labels
                if label.get_x(l) == line.get_x1(line_fc_down) or label.get_x(l) == line.get_x2(line_fc_down)
                    label.set_color(l, ALB2)

            for l in yata_lines
                if line.get_x1(l) == line.get_x1(line_fc_down) or line.get_x1(l) == line.get_x2(line_fc_down)
                    line.set_color(l, ALN2)
                    line.set_style(l, f_getLineStyle(ppstyleAHL_input))
                    line.set_width(l, lwidth_piv)

        line.set_y2(line_fc_down, line.get_price(line_fc_down, bar_index + channel_ext_length))
        line.set_x2(line_fc_down, bar_index + channel_ext_length)

    if not na(line_fc_up) and not na(line_fc_down) and f_bg
        linefill.delete(fill_fc[1])
        fill_color = color.new(color.from_gradient(rsiValueYata, 30, 70, GF1, GF2), f_transp)
        fill_fc   := linefill.new(line_fc_up, line_fc_down, fill_color)

    if not na(line_fc_up) and not na(line_fc_down) and d_fib
        if array.size(yata_fibs) > 0
            for i = 0 to array.size(yata_fibs) - 1
                line.delete(array.get(yata_fibs, i))
            array.clear(yata_fibs)

        left  = math.min(line.get_x1(line_fc_up), line.get_x1(line_fc_down))
        right = bar_index + channel_ext_length
        left_val   = interp(line.get_price(line_fc_down, left), line.get_price(line_fc_up, left)    , fib_R01)
        right_val  = interp(line.get_price(line_fc_down, right), line.get_price(line_fc_up, right)  , fib_R01)
        array.push(yata_fibs, line.new(left, left_val, right, right_val, style=f_getLineStyle(ppstyleFRL_input), width=lwidth_FR, color=color.from_gradient(right_val, line.get_price(line_fc_down, right), line.get_price(line_fc_up, right), FRL, FRH)))
        left_val  := interp(line.get_price(line_fc_down, left), line.get_price(line_fc_up, left)    , fib_R02)
        right_val := interp(line.get_price(line_fc_down, right), line.get_price(line_fc_up, right)  , fib_R02)
        array.push(yata_fibs, line.new(left, left_val, right, right_val, style=f_getLineStyle(ppstyleFRL_input), width=lwidth_FR, color=color.from_gradient(right_val, line.get_price(line_fc_down, right), line.get_price(line_fc_up, right), FRL, FRH)))
        left_val  := interp(line.get_price(line_fc_down, left), line.get_price(line_fc_up, left)    , fib_R03)
        right_val := interp(line.get_price(line_fc_down, right), line.get_price(line_fc_up, right)  , fib_R03)
        array.push(yata_fibs, line.new(left, left_val, right, right_val, style=f_getLineStyle(ppstyleFRL_input), width=lwidth_FR, color=color.from_gradient(right_val, line.get_price(line_fc_down, right), line.get_price(line_fc_up, right), FRL, FRH)))

        if d_fib2
            left_val  := interp(line.get_price(line_fc_down, left), line.get_price(line_fc_up, left)    , fib_E01)
            right_val := interp(line.get_price(line_fc_down, right), line.get_price(line_fc_up, right)  , fib_E01)
            array.push(yata_fibs, line.new(left, left_val, right, right_val, style=f_getLineStyle(ppstyleFEL_input), width=lwidth_FE, color=color.from_gradient(right_val, line.get_price(line_fc_down, right), line.get_price(line_fc_up, right), FEL, FEH)))

// =====================================================================================================================
// 🌟 BAGIAN 9: EKSEKUSI COMPOSITE & ALERTS
// =====================================================================================================================
// PHASE 2 (ADDITIVE — FITUR 24): tambah "or instEngineOn" agar trailing extremes tetap ter-update
// untuk filter Premium/Discount walau tampilan zona P/D dimatikan. Gambar tetap ikut input lama.
if showHighLowSwingsInput or showPremiumDiscountZonesInput or instEngineOn
    updateTrailingExtremes()
    if showHighLowSwingsInput
        drawHighLowSwings()
    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()
if showFairValueGapsInput
    deleteFairValueGaps()

getCurrentStructure(swingsLengthInput,false)
getCurrentStructure(5,false,true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput,true)
if showInternalsInput or showInternalOrderBlocksInput or showTrendInput or trackInternalOB
    displayStructure(true)
if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
    displayStructure()
if trackInternalOB
    deleteOrderBlocks(true)
if showSwingOrderBlocksInput
    deleteOrderBlocks()
if showFairValueGapsInput
    drawFairValueGaps()
if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput
        drawOrderBlocks(true)
    if showSwingOrderBlocksInput
        drawOrderBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

// --- KOMPOSIT WARNA CANDLE ---
isLowVol = volume < ta.sma(volume, 20)
isInsideBar = high < high[1] and low > low[1]
isGrey = isLowVol or isInsideBar
isBullishReversal = close > open and close > high[1] and low[1] < low[2]

trendColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
finalBarColor = isBullishReversal ? color.blue : isGrey ? color.gray : (showTrendInput ? trendColor : na)

barcolor(finalBarColor, title="Composite Bar Color")
plotshape(isBullishReversal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Reversal Signal")

// =====================================================================================================================
// 🌟 BAGIAN 9.4: DYNAMIC FRESH ZONE ENGINE (SUPPLY & DEMAND INSTITUSIONAL) — BARU (ADDITIVE)
// =====================================================================================================================
// Semua validasi zona memakai candle CLOSE penuh (barstate.isconfirmed) — anti-repaint (FITUR 17).
// Object reuse: 1 box per zona, dibuat sekali saat zona lahir, dihapus saat zona mati (FITUR 16).

type sdZone
    float top        = na
    float bottom     = na
    int   bias       = 0        // BULLISH = Demand, BEARISH = Supply
    int   leftTime   = 0
    int   createdBar = 0
    int   touchCount = 0
    bool  wasInside  = false
    bool  broken     = false
    bool  nearFVG    = false
    bool  highVol    = false
    box   zBox       = na

var array<sdZone> sdZones        = array.new<sdZone>()
var array<label>  sdBrokenLabels = array.new<label>()

// Flag alert Zone Engine (reset tiap bar) — FITUR 15
bool freshDemandCreatedAlert = false
bool freshSupplyCreatedAlert = false
bool demandBrokenAlert       = false
bool supplyBrokenAlert       = false
bool zoneExpiredAlert        = false

// FITUR 4 — ZONE QUALITY SCORE: Fresh=100%, 1 Touch=75%, 2 Touch=50%, 3+ Touch=25%, Broken=0%
f_zoneQuality(sdZone z) =>
    z.broken ? 0 : z.touchCount == 0 ? 100 : z.touchCount == 1 ? 75 : z.touchCount == 2 ? 50 : 25

f_qualityEmoji(int q) =>
    q >= 100 ? "🟢" : q >= 75 ? "🟡" : q >= 50 ? "🟠" : q > 0 ? "🔴" : "⚫"

// FITUR 8 — PRIORITY ZONE: fresh > belum disentuh > dekat EMA200 > searah HTF > dekat FVG > volume tinggi > baru terbentuk
f_zoneRank(sdZone z) =>
    int r = 0
    r += z.touchCount == 0 ? 4 : z.touchCount == 1 ? 2 : 0
    float zMid = math.avg(z.top, z.bottom)
    r += math.abs(zMid - ema200) / ema200 * 100.0 <= maxEmaDistPct ? 2 : 0
    r += (z.bias == BULLISH and biasDir == 1) or (z.bias == BEARISH and biasDir == -1) ? 2 : 0
    r += z.nearFVG ? 1 : 0
    r += z.highVol ? 1 : 0
    r += (bar_index - z.createdBar) <= 20 ? 1 : 0
    z.broken ? -1 : r

f_bestZoneIdx() =>
    int best = -1
    int bestR = -999
    if sdZones.size() > 0
        for i = 0 to sdZones.size() - 1
            int r = f_zoneRank(sdZones.get(i))
            if r > bestR
                bestR := r
                best := i
    best

f_deleteZone(int idx) =>
    sdZone z = sdZones.get(idx)
    if not na(z.zBox)
        box.delete(z.zBox)
    sdZones.remove(idx)

f_countSide(int biasWanted, bool freshOnly) =>
    int n = 0
    if sdZones.size() > 0
        for z in sdZones
            if z.bias == biasWanted and not z.broken and (not freshOnly or z.touchCount == 0)
                n += 1
    n

f_removeOldestSide(int biasWanted) =>
    if sdZones.size() > 0
        int oldestIdx = -1
        int oldestBar = bar_index + 1
        for i = 0 to sdZones.size() - 1
            sdZone z = sdZones.get(i)
            if z.bias == biasWanted and z.createdBar < oldestBar
                oldestBar := z.createdBar
                oldestIdx := i
        if oldestIdx >= 0
            f_deleteZone(oldestIdx)

// FITUR 9 — AUTO MERGE: zona baru yang overlap dengan zona searah digabung jadi satu (tidak ada box bertumpuk)
f_createZone(int biasWanted, float zTopIn, float zBottomIn, int leftT) =>
    bool created = false
    if not na(zTopIn) and not na(zBottomIn) and zTopIn > zBottomIn
        float mTop    = zTopIn
        float mBottom = zBottomIn
        int   mTouch  = 0
        int   mBar    = bar_index
        int   mLeft   = leftT
        if sdZones.size() > 0
            for i = sdZones.size() - 1 to 0
                sdZone zOld = sdZones.get(i)
                if zOld.bias == biasWanted and not zOld.broken and zOld.top >= mBottom and zOld.bottom <= mTop
                    mTop    := math.max(mTop, zOld.top)
                    mBottom := math.min(mBottom, zOld.bottom)
                    mTouch  := math.max(mTouch, zOld.touchCount)
                    mBar    := math.min(mBar, zOld.createdBar)
                    mLeft   := math.min(mLeft, zOld.leftTime)
                    f_deleteZone(i)
        if f_countSide(biasWanted, false) >= maxZonesPerSide
            f_removeOldestSide(biasWanted)
        sdZone zNew = sdZone.new(top = mTop, bottom = mBottom, bias = biasWanted, leftTime = mLeft, createdBar = mBar)
        zNew.touchCount := mTouch
        zNew.nearFVG    := hasFVG
        zNew.highVol    := highVolume
        zNew.wasInside  := math.min(high, mTop) - math.max(low, mBottom) > 0
        if showZoneEngine
            color zcNew = biasWanted == BULLISH ? color.teal : color.orange
            zNew.zBox := box.new(chart.point.new(mLeft, na, mTop), chart.point.new(time, na, mBottom), xloc = xloc.bar_time, extend = extend.right, border_color = color.new(zcNew, 35), border_width = 2, bgcolor = color.new(zcNew, 80), text_size = size.tiny, text_halign = text.align_left, text_color = color.new(zcNew, 20))
        sdZones.unshift(zNew)
        created := true
    created

// FITUR 13 — FILTER ENTRY: harga harus berada DI DALAM zona searah yang belum broken/expired & kualitas >= minimal
f_inZoneQualified(int biasWanted) =>
    bool ok = false
    if sdZones.size() > 0
        for z in sdZones
            if z.bias == biasWanted and not z.broken and f_zoneQuality(z) >= minZoneQuality and math.min(high, z.top) - math.max(low, z.bottom) > 0
                ok := true
                break
    ok

// FITUR 14 — MTF SCALPING: zona diambil dari TF Konfirmasi hierarki MTF (chart M5 -> zona M15).
// Pola anti-repaint standar: series di-offset [1] + lookahead_on = nilai bar HTF yang SUDAH close, tidak berubah lagi.
string sdZoneTf = zoneMTFOn ? tfZoneUsed : timeframe.period
[zSupPrice, zSupBase, zDemPrice, zDemBase, zPivTime] = request.security(syminfo.tickerid, sdZoneTf, [ta.pivothigh(high, zonePivotLen, zonePivotLen)[1], low[zonePivotLen + 1], ta.pivotlow(low, zonePivotLen, zonePivotLen)[1], high[zonePivotLen + 1], time[zonePivotLen + 1]], lookahead = barmerge.lookahead_on)

var int lastSupplyPivTime = 0
var int lastDemandPivTime = 0

if zoneEngineOn and barstate.isconfirmed
    // FITUR 7 — CHOCH RESET: ganti arah -> hapus semua zona lama yang berlawanan arah (chart tetap bersih)
    bool chochBullNow = currentAlerts.internalBullishCHoCH or currentAlerts.swingBullishCHoCH
    bool chochBearNow = currentAlerts.internalBearishCHoCH or currentAlerts.swingBearishCHoCH
    if (chochBullNow or chochBearNow) and sdZones.size() > 0
        for i = sdZones.size() - 1 to 0
            sdZone z = sdZones.get(i)
            if (chochBullNow and z.bias == BEARISH) or (chochBearNow and z.bias == BULLISH)
                f_deleteZone(i)

    // FITUR 1 / 3 / 5 / 10 — auto refresh (break by close), mitigation counter, auto delete, expired
    if sdZones.size() > 0
        for i = sdZones.size() - 1 to 0
            sdZone z = sdZones.get(i)
            bool removeZone = false

            // FITUR 10 — EXPIRED ZONE (berlaku juga untuk sisa zona broken saat Fresh Zone Only = OFF)
            if (bar_index - z.createdBar) > maxZoneAgeInput
                if not z.broken
                    zoneExpiredAlert := true
                removeZone := true

            // FITUR 1 — AUTO REFRESH: invalid hanya jika candle CLOSE penuh menembus batas zona (bukan wick)
            if not removeZone and not z.broken
                if z.bias == BULLISH and close < z.bottom
                    demandBrokenAlert := true
                    z.broken := true
                    if sdBrokenLabels.size() >= 12
                        label.delete(sdBrokenLabels.pop())
                    sdBrokenLabels.unshift(label.new(bar_index, z.bottom, "BROKEN DEMAND", style = label.style_label_up, color = color.new(color.gray, 100), textcolor = color.new(color.gray, 25), size = size.tiny))
                    if freshOnlyInput
                        removeZone := true
                    else if not na(z.zBox)
                        box.set_bgcolor(z.zBox, color.new(color.gray, 92))
                        box.set_border_color(z.zBox, color.new(color.gray, 70))
                        box.set_border_width(z.zBox, 1)
                        box.set_text(z.zBox, "BROKEN DEMAND")
                        box.set_text_color(z.zBox, color.new(color.gray, 40))
                else if z.bias == BEARISH and close > z.top
                    supplyBrokenAlert := true
                    z.broken := true
                    if sdBrokenLabels.size() >= 12
                        label.delete(sdBrokenLabels.pop())
                    sdBrokenLabels.unshift(label.new(bar_index, z.top, "BROKEN SUPPLY", style = label.style_label_down, color = color.new(color.gray, 100), textcolor = color.new(color.gray, 25), size = size.tiny))
                    if freshOnlyInput
                        removeZone := true
                    else if not na(z.zBox)
                        box.set_bgcolor(z.zBox, color.new(color.gray, 92))
                        box.set_border_color(z.zBox, color.new(color.gray, 70))
                        box.set_border_width(z.zBox, 1)
                        box.set_text(z.zBox, "BROKEN SUPPLY")
                        box.set_text_color(z.zBox, color.new(color.gray, 40))

            // FITUR 3 — MITIGATION: touch dihitung saat candle MASUK ke area zona (overlap > 0, bukan sekadar sentuh garis)
            if not removeZone and not z.broken
                bool insideNow = math.min(high, z.top) - math.max(low, z.bottom) > 0
                if insideNow and not z.wasInside
                    z.touchCount += 1
                z.wasInside := insideNow
                // FITUR 5 — AUTO DELETE LOW QUALITY ZONE
                if z.touchCount > maxTouchInput
                    removeZone := true

            if removeZone
                f_deleteZone(i)

    // FITUR 6 — BOS LINK: Supply break = Bullish BOS -> langsung bangun Demand baru dari Pivot Low chart terakhir.
    //                     Demand break = Bearish BOS -> langsung bangun Supply baru dari Swing High chart terakhir.
    if supplyBrokenAlert and not na(lastPL) and not na(baseDemandTop) and not na(lastPL_index)
        int seedTimeD = times.size() > lastPL_index ? times.get(lastPL_index) : time
        if f_createZone(BULLISH, baseDemandTop, lastPL, seedTimeD)
            freshDemandCreatedAlert := true
    if demandBrokenAlert and not na(lastPH) and not na(baseSupplyBottom) and not na(lastPH_index)
        int seedTimeS = times.size() > lastPH_index ? times.get(lastPH_index) : time
        if f_createZone(BEARISH, lastPH, baseSupplyBottom, seedTimeS)
            freshSupplyCreatedAlert := true

    // Zona baru dari pivot TF Zona (MTF) — dikunci per waktu pivot agar tidak duplikat
    if not na(zSupPrice) and zPivTime != lastSupplyPivTime
        lastSupplyPivTime := zPivTime
        if f_createZone(BEARISH, zSupPrice, zSupBase, zPivTime)
            freshSupplyCreatedAlert := true
    if not na(zDemPrice) and zPivTime != lastDemandPivTime
        lastDemandPivTime := zPivTime
        if f_createZone(BULLISH, zDemBase, zDemPrice, zPivTime)
            freshDemandCreatedAlert := true

// FITUR 8 + 11 — VISUAL: zona prioritas tertinggi paling tegas (★), lainnya lebih transparan;
// Fresh = border tebal, 1 touch = normal, 2 touch = lebih transparan, hampir expired = border putus-putus
// R1.1 REFACTOR (MODUL 4)
f_drawZones() =>
    int bestIdxVis = f_bestZoneIdx()
    for i = 0 to sdZones.size() - 1
        sdZone z = sdZones.get(i)
        if not na(z.zBox) and not z.broken
            bool isBest = i == bestIdxVis
            color zc = z.bias == BULLISH ? color.teal : color.orange
            int baseTransp = z.touchCount == 0 ? 78 : z.touchCount == 1 ? 85 : 90
            box.set_bgcolor(z.zBox, color.new(zc, isBest ? math.max(baseTransp - 10, 60) : baseTransp))
            box.set_border_color(z.zBox, color.new(zc, isBest ? 0 : 45))
            box.set_border_width(z.zBox, z.touchCount == 0 ? 2 : 1)
            bool nearExpiry = (bar_index - z.createdBar) > maxZoneAgeInput * 0.8
            box.set_border_style(z.zBox, nearExpiry ? line.style_dotted : line.style_solid)
            int q = f_zoneQuality(z)
            box.set_text(z.zBox, (z.bias == BULLISH ? "DEMAND " : "SUPPLY ") + f_qualityEmoji(q) + " " + str.tostring(q) + "% • " + str.tostring(z.touchCount) + "x" + (isBest ? " ★" : ""))
            box.set_text_color(z.zBox, color.new(zc, isBest ? 0 : 45))

if zoneEngineOn and showZoneEngine and sdZones.size() > 0 and (barstate.isconfirmed or barstate.islast)
    f_drawZones()

// FITUR 2 + 13 — gerbang entry: BUY wajib di Demand berkualitas, SELL wajib di Supply berkualitas
bool inQualifiedDemand = zoneEngineOn and f_inZoneQualified(BULLISH)
bool inQualifiedSupply = zoneEngineOn and f_inZoneQualified(BEARISH)
bool zoneOkBuy  = not zoneEngineOn or not useZoneEntry or inQualifiedDemand
bool zoneOkSell = not zoneEngineOn or not useZoneEntry or inQualifiedSupply

// =====================================================================================================================
// 🌟 BAGIAN 9.45: INSTITUTIONAL SNIPER ENGINE (PHASE 2) — BARU (ADDITIVE)
// =====================================================================================================================
// FITUR 34 — semua validasi memakai candle close (barstate.isconfirmed); struktur diambil dari engine lama yang sudah anti-repaint.

// ---------- FITUR 19 & 20 : LIQUIDITY SWEEP ENGINE + LIQUIDITY MAP ----------
type liqLevel
    float price     = na
    int   barTime   = 0
    int   bias      = 0      // BEARISH = Buy Side Liquidity (di atas harga), BULLISH = Sell Side Liquidity (di bawah harga)
    bool  internal  = false
    bool  isEqual   = false
    bool  swept     = false
    int   sweptBar  = 0
    line  lLine     = na
    label lLabel    = na

var array<liqLevel> liqLevels = array.new<liqLevel>()
bool liqSweepAlertFlag = false

f_liqCountSide(int biasWanted, bool unsweptOnly) =>
    int n = 0
    if liqLevels.size() > 0
        for lv in liqLevels
            if lv.bias == biasWanted and (not unsweptOnly or not lv.swept)
                n += 1
    n

f_deleteLiq(int idx) =>
    liqLevel lv = liqLevels.get(idx)
    if not na(lv.lLine)
        line.delete(lv.lLine)
    if not na(lv.lLabel)
        label.delete(lv.lLabel)
    liqLevels.remove(idx)

f_removeOldestLiq(int biasWanted) =>
    if liqLevels.size() > 0
        int oldestIdx = -1
        int oldestTime = time + 1
        for i = 0 to liqLevels.size() - 1
            liqLevel lv = liqLevels.get(i)
            if lv.bias == biasWanted and lv.barTime < oldestTime
                oldestTime := lv.barTime
                oldestIdx := i
        if oldestIdx >= 0
            f_deleteLiq(oldestIdx)

f_addLiq(float lvPrice, int lvTime, int biasWanted, bool isInternal, bool isEq) =>
    if not na(lvPrice)
        bool dup = false
        if liqLevels.size() > 0
            for lv in liqLevels
                if lv.bias == biasWanted and math.abs(lv.price - lvPrice) < atrVal * 0.1
                    dup := true
                    break
        if not dup
            if f_liqCountSide(biasWanted, false) >= maxLiqPerSide
                f_removeOldestLiq(biasWanted)
            liqLevel lvNew = liqLevel.new(price = lvPrice, barTime = lvTime, bias = biasWanted, internal = isInternal, isEqual = isEq)
            if showLiqMap
                lvNew.lLine := line.new(chart.point.new(lvTime, na, lvPrice), chart.point.new(time, na, lvPrice), xloc = xloc.bar_time, extend = extend.right, color = color.new(color.gray, isInternal ? 55 : 35), width = 1, style = isInternal ? line.style_dotted : line.style_solid)
                string liqTag = isEq ? (biasWanted == BEARISH ? "EQH • BSL" : "EQL • SSL") : biasWanted == BEARISH ? (isInternal ? "iBSL" : "BSL") : (isInternal ? "iSSL" : "SSL")
                lvNew.lLabel := label.new(chart.point.new(lvTime, na, lvPrice), liqTag, xloc.bar_time, color = color(na), textcolor = color.new(color.gray, 30), style = biasWanted == BEARISH ? label.style_label_down : label.style_label_up, size = size.tiny)
            liqLevels.unshift(lvNew)

// Level liquidity dibangun dari swing structure LuxAlgo yang SUDAH ADA (tidak membuat swing engine baru)
var float lastSeenSwingHigh    = na
var float lastSeenSwingLow     = na
var float lastSeenInternalHigh = na
var float lastSeenInternalLow  = na

if instEngineOn and barstate.isconfirmed
    if not na(swingHigh.currentLevel) and (na(lastSeenSwingHigh) or swingHigh.currentLevel != lastSeenSwingHigh)
        lastSeenSwingHigh := swingHigh.currentLevel
        f_addLiq(swingHigh.currentLevel, swingHigh.barTime, BEARISH, false, false)      // External BSL
    if not na(swingLow.currentLevel) and (na(lastSeenSwingLow) or swingLow.currentLevel != lastSeenSwingLow)
        lastSeenSwingLow := swingLow.currentLevel
        f_addLiq(swingLow.currentLevel, swingLow.barTime, BULLISH, false, false)        // External SSL
    if not na(internalHigh.currentLevel) and (na(lastSeenInternalHigh) or internalHigh.currentLevel != lastSeenInternalHigh)
        lastSeenInternalHigh := internalHigh.currentLevel
        f_addLiq(internalHigh.currentLevel, internalHigh.barTime, BEARISH, true, false) // Internal BSL
    if not na(internalLow.currentLevel) and (na(lastSeenInternalLow) or internalLow.currentLevel != lastSeenInternalLow)
        lastSeenInternalLow := internalLow.currentLevel
        f_addLiq(internalLow.currentLevel, internalLow.barTime, BULLISH, true, false)   // Internal SSL
    if currentAlerts.equalHighs
        f_addLiq(equalHigh.currentLevel, equalHigh.barTime, BEARISH, false, true)       // EQH = Buy Side Liquidity kuat
    if currentAlerts.equalLows
        f_addLiq(equalLow.currentLevel, equalLow.barTime, BULLISH, false, true)         // EQL = Sell Side Liquidity kuat

    // Sweep check (close candle) + pembersihan level basi (FITUR 33)
    if liqLevels.size() > 0
        for i = liqLevels.size() - 1 to 0
            liqLevel lv = liqLevels.get(i)
            if not lv.swept
                if lv.bias == BEARISH and high > lv.price
                    lv.swept := true
                    lv.sweptBar := bar_index
                    liqSweepAlertFlag := true
                    if not na(lv.lLine)
                        line.set_color(lv.lLine, color.new(color.gray, 85))
                    if not na(lv.lLabel)
                        label.set_textcolor(lv.lLabel, color.new(color.gray, 80))
                else if lv.bias == BULLISH and low < lv.price
                    lv.swept := true
                    lv.sweptBar := bar_index
                    liqSweepAlertFlag := true
                    if not na(lv.lLine)
                        line.set_color(lv.lLine, color.new(color.gray, 85))
                    if not na(lv.lLabel)
                        label.set_textcolor(lv.lLabel, color.new(color.gray, 80))
            else if (bar_index - lv.sweptBar) > liqSweepLookback * 3
                f_deleteLiq(i)

f_sweptRecently(int biasWanted) =>
    bool okSweep = false
    if liqLevels.size() > 0
        for lv in liqLevels
            if lv.bias == biasWanted and lv.swept and (bar_index - lv.sweptBar) <= liqSweepLookback
                okSweep := true
                break
    okSweep

bool sslSweptRecent = instEngineOn and f_sweptRecently(BULLISH)   // Sell Side sudah diambil -> izin BUY
bool bslSweptRecent = instEngineOn and f_sweptRecently(BEARISH)   // Buy Side sudah diambil -> izin SELL

// ---------- FITUR 21 : FIBONACCI OTE ENGINE (0.618 / 0.705 / 0.786 — memakai swing Fibo yang sudah ada) ----------
float oteDiff       = (not na(lastPH) and not na(lastPL)) ? (lastPH - lastPL) : na
float oteBuyTop     = not na(oteDiff) ? lastPH - oteDiff * 0.618 : na
float oteBuyMid     = not na(oteDiff) ? lastPH - oteDiff * 0.705 : na
float oteBuyBottom  = not na(oteDiff) ? lastPH - oteDiff * 0.786 : na
float oteSellBottom = not na(oteDiff) ? lastPL + oteDiff * 0.618 : na
float oteSellMid    = not na(oteDiff) ? lastPL + oteDiff * 0.705 : na
float oteSellTop    = not na(oteDiff) ? lastPL + oteDiff * 0.786 : na

bool inOTEBuy  = not na(oteBuyTop) and low <= oteBuyTop and high >= oteBuyBottom
bool inOTESell = not na(oteSellTop) and low <= oteSellTop and high >= oteSellBottom

var box oteBox = na
var line oteMidLine = na
if barstate.islast
    if not na(oteBox)
        box.delete(oteBox)
    if not na(oteMidLine)
        line.delete(oteMidLine)
    if instEngineOn and showOTEBox and not na(oteDiff) and (not useSimplePipeline or tradeModeInput == "SMC")
        bool oteBullSide = microTrend == "BULLISH 🟢"
        float oteTopDraw = oteBullSide ? oteBuyTop : oteSellTop
        float oteBotDraw = oteBullSide ? oteBuyBottom : oteSellBottom
        float oteMidDraw = oteBullSide ? oteBuyMid : oteSellMid
        int   oteLeft    = math.max(lastPH_index, lastPL_index)
        oteBox := box.new(oteLeft, oteTopDraw, bar_index, oteBotDraw, bgcolor = color.new(#4FC3F7, 88), border_color = color.new(#4FC3F7, 40), border_width = 1, text = "OTE", text_color = color.new(#4FC3F7, 20), text_size = size.tiny, text_halign = text.align_right)
        oteMidLine := line.new(oteLeft, oteMidDraw, bar_index, oteMidDraw, color = color.new(#4FC3F7, 55), style = line.style_dotted, width = 1)
        if extendLines
            box.set_extend(oteBox, extend.right)
            line.set_extend(oteMidLine, extend.right)

// ---------- FITUR 23 : ORDER BLOCK QUALITY ENGINE (Fresh/Mitigated/Weak/Broken/Expired — persis seperti zona S&D) ----------
// Catatan: OB "Broken" SUDAH otomatis dihapus oleh deleteOrderBlocks() bawaan LuxAlgo (mitigasi close/wick).
if instEngineOn and barstate.isconfirmed and internalOrderBlocks.size() > 0
    for i = internalOrderBlocks.size() - 1 to 0
        orderBlock obQ = internalOrderBlocks.get(i)
        if obQ.createdBar == 0
            obQ.createdBar := bar_index
        bool removeOB = false
        if (bar_index - obQ.createdBar) > maxZoneAgeInput
            removeOB := true                              // Expired
        if not removeOB
            bool insideOB = math.min(high, obQ.barHigh) - math.max(low, obQ.barLow) > 0
            if insideOB and not obQ.wasInside
                obQ.touchCount += 1                       // Mitigation dihitung seperti zona
            obQ.wasInside := insideOB
            if obQ.touchCount > maxTouchInput
                removeOB := true                          // Weak -> hapus otomatis
        if removeOB
            internalOrderBlocks.remove(i)

// Bersihkan box OB sisa saat jumlah OB berkurang (object reuse — FITUR 33)
if barstate.islast and instEngineOn and internalOrderBlocksBoxes.size() > internalOrderBlocks.size()
    for i = internalOrderBlocks.size() to internalOrderBlocksBoxes.size() - 1
        box bStale = internalOrderBlocksBoxes.get(i)
        bStale.set_bgcolor(na)
        bStale.set_border_color(na)

f_obQuality(orderBlock obX) =>
    obX.touchCount == 0 ? 100 : obX.touchCount == 1 ? 75 : obX.touchCount == 2 ? 50 : 25

f_freshOBInfo(int biasWanted) =>
    bool found = false
    float obTop = na
    float obBot = na
    if internalOrderBlocks.size() > 0
        for obX in internalOrderBlocks
            if obX.bias == biasWanted and f_obQuality(obX) >= minZoneQuality
                found := true
                obTop := obX.barHigh
                obBot := obX.barLow
                break
    [found, obTop, obBot]

[hasFreshBullOB, freshBullOBTop, freshBullOBBot] = f_freshOBInfo(BULLISH)
[hasFreshBearOB, freshBearOBTop, freshBearOBBot] = f_freshOBInfo(BEARISH)

f_countFreshOB(int biasWanted) =>
    int n = 0
    if internalOrderBlocks.size() > 0
        for obX in internalOrderBlocks
            if obX.bias == biasWanted and obX.touchCount == 0
                n += 1
    n

// ---------- FITUR 24 : PREMIUM / DISCOUNT FILTER (memakai trailing extremes zona P/D yang sudah ada) ----------
float pdEquilibrium = (not na(trailing.top) and not na(trailing.bottom)) ? math.avg(trailing.top, trailing.bottom) : na
bool inDiscount = na(pdEquilibrium) ? true : close < pdEquilibrium
bool inPremium  = na(pdEquilibrium) ? true : close > pdEquilibrium

// ---------- FITUR 25 : SESSION SCORING (Overlap ★6 > London/NY ★5 > Asia ★2) ----------
bool inAsiaSess    = not na(time(timeframe.period, sessAsia, "UTC"))
bool inLondonSess  = not na(time(timeframe.period, sessLondon, "UTC"))
bool inOverlapSess = not na(time(timeframe.period, sessOverlap, "UTC"))
bool inNYSess      = not na(time(timeframe.period, sessNY, "UTC"))
int sessionScore = inOverlapSess ? 6 : inLondonSess ? 5 : inNYSess ? 5 : inAsiaSess ? 2 : 3
string sessionName = inOverlapSess ? "LDN+NY ★★★★★★" : inLondonSess ? "London ★★★★★" : inNYSess ? "New York ★★★★★" : inAsiaSess ? "Asia ★★☆☆☆" : "Antar Sesi ★★★☆☆"

// ---------- FITUR 26 : ATR VOLATILITY & SPREAD FILTER ----------
bool atrOk    = not instEngineOn or minATRInput <= 0 or atrVal >= minATRInput
bool spreadOk = not instEngineOn or maxSpreadPct <= 0 or spreadInPrice <= atrVal * (maxSpreadPct / 100.0)

// ---------- Pelacak BOS / CHOCH terbaru (dari LuxAlgo, untuk Confidence) ----------
var int lastBullBOSBar   = na
var int lastBearBOSBar   = na
var int lastBullChochBar = na
var int lastBearChochBar = na
if barstate.isconfirmed
    if currentAlerts.swingBullishBOS or currentAlerts.internalBullishBOS
        lastBullBOSBar := bar_index
    if currentAlerts.swingBearishBOS or currentAlerts.internalBearishBOS
        lastBearBOSBar := bar_index
    if currentAlerts.swingBullishCHoCH or currentAlerts.internalBullishCHoCH
        lastBullChochBar := bar_index
    if currentAlerts.swingBearishCHoCH or currentAlerts.internalBearishCHoCH
        lastBearChochBar := bar_index
bool recentBullBOS   = not na(lastBullBOSBar)   and (bar_index - lastBullBOSBar)   <= 50
bool recentBearBOS   = not na(lastBearBOSBar)   and (bar_index - lastBearBOSBar)   <= 50
bool recentBullChoch = not na(lastBullChochBar) and (bar_index - lastBullChochBar) <= 50
bool recentBearChoch = not na(lastBearChochBar) and (bar_index - lastBearChochBar) <= 50

// ---------- PHASE 3 • FITUR 36 : ADAPTIVE MARKET REGIME ENGINE ----------
// Memakai data yang SUDAH ADA: ATR, EMA200, swing structure, BOS/CHoCH, range, volume. Tidak ada indikator baru.
REG_RANGE    = 0
REG_TREND    = 1
REG_STRONG   = 2
REG_COMPRESS = 3
REG_EXPAND   = 4

float atrBaseline  = ta.sma(atrVal, 50)
float atrRatio     = atrBaseline > 0 ? atrVal / atrBaseline : 1.0
float rangeWidth20 = ta.highest(high, 20) - ta.lowest(low, 20)

bool emaRising  = ema200 > ema200[10]
bool emaFalling = ema200 < ema200[10]
int bullTrendVotes = (close > ema200 ? 1 : 0) + (biasDir == 1 ? 1 : 0) + (zoneDir == 1 ? 1 : 0) + (recentBullBOS ? 1 : 0) + (emaRising ? 1 : 0)
int bearTrendVotes = (close < ema200 ? 1 : 0) + (biasDir == -1 ? 1 : 0) + (zoneDir == -1 ? 1 : 0) + (recentBearBOS ? 1 : 0) + (emaFalling ? 1 : 0)
int trendVotes = math.max(bullTrendVotes, bearTrendVotes)

bool isCompression = atrRatio < 0.75 and rangeWidth20 < atrBaseline * 6
bool isExpansion   = not isCompression and (atrRatio > 1.35 or atrVal > nz(atrVal[10], atrVal) * 1.3)

int marketRegime = isCompression ? REG_COMPRESS : isExpansion ? REG_EXPAND : trendVotes >= 5 ? REG_STRONG : trendVotes >= 4 ? REG_TREND : REG_RANGE
string regimeName = marketRegime == REG_COMPRESS ? "COMPRESSION" : marketRegime == REG_EXPAND ? "EXPANSION" : marketRegime == REG_STRONG ? "STRONG TREND" : marketRegime == REG_TREND ? "TRENDING" : "RANGING"
string volState = atrRatio > 1.4 ? "High Vol 🔥" : atrRatio < 0.7 ? "Low Vol 💤" : "Normal Vol"

// ---------- PHASE 3 • FITUR 37 : ADAPTIVE CONFIDENCE ENGINE ----------
// Bobot TIDAK fixed — mengikuti Market Regime. Urutan bobot (total selalu 100):
// [Trend, BOS, CHoCH, FreshZone, FreshOB, LiqSweep, OTE, FVG, EMA, PremDisc, Volume, Session, RSI, ATR]
// SCOPE-FIX + COMPILE-FIX: assignment berurutan dangkal — bobot per regime identik
f_weightProfile(int regimeId) =>
    array<int> w = array.from(4, 4, 8, 12, 10, 16, 14, 6, 4, 10, 4, 4, 2, 2)
    w := regimeId == REG_EXPAND ? array.from(10, 10, 6, 8, 8, 12, 6, 6, 6, 4, 6, 10, 2, 6) : w
    w := regimeId == REG_COMPRESS ? array.from(4, 6, 6, 16, 10, 16, 10, 8, 4, 8, 4, 4, 2, 2) : w
    w := regimeId == REG_TREND ? array.from(16, 10, 4, 10, 10, 10, 8, 6, 8, 4, 4, 4, 3, 3) : w
    w := regimeId == REG_STRONG ? array.from(18, 10, 4, 10, 8, 8, 8, 6, 10, 4, 4, 4, 3, 3) : w
    w

string confProfileName = marketRegime == REG_STRONG or marketRegime == REG_TREND ? "Trend-Following (Trend↑ Liq→ OTE→)" : marketRegime == REG_COMPRESS ? "Compression (Zone↑ Liq↑ Trend↓)" : marketRegime == REG_EXPAND ? "Breakout (ATR↑ Session↑ Liq→)" : "Range/Liquidity (Liq↑ OTE↑ Trend↓)"

f_confidenceAdaptive(bool isBuy) =>
    array<int> w = f_weightProfile(marketRegime)
    int cSc = 0
    cSc += (isBuy ? biasDir == 1 : biasDir == -1) ? w.get(0) : 0
    cSc += (isBuy ? recentBullBOS : recentBearBOS) ? w.get(1) : 0
    cSc += (isBuy ? recentBullChoch : recentBearChoch) ? w.get(2) : 0
    cSc += (isBuy ? inQualifiedDemand : inQualifiedSupply) ? w.get(3) : 0
    cSc += (isBuy ? hasFreshBullOB : hasFreshBearOB) ? w.get(4) : 0
    cSc += (isBuy ? sslSweptRecent : bslSweptRecent) ? w.get(5) : 0
    cSc += (isBuy ? inOTEBuy : inOTESell) ? w.get(6) : 0
    cSc += hasFVG ? w.get(7) : 0
    cSc += (isBuy ? close > ema200 : close < ema200) ? w.get(8) : 0
    cSc += (isBuy ? inDiscount : inPremium) ? w.get(9) : 0
    cSc += highVolume ? w.get(10) : 0
    cSc += sessionScore >= 6 ? w.get(11) : sessionScore >= 5 ? math.round(w.get(11) * 0.75) : sessionScore >= 3 ? math.round(w.get(11) * 0.5) : 0
    cSc += (isBuy ? matrixRsiVal <= rsiBuyMax : matrixRsiVal >= rsiSellMin) ? w.get(12) : 0
    cSc += atrOk and spreadOk ? w.get(13) : 0
    cSc

// ---------- FITUR 27 : ENTRY CONFIDENCE ENGINE (14 faktor berbobot, total = 100) ----------
f_confidence(bool isBuy) =>
    int cSc = 0
    cSc += (isBuy ? biasDir == 1 : biasDir == -1) ? 12 : 0                              // Trend HTF
    cSc += (isBuy ? recentBullBOS : recentBearBOS) ? 8 : 0                              // BOS
    cSc += (isBuy ? recentBullChoch : recentBearChoch) ? 6 : 0                          // CHOCH
    cSc += (isBuy ? inQualifiedDemand : inQualifiedSupply) ? 12 : 0                     // Fresh Zone
    cSc += (isBuy ? hasFreshBullOB : hasFreshBearOB) ? 10 : 0                           // Fresh Order Block
    cSc += (isBuy ? sslSweptRecent : bslSweptRecent) ? 12 : 0                           // Liquidity Sweep
    cSc += (isBuy ? inOTEBuy : inOTESell) ? 10 : 0                                      // OTE
    cSc += hasFVG ? 6 : 0                                                               // FVG
    cSc += (isBuy ? close > ema200 : close < ema200) ? 6 : 0                            // EMA
    cSc += (isBuy ? inDiscount : inPremium) ? 6 : 0                                     // Premium/Discount
    cSc += highVolume ? 4 : 0                                                           // Volume
    cSc += sessionScore >= 6 ? 4 : sessionScore >= 5 ? 3 : sessionScore >= 3 ? 2 : 0    // Session (Asia mengurangi skor)
    cSc += (isBuy ? matrixRsiVal <= rsiBuyMax : matrixRsiVal >= rsiSellMin) ? 2 : 0     // RSI
    cSc += atrOk and spreadOk ? 2 : 0                                                   // ATR/Spread
    cSc

// PHASE 3 (ADDITIVE — FITUR 37): pakai bobot adaptif saat AI Engine aktif; jika OFF kembali ke bobot statis Phase 2
int confBuy    = instEngineOn ? (aiEngineOn and adaptiveConfOn ? f_confidenceAdaptive(true)  : f_confidence(true))  : 0
int confSell   = instEngineOn ? (aiEngineOn and adaptiveConfOn ? f_confidenceAdaptive(false) : f_confidence(false)) : 0
int confActive = microTrend == "BEARISH 🔴" ? confSell : confBuy

f_confStars(int c) =>
    c >= 95 ? "★★★★★ SNIPER" : c >= 90 ? "★★★★☆" : c >= 80 ? "★★★★" : c >= 70 ? "★★★" : "✗ NO ENTRY"

// ---------- FITUR 22 : CONFLUENCE ENGINE (Fresh S&D × Fresh OB × OTE × FVG) ----------
bool priceInFreshBullOB = hasFreshBullOB and math.min(high, freshBullOBTop) - math.max(low, freshBullOBBot) > 0
bool priceInFreshBearOB = hasFreshBearOB and math.min(high, freshBearOBTop) - math.max(low, freshBearOBBot) > 0
int confluenceBuyCount  = (inQualifiedDemand ? 1 : 0) + (priceInFreshBullOB ? 1 : 0) + (inOTEBuy ? 1 : 0) + (hasFVG ? 1 : 0)
int confluenceSellCount = (inQualifiedSupply ? 1 : 0) + (priceInFreshBearOB ? 1 : 0) + (inOTESell ? 1 : 0) + (hasFVG ? 1 : 0)
bool highConfluenceNow  = instEngineOn and (confluenceBuyCount >= 3 or confluenceSellCount >= 3)
// Tanpa overlap, Confidence turun otomatis karena tiap komponen di atas punya bobot sendiri di FITUR 27.

var label confluenceLbl = na
if barstate.islast
    if not na(confluenceLbl)
        label.delete(confluenceLbl)
    if highConfluenceNow
        bool cbUp = confluenceBuyCount >= confluenceSellCount
        confluenceLbl := label.new(bar_index, cbUp ? low - atrVal * 1.2 : high + atrVal * 1.2, "⭐ HIGH CONFLUENCE (" + str.tostring(math.max(confluenceBuyCount, confluenceSellCount)) + "/4)", style = cbUp ? label.style_label_up : label.style_label_down, color = color.new(#8957E5, 15), textcolor = color.white, size = size.small)

// ---------- FITUR 19 / 21 / 24 / 26 / 27-28 : GERBANG ENTRY INSTITUSIONAL ----------
bool liqOkBuy   = not instEngineOn or not requireLiqSweep or sslSweptRecent
bool liqOkSell  = not instEngineOn or not requireLiqSweep or bslSweptRecent
bool oteOkBuy   = not instEngineOn or not requireOTE or inOTEBuy
bool oteOkSell  = not instEngineOn or not requireOTE or inOTESell
bool pdOkBuy    = not instEngineOn or not requirePremDisc or inDiscount
bool pdOkSell   = not instEngineOn or not requirePremDisc or inPremium
bool confOkBuy  = not instEngineOn or confBuy >= math.max(minConfidence, 70)
bool confOkSell = not instEngineOn or confSell >= math.max(minConfidence, 70)
bool instOkBuy  = liqOkBuy  and oteOkBuy  and pdOkBuy  and atrOk and spreadOk and confOkBuy
bool instOkSell = liqOkSell and oteOkSell and pdOkSell and atrOk and spreadOk and confOkSell

// ---------- FITUR 29 : SMART TP (target = liquidity terdekat; TP Final tetap ATR/R:R) ----------
f_nearestLiqTargets(bool above) =>
    float tpA = na
    float tpB = na
    if liqLevels.size() > 0
        for lv in liqLevels
            if not lv.swept
                if above and lv.bias == BEARISH and lv.price > close
                    if na(tpA) or lv.price < tpA
                        tpB := tpA
                        tpA := lv.price
                    else if na(tpB) or lv.price < tpB
                        tpB := lv.price
                if not above and lv.bias == BULLISH and lv.price < close
                    if na(tpA) or lv.price > tpA
                        tpB := tpA
                        tpA := lv.price
                    else if na(tpB) or lv.price > tpB
                        tpB := lv.price
    [tpA, tpB]

[liqBuyTP1, liqBuyTP2]   = f_nearestLiqTargets(true)
[liqSellTP1, liqSellTP2] = f_nearestLiqTargets(false)
float smartBuyTP1  = na(liqBuyTP1) ? buyTP1 : liqBuyTP1
float smartBuyTP2  = na(liqBuyTP2) ? buyTP2 : liqBuyTP2
float smartBuyTPF  = buyTP
float smartSellTP1 = na(liqSellTP1) ? sellTP1 : liqSellTP1
float smartSellTP2 = na(liqSellTP2) ? sellTP2 : liqSellTP2
float smartSellTPF = sellTP

// ---------- FITUR 30 : SMART STOP LOSS (prioritas: Order Block -> Supply/Demand -> ATR) ----------
float smartBuySL = buySL
string smartBuySLSrc = "ATR/Struktur"
float smartSellSL = sellSL
string smartSellSLSrc = "ATR/Struktur"
if instEngineOn
    float slBuf = structBufPrice + spreadInPrice
    if hasFreshBullOB and (freshBullOBBot - slBuf) < close
        smartBuySL := freshBullOBBot - slBuf
        smartBuySLSrc := "Order Block"
    else
        float dzBottom = na
        if sdZones.size() > 0
            for z in sdZones
                if z.bias == BULLISH and not z.broken and z.bottom < close and (na(dzBottom) or z.bottom > dzBottom)
                    dzBottom := z.bottom
        if not na(dzBottom)
            smartBuySL := dzBottom - slBuf
            smartBuySLSrc := "Supply/Demand"
    if hasFreshBearOB and (freshBearOBTop + slBuf) > close
        smartSellSL := freshBearOBTop + slBuf
        smartSellSLSrc := "Order Block"
    else
        float szTop = na
        if sdZones.size() > 0
            for z in sdZones
                if z.bias == BEARISH and not z.broken and z.top > close and (na(szTop) or z.top < szTop)
                    szTop := z.top
        if not na(szTop)
            smartSellSL := szTop + slBuf
            smartSellSLSrc := "Supply/Demand"

// =====================================================================================================================
// 🌟 BAGIAN 9.48: ADAPTIVE AI ENGINE — ENTRY QUALITY, GRADE, RISIKO & TP DINAMIS (PHASE 3) — BARU (ADDITIVE)
// =====================================================================================================================

// ---------- FITUR 38 : ENTRY QUALITY ENGINE (filter kualitas candle entry) ----------
float eqCandleRange = high - low
float eqBodySize    = math.abs(close - open)
float eqUpperWick   = high - math.max(close, open)
float eqLowerWick   = math.min(close, open) - low
float eqBodyPct     = eqCandleRange > 0 ? eqBodySize / eqCandleRange : 0.0

// SCOPE-FIX + COMPILE-FIX: assignment berurutan dangkal (dibalik: baris terakhir = prioritas tertinggi) — hasil identik
f_entryQuality(bool isBuy) =>
    string reasonQ = "OK ✓"
    reasonQ := not isBuy and eqCandleRange > 0 and eqLowerWick / eqCandleRange > 0.45 ? "Large Lower Wick" : reasonQ
    reasonQ := isBuy and eqCandleRange > 0 and eqUpperWick / eqCandleRange > 0.45 ? "Large Upper Wick" : reasonQ
    reasonQ := eqBodyPct < 0.30 or eqBodySize < atrVal * 0.15 ? "Weak Momentum" : reasonQ
    reasonQ := volume < vol_sma * 0.8 ? "Low Volume" : reasonQ
    reasonQ := not spreadOk ? "Spread Mahal" : reasonQ
    reasonQ := not atrOk ? "Low ATR" : reasonQ
    reasonQ := not (instEngineOn and aiEngineOn and entryQualityOn) ? "OK ✓" : reasonQ
    [reasonQ == "OK ✓", reasonQ]

[eqOkBuy, eqReasonBuy]   = f_entryQuality(true)
[eqOkSell, eqReasonSell] = f_entryQuality(false)

// ---------- FITUR 39 : INSTITUTIONAL GRADE (A+ 95+ / A 90-94 / B+ 85-89 / B 80-84 / C 70-79 / D <70) ----------
f_grade(int c) =>
    c >= 95 ? "A+" : c >= 90 ? "A" : c >= 85 ? "B+" : c >= 80 ? "B" : c >= 70 ? "C" : "D"

string gradeActive = f_grade(confActive)

// ---------- FITUR 40 : DYNAMIC RISK ENGINE (hanya REKOMENDASI — Auto Lot lama TIDAK diubah) ----------
float dynRiskMult  = confActive >= 90 ? 1.25 : confActive >= 80 ? 1.0 : 0.75
float dynSLDistRec = confActive >= 90 ? atrVal * 1.0 : confActive >= 80 ? atrVal * 1.2 : atrVal * 1.5
float dynLotRec    = na(recommendedLot) ? na : recommendedLot * dynRiskMult

// ---------- FITUR 42 : DYNAMIC TP ENGINE (prioritas: Liquidity -> Fib Extension -> ATR Projection -> RR) ----------
f_farthestLiq(bool above) =>
    float farLq = na
    if liqLevels.size() > 0
        for lv in liqLevels
            if not lv.swept
                if above and lv.bias == BEARISH and lv.price > close and (na(farLq) or lv.price > farLq)
                    farLq := lv.price
                if not above and lv.bias == BULLISH and lv.price < close and (na(farLq) or lv.price < farLq)
                    farLq := lv.price
    farLq

float fibExtBuy   = (not na(lastPH) and not na(lastPL)) ? lastPH + (lastPH - lastPL) * 0.272 : na
float fibExtSell  = (not na(lastPH) and not na(lastPL)) ? lastPL - (lastPH - lastPL) * 0.272 : na
float atrProjBuy  = close + atrVal * 2.0
float atrProjSell = close - atrVal * 2.0

float dynFarBuyLiq  = f_farthestLiq(true)
float dynFarSellLiq = f_farthestLiq(false)

float  dynBuyTPF    = not na(dynFarBuyLiq) and dynFarBuyLiq > smartBuyTP1 ? dynFarBuyLiq : not na(fibExtBuy) and fibExtBuy > close ? fibExtBuy : atrProjBuy > close ? atrProjBuy : buyTP
string dynBuyTPSrc  = not na(dynFarBuyLiq) and dynFarBuyLiq > smartBuyTP1 ? "Liquidity" : not na(fibExtBuy) and fibExtBuy > close ? "Fib Extension" : atrProjBuy > close ? "ATR Projection" : "RR Engine"
float  dynSellTPF   = not na(dynFarSellLiq) and dynFarSellLiq < smartSellTP1 ? dynFarSellLiq : not na(fibExtSell) and fibExtSell < close ? fibExtSell : atrProjSell < close ? atrProjSell : sellTP
string dynSellTPSrc = not na(dynFarSellLiq) and dynFarSellLiq < smartSellTP1 ? "Liquidity" : not na(fibExtSell) and fibExtSell < close ? "Fib Extension" : atrProjSell < close ? "ATR Projection" : "RR Engine"
string dynTP12Src   = (not na(liqBuyTP1) or not na(liqSellTP1)) ? "Liquidity" : "RR Engine"

// ---------- FITUR 43 : ORDER FLOW BIAS (Institutional Bias dari 8 komponen) ----------
int biasVotes = 0
biasVotes += biasDir
biasVotes += (sslSweptRecent ? 1 : 0) - (bslSweptRecent ? 1 : 0)
biasVotes += (recentBullBOS ? 1 : 0) - (recentBearBOS ? 1 : 0)
biasVotes += (recentBullChoch ? 1 : 0) - (recentBearChoch ? 1 : 0)
biasVotes += (inDiscount ? 1 : 0) - (inPremium ? 1 : 0)
biasVotes += (inQualifiedDemand ? 1 : 0) - (inQualifiedSupply ? 1 : 0)
biasVotes += (hasFreshBullOB ? 1 : 0) - (hasFreshBearOB ? 1 : 0)
biasVotes += confBuy > confSell ? 1 : confSell > confBuy ? -1 : 0
string orderFlowBias = biasVotes >= 3 ? "BULLISH 🟢" : biasVotes <= -3 ? "BEARISH 🔴" : "NEUTRAL ⚪"
int biasStrengthPct = math.round(math.min(math.abs(biasVotes) / 8.0, 1.0) * 100)

// =====================================================================================================================
// 🌟 BAGIAN 9.5: FILTER SNIPER (ORDER BLOCK + ANTI-REPAINT) & EKSEKUSI SINYAL
// =====================================================================================================================
// Cek apakah harga candle saat ini berada DI DALAM Order Block internal yang searah & masih aktif.
f_priceInsideOB(int biasWanted) =>
    bool inside = false
    if internalOrderBlocks.size() > 0
        for eachOB in internalOrderBlocks
            if eachOB.bias == biasWanted and low <= eachOB.barHigh and high >= eachOB.barLow
                inside := true
                break
    inside

bool inBullishOB = f_priceInsideOB(BULLISH)
bool inBearishOB = f_priceInsideOB(BEARISH)

bool obOkBuy   = not requireOBEntry or inBullishOB
bool obOkSell  = not requireOBEntry or inBearishOB
bool confirmOK = not useConfirmedClose or barstate.isconfirmed

// =====================================================================================================================
// 🌟 BAGIAN 9.49 (PHASE 3.5): DECISION CORE ENGINE — SATU-SATUNYA SUMBER KEPUTUSAN — BARU (ADDITIVE)
// =====================================================================================================================
// FITUR 50/51/57 — semua engine di atas hanya PENYEDIA DATA. Keputusan mengikuti hierarki baku tanpa shortcut:
// HTF Bias → Market Regime → Fresh S&D → (Conflict Validator) → Liquidity Sweep → OTE → Order Block → FVG →
// Premium/Discount → Entry Quality → Confidence → Decision Core → BUY / SELL / WAIT.

// Langkah 2 (Market Regime): di regime trending, arah entry wajib searah regime; RANGING/COMPRESSION bebas arah.
bool regimeOkBuy  = marketRegime == REG_RANGE or marketRegime == REG_COMPRESS or bullTrendVotes >= bearTrendVotes
bool regimeOkSell = marketRegime == REG_RANGE or marketRegime == REG_COMPRESS or bearTrendVotes >= bullTrendVotes

// FITUR 51/56/57 — evaluasi hierarki: kembalikan [lolos, alasan gagal PERTAMA, next action]
// SCOPE-FIX: rantai if/else-if diganti flag + ternary berurutan — urutan first-fail & seluruh teks identik
f_decisionEval(bool isBuy) =>
    bool fBias = isBuy ? biasDir != 1 : biasDir != -1                                   // 1. HTF Bias
    bool fReg  = not (isBuy ? regimeOkBuy : regimeOkSell)                               // 2. Market Regime
    bool fZone = not (isBuy ? zoneOkBuy : zoneOkSell)                                   // 3. Fresh Supply/Demand
    bool fKonf = dcConflictOn and (isBuy ? inQualifiedSupply : inQualifiedDemand)       // 3b. Conflict Validator
    bool fLiq  = not (isBuy ? liqOkBuy : liqOkSell)                                     // 4. Liquidity Sweep
    bool fOTE  = not (isBuy ? oteOkBuy : oteOkSell)                                     // 5. OTE
    bool fOB   = not (isBuy ? obOkBuy : obOkSell)                                       // 6. Order Block
    bool fFVG  = not hasFVG                                                             // 7. FVG
    bool fPD   = not (isBuy ? pdOkBuy : pdOkSell)                                       // 8. Premium/Discount
    bool fEQ   = not (isBuy ? eqOkBuy : eqOkSell)                                       // 9. Entry Quality
    bool fCf   = not (isBuy ? confOkBuy : confOkSell)                                   // 10. Confidence
    bool okD = not (fBias or fReg or fZone or fKonf or fLiq or fOTE or fOB or fFVG or fPD or fEQ or fCf)
    // COMPILE-FIX: assignment berurutan dangkal, dibalik (baris terakhir = prioritas tertinggi) — first-fail identik
    string failR = ""
    failR := fCf ? "Confidence Too Low (" + str.tostring(isBuy ? confBuy : confSell) + "%)" : failR
    failR := fEQ ? "Entry Quality: " + (isBuy ? eqReasonBuy : eqReasonSell) : failR
    failR := fPD ? (isBuy ? "Bukan zona Discount" : "Bukan zona Premium") : failR
    failR := fFVG ? "No FVG/Imbalance" : failR
    failR := fOB ? "Outside Order Block" : failR
    failR := fOTE ? "Outside OTE" : failR
    failR := fLiq ? "No Liquidity Sweep" : failR
    failR := fKonf ? (isBuy ? "Inside Supply (konflik)" : "Inside Demand (konflik)") : failR
    failR := fZone ? (isBuy ? "Belum di Fresh Demand" : "Belum di Fresh Supply") : failR
    failR := fReg ? "Regime melawan arah (" + regimeName + ")" : failR
    failR := fBias ? (isBuy ? "HTF Bias belum Bullish" : "HTF Bias belum Bearish") : failR
    string nextA = ""
    nextA := fCf ? "Wait Confluence Bertambah" : nextA
    nextA := fEQ ? "Wait Candle Konfirmasi Berkualitas" : nextA
    nextA := fPD ? (isBuy ? "Wait Harga Masuk Discount" : "Wait Harga Masuk Premium") : nextA
    nextA := fFVG ? "Wait Imbalance Terbentuk" : nextA
    nextA := fOB ? "Wait Order Block Retest" : nextA
    nextA := fOTE ? "Wait OTE Retracement (0.618–0.786)" : nextA
    nextA := fLiq ? (isBuy ? "Wait Liquidity Sweep (SSL)" : "Wait Liquidity Sweep (BSL)") : nextA
    nextA := fKonf ? (isBuy ? "Wait Supply Break / jauhi Supply" : "Wait Demand Break / jauhi Demand") : nextA
    nextA := fZone ? (isBuy ? "Wait Demand Retest" : "Wait Supply Retest") : nextA
    nextA := fReg ? "Wait Regime Selaras / CHoCH" : nextA
    nextA := fBias ? "Wait BOS Confirmation (HTF)" : nextA
    [okD, failR, nextA]

[dcBuyAllowed, dcBuyFailReason, dcBuyNextAction]    = f_decisionEval(true)
[dcSellAllowed, dcSellFailReason, dcSellNextAction] = f_decisionEval(false)

bool dcOkBuy  = not dcEngineOn or dcBuyAllowed
bool dcOkSell = not dcEngineOn or dcSellAllowed

// FITUR 52 — semua konflik TERCATAT (counter + teks konflik terakhir)
bool conflictActiveNow = dcEngineOn and dcConflictOn and ((biasDir == 1 and inQualifiedSupply) or (biasDir == -1 and inQualifiedDemand))
var int conflictCount = 0
var string lastConflictText = "None"
if barstate.isconfirmed and conflictActiveNow and not conflictActiveNow[1]
    conflictCount += 1
    lastConflictText := biasDir == 1 ? "Trend=Bullish vs Supply=Active → WAIT" : "Trend=Bearish vs Demand=Active → WAIT"

// =====================================================================================================================
// 🌟 BAGIAN 9.10 (PHASE 4): EXECUTION ENGINE — LAPISAN EKSEKUSI FINAL — BARU (ADDITIVE)
// =====================================================================================================================
// Saat execEngineOn = OFF, semua gerbang di bawah bernilai TRUE → hasil 100% identik dengan versi sebelumnya.

// ---------- FITUR 63 : TRIGGER ENGINE (candle konfirmasi — sentuh zona saja TIDAK cukup) ----------
float excRange  = high - low
float excBody   = math.abs(close - open)
float excUpWick = high - math.max(close, open)
float excLoWick = math.min(close, open) - low
float excBodyPc = excRange > 0 ? excBody / excRange : 0.0

bool bullEngulf   = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and excBody > math.abs(close[1] - open[1])
bool bearEngulf   = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and excBody > math.abs(close[1] - open[1])
bool bullMarubozu = close > open and excBodyPc >= 0.7 and excBody >= atrVal * 0.6
bool bearMarubozu = close < open and excBodyPc >= 0.7 and excBody >= atrVal * 0.6
bool bullPin      = excRange > 0 and excLoWick / excRange >= 0.6 and excBodyPc <= 0.35
bool bearPin      = excRange > 0 and excUpWick / excRange >= 0.6 and excBodyPc <= 0.35
bool shootingStar = bearPin and close < open
bool morningStar  = close > open and close[2] < open[2] and math.abs(close[1] - open[1]) < math.abs(close[2] - open[2]) * 0.5 and close > math.avg(open[2], close[2])
bool eveningStar  = close < open and close[2] > open[2] and math.abs(close[1] - open[1]) < math.abs(close[2] - open[2]) * 0.5 and close < math.avg(open[2], close[2])
bool momentumBreakUp = close > open and excBody >= atrVal and close > high[1]
bool momentumBreakDn = close < open and excBody >= atrVal and close < low[1]

// ---------- FITUR 67 : FAKE BREAK FILTER (break wajib CLOSE + momentum, bukan wick; retest dilacak) ----------
bool breakMomentumUp = close > open and excBodyPc >= 0.4
bool breakMomentumDn = close < open and excBodyPc >= 0.4
bool microBOSUpOk    = (currentAlerts.internalBullishBOS or currentAlerts.internalBullishCHoCH) and (not useFakeBreakFilter or breakMomentumUp)
bool microBOSDnOk    = (currentAlerts.internalBearishBOS or currentAlerts.internalBearishCHoCH) and (not useFakeBreakFilter or breakMomentumDn)
bool wickFakeUp      = not na(lastPH) and high > lastPH and close <= lastPH
bool wickFakeDn      = not na(lastPL) and low < lastPL and close >= lastPL
string fakeBreakStatus = wickFakeUp ? "⚠ Fake Break Atas (wick)" : wickFakeDn ? "⚠ Fake Break Bawah (wick)" : "✓ Tidak ada"

var float pendingRetestLevel = na
var int   pendingRetestDir   = 0
if execEngineOn and barstate.isconfirmed
    if microBOSUpOk
        pendingRetestLevel := internalHigh.currentLevel
        pendingRetestDir   := 1
    if microBOSDnOk
        pendingRetestLevel := internalLow.currentLevel
        pendingRetestDir   := -1
bool retestDoneBuy  = pendingRetestDir == 1 and not na(pendingRetestLevel) and low <= pendingRetestLevel + atrVal * 0.25
bool retestDoneSell = pendingRetestDir == -1 and not na(pendingRetestLevel) and high >= pendingRetestLevel - atrVal * 0.25

bool triggerBuy  = bullEngulf or bullMarubozu or bullPin or morningStar or microBOSUpOk or momentumBreakUp
bool triggerSell = bearEngulf or bearMarubozu or bearPin or shootingStar or eveningStar or microBOSDnOk or momentumBreakDn

// COMPILE-FIX: assignment berurutan dangkal (dibalik) — prioritas nama trigger identik
f_triggerName(bool isBuy) =>
    string tN = "—"
    tN := isBuy and momentumBreakUp ? "Momentum Break" : tN
    tN := isBuy and microBOSUpOk ? "Micro BOS/CHoCH" : tN
    tN := isBuy and morningStar ? "Morning Star" : tN
    tN := isBuy and bullPin ? "Bullish Pin Bar" : tN
    tN := isBuy and bullMarubozu ? "Bullish Marubozu" : tN
    tN := isBuy and bullEngulf ? "Bullish Engulfing" : tN
    tN := not isBuy and momentumBreakDn ? "Momentum Break" : tN
    tN := not isBuy and microBOSDnOk ? "Micro BOS/CHoCH" : tN
    tN := not isBuy and eveningStar ? "Evening Star" : tN
    tN := not isBuy and bearPin ? "Bearish Pin Bar" : tN
    tN := not isBuy and shootingStar ? "Shooting Star" : tN
    tN := not isBuy and bearMarubozu ? "Bearish Marubozu" : tN
    tN := not isBuy and bearEngulf ? "Bearish Engulfing" : tN
    tN

// ---------- FITUR 66 : PULLBACK ENGINE (jangan beli setelah harga lari terlalu jauh) ----------
float emaFastExec = ta.ema(close, pullbackEmaFast)
float emaSlowExec = ta.ema(close, pullbackEmaSlow)
bool pullbackBuy  = low <= emaFastExec or low <= emaSlowExec or inQualifiedDemand
bool pullbackSell = high >= emaFastExec or high >= emaSlowExec or inQualifiedSupply

// ---------- FITUR 68 : ENTRY PROBABILITY (13 komponen, total = 100 — terpisah dari Confidence) ----------
f_entryProbability(bool isBuy) =>
    int pP = 0
    pP += (isBuy ? biasDir == 1 : biasDir == -1) ? 10 : 0
    pP += (isBuy ? sslSweptRecent : bslSweptRecent) ? 10 : 0
    pP += (isBuy ? inQualifiedDemand : inQualifiedSupply) ? 12 : 0
    pP += (isBuy ? inOTEBuy : inOTESell) ? 8 : 0
    pP += (isBuy ? inBullishOB : inBearishOB) ? 8 : 0
    pP += hasFVG ? 6 : 0
    pP += highVolume ? 6 : 0
    pP += sessionScore >= 5 ? 6 : sessionScore >= 3 ? 3 : 0
    pP += (isBuy ? close > ema200 : close < ema200) ? 6 : 0
    pP += atrOk ? 4 : 0
    pP += spreadOk ? 4 : 0
    pP += (isBuy ? regimeOkBuy : regimeOkSell) ? 8 : 0
    pP += (isBuy ? dcBuyAllowed : dcSellAllowed) ? 12 : 0
    pP

int probBuy  = execEngineOn ? f_entryProbability(true) : 0
int probSell = execEngineOn ? f_entryProbability(false) : 0

f_probStars(int p) => p >= 90 ? "★★★★★" : p >= 80 ? "★★★★" : p >= 70 ? "★★★" : p >= 60 ? "★★" : "★"

// ---------- FITUR 70 : ENTRY RATING ----------
f_entryRating(int p, int c) =>
    int mR = math.min(p, c)
    mR >= 95 ? "A+ • Institutional Setup" : mR >= 90 ? "A • High Probability" : mR >= 80 ? "B • Good Scalping" : mR >= 70 ? "C • Aggressive" : "D • Skip"

// ---------- FITUR 64 : ENTRY PROGRESS (checklist 7 syarat) ----------
int progressBuy  = (biasDir == 1 ? 1 : 0) + (inQualifiedDemand ? 1 : 0) + (sslSweptRecent ? 1 : 0) + (inOTEBuy ? 1 : 0) + (triggerBuy ? 1 : 0) + (pullbackBuy ? 1 : 0) + (highVolume ? 1 : 0)
int progressSell = (biasDir == -1 ? 1 : 0) + (inQualifiedSupply ? 1 : 0) + (bslSweptRecent ? 1 : 0) + (inOTESell ? 1 : 0) + (triggerSell ? 1 : 0) + (pullbackSell ? 1 : 0) + (highVolume ? 1 : 0)

// FITUR 71 — ENTRY COUNTDOWN: daftar syarat yang MASIH KURANG (bukan sekadar WAIT)
f_execMissing(bool isBuy) =>
    string mM = ""
    mM += (isBuy ? biasDir == 1 : biasDir == -1) ? "" : "Trend • "
    mM += (isBuy ? inQualifiedDemand : inQualifiedSupply) ? "" : "Retest Zona • "
    mM += (isBuy ? sslSweptRecent : bslSweptRecent) ? "" : "Likuiditas • "
    mM += (isBuy ? inOTEBuy : inOTESell) ? "" : "OTE • "
    mM += (isBuy ? triggerBuy : triggerSell) ? "" : "Trigger Candle • "
    mM += (isBuy ? pullbackBuy : pullbackSell) ? "" : "Pullback EMA • "
    mM += highVolume ? "" : "Volume/Momentum • "
    mM == "" ? "✅ Semua syarat lengkap" : mM

// ---------- FITUR 73 : SMART RETRY (setelah SL, jangan langsung balik arah) ----------
var int lastLossBar = na
var int lastLossDir = 0
if barstate.isconfirmed and lossTrades > nz(lossTrades[1])
    lastLossBar := bar_index
    lastLossDir := nz(activePos[1])
bool retryBlockSell = execEngineOn and smartRetryOn and lastLossDir == 1  and not na(lastLossBar) and (bar_index - lastLossBar) <= retryBars
bool retryBlockBuy  = execEngineOn and smartRetryOn and lastLossDir == -1 and not na(lastLossBar) and (bar_index - lastLossBar) <= retryBars
string retryMsg = retryBlockSell ? "BUY FAILED — Tunggu Retest Baru (anti balik arah)" : retryBlockBuy ? "SELL FAILED — Tunggu Retest Baru (anti balik arah)" : "✓ Normal"

// ---------- FITUR 74 : EARLY EXIT ENGINE (saran keluar dini saat posisi berjalan) ----------
// SCOPE-FIX: if bersarang diganti ternary datar (1 scope) — kondisi & pesan identik
var string earlyExitMsg = "—"
string exitWhyL = currentAlerts.internalBearishCHoCH or currentAlerts.swingBearishCHoCH ? "CHoCH berlawanan" : currentAlerts.swingBearishBOS ? "BOS berlawanan" : demandBrokenAlert ? "Zona Demand pecah" : confBuy < 50 ? "Keyakinan runtuh" : close < emaSlowExec and close < open ? "Momentum hilang" : ""
string exitWhyS = currentAlerts.internalBullishCHoCH or currentAlerts.swingBullishCHoCH ? "CHoCH berlawanan" : currentAlerts.swingBullishBOS ? "BOS berlawanan" : supplyBrokenAlert ? "Zona Supply pecah" : confSell < 50 ? "Keyakinan runtuh" : close > emaSlowExec and close > open ? "Momentum hilang" : ""
string exitWhyNow = activePos == 1 ? exitWhyL : activePos == -1 ? exitWhyS : ""
bool earlyExitNow = execEngineOn and earlyExitOn and barstate.isconfirmed and activePos != 0 and exitWhyNow != ""
if execEngineOn and barstate.isconfirmed
    earlyExitMsg := activePos == 0 ? "—" : earlyExitNow ? "⚠ EXIT EARLY (" + (activePos == 1 ? "LONG" : "SHORT") + ") — " + exitWhyNow : earlyExitMsg

// ---------- GERBANG EKSEKUSI FINAL (semua TRUE saat execEngineOn = OFF) ----------
bool trigOkBuy   = not execEngineOn or not requireTrigger or triggerBuy
bool trigOkSell  = not execEngineOn or not requireTrigger or triggerSell
bool pbOkBuy     = not execEngineOn or not requirePullback or pullbackBuy
bool pbOkSell    = not execEngineOn or not requirePullback or pullbackSell
bool probOkBuy   = not execEngineOn or minProbability <= 0 or probBuy >= minProbability
bool probOkSell  = not execEngineOn or minProbability <= 0 or probSell >= minProbability
bool execOkBuy   = trigOkBuy  and pbOkBuy  and probOkBuy  and not retryBlockBuy
bool execOkSell  = trigOkSell and pbOkSell and probOkSell and not retryBlockSell

// =====================================================================================================================
// 🌟 BAGIAN 9.13 (OPTIMIZATION UPDATE): CORE SCORE ENGINE + TRADING MODE + AUTO OPTIMIZER
// =====================================================================================================================
// PART 1/2 — SATU sumber kebenaran skor: 5 faktor berbobot (Trend 30, Liquidity 25, BOS/CHoCH 20, FVG 15, OTE 10).
// Prioritas: 1 Trend → 2 Structure → 3 Liquidity → 4 Presisi Entry. Filter minor (volume, RSI, sesi, P/D, EQ, dsb.)
// TIDAK ADA di gerbang pipeline SIMPLE — mustahil memveto saat Trend + Structure + Liquidity selaras.
// Semua faktor membaca series yang SUDAH dihitung engine lama — nol kalkulasi ATR/EMA/FVG/BOS baru (PART 7/10/11).

// Statistik rolling per-faktor (di-update di BAGIAN 12) — bahan Auto Optimizer (PART 9, tanpa ML)
var int statFvgW = 0
var int statFvgL = 0
var int statOteW = 0
var int statOteL = 0
var int statObW  = 0
var int statObL  = 0
var int statVolW = 0
var int statVolL = 0

f_factorWR(int wF, int lF) => wF + lF >= optMinTrades ? 100.0 * wF / (wF + lF) : -1.0

float overallWR = totalTrades > 0 ? 100.0 * winTrades / totalTrades : 0.0
float fvgWRStat = f_factorWR(statFvgW, statFvgL)
float oteWRStat = f_factorWR(statOteW, statOteL)
// PART 9 — Optimizer: faktor minor yang terbukti merugikan (WR ≤ total −10) bobot 0; menguntungkan (≥ +10) bobot ×1.25.
float fvgMult = not autoOptimizerOn or fvgWRStat < 0 ? 1.0 : fvgWRStat >= overallWR + 10 ? 1.25 : fvgWRStat <= overallWR - 10 ? 0.0 : 1.0
float oteMult = not autoOptimizerOn or oteWRStat < 0 ? 1.0 : oteWRStat >= overallWR + 10 ? 1.25 : oteWRStat <= overallWR - 10 ? 0.0 : 1.0
float coreMaxRaw = 30.0 + 25.0 + 20.0 + 15.0 * fvgMult + 10.0 * oteMult

f_coreScore(bool isBuy) =>
    float sRaw = ((isBuy ? biasDir == 1 : biasDir == -1) ? 30.0 : 0.0) + ((isBuy ? sslSweptRecent : bslSweptRecent) ? 25.0 : 0.0) + ((isBuy ? recentBullBOS or recentBullChoch : recentBearBOS or recentBearChoch) ? 20.0 : 0.0) + (hasFVG ? 15.0 * fvgMult : 0.0) + ((isBuy ? inOTEBuy : inOTESell) ? 10.0 * oteMult : 0.0)
    math.round(sRaw * 100.0 / math.max(coreMaxRaw, 1.0))

int coreConfBuy  = f_coreScore(true)
int coreConfSell = f_coreScore(false)
f_coreBand(int cB) => cB >= 85 ? "HIGH QUALITY" : cB >= 70 ? "VALID" : cB >= 50 ? "WAIT" : "NO TRADE"

// PART 2 — mayor wajib (prioritas 1-3) + PART 3 — presisi entry per Trading Mode (prioritas 4)
bool majorsBuy  = biasDir == 1  and (recentBullBOS or recentBullChoch) and sslSweptRecent
bool majorsSell = biasDir == -1 and (recentBearBOS or recentBearChoch) and bslSweptRecent
bool precBuy  = tradeModeInput == "SCALPING" ? triggerBuy and atrOk : tradeModeInput == "SWING" ? triggerBuy and marketRegime != REG_RANGE and highVolume : triggerBuy and (inQualifiedDemand or inBullishOB or inOTEBuy or hasFVG)
bool precSell = tradeModeInput == "SCALPING" ? triggerSell and atrOk : tradeModeInput == "SWING" ? triggerSell and marketRegime != REG_RANGE and highVolume : triggerSell and (inQualifiedSupply or inBearishOB or inOTESell or hasFVG)

bool coreBuyReady  = useSimplePipeline and majorsBuy  and precBuy  and coreConfBuy  >= coreMinScore and confirmOK
bool coreSellReady = useSimplePipeline and majorsSell and precSell and coreConfSell >= coreMinScore and confirmOK

// Sinyal final eksekusi = sinyal mentah + filter Order Block + anti-repaint + Fresh Zone Engine (BAGIAN 9.4)
//                         + Institutional Sniper Engine Phase 2 (BAGIAN 9.45: liquidity sweep, OTE, P/D, ATR/spread, confidence)
//                         + Entry Quality Engine Phase 3 (BAGIAN 9.48: kualitas candle entry)
//                         + DECISION CORE Phase 3.5 (BAGIAN 9.49): hakim akhir — WAIT mengunci semua sinyal & alert BUY/SELL
//                         + EXECUTION ENGINE Phase 4 (BAGIAN 9.10): trigger candle + pullback + probability + smart retry
bool buySetupLegacy  = buySetupRaw  and obOkBuy  and confirmOK and zoneOkBuy  and instOkBuy  and eqOkBuy  and dcOkBuy  and execOkBuy
bool sellSetupLegacy = sellSetupRaw and obOkSell and confirmOK and zoneOkSell and instOkSell and eqOkSell and dcOkSell and execOkSell
// OPTIMIZATION UPDATE — selektor pipeline: SIMPLE = Core Score Engine (BAGIAN 9.13, latensi rendah);
// LEGACY = rantai filter di atas, 100% IDENTIK dengan versi sebelumnya.
bool buySetup  = useSimplePipeline ? coreBuyReady  : buySetupLegacy
bool sellSetup = useSimplePipeline ? coreSellReady : sellSetupLegacy

// === TRIGGER KE WR ENGINE (target sesuai wrTargetMode: TP1/TP2/TP Final) ===
if buySetup and activePos == 0
    activePos := 1
    activeSL  := buySL
    activeTP  := buyWinTarget
if sellSetup and activePos == 0
    activePos := -1
    activeSL  := sellSL
    activeTP  := sellWinTarget

// === PLOT LABEL BUY/SELL = SINYAL EKSEKUSI RESMI ===
plotshape(buySetup, title="Sinyal BUY", text="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)
plotshape(sellSetup, title="Sinyal SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.normal)

alertcondition(buySetup,  title="SCALP BUY Signal",  message="🎯 Scalping Matrix: SCALP BUY terkonfirmasi! Cek lot & SL/TP.")
alertcondition(sellSetup, title="SELL / TP Signal", message="🎯 Scalping Matrix: Sinyal SELL / TAKE PROFIT terkonfirmasi! Cek lot & SL/TP.")

bool buyGetReady  = microTrend == "BULLISH 🟢" and isAboveEMA and not na(eqPrice) and close < eqPrice and close > lastPL and score >= (minScore - 1) and sessionOK and not buySetup
bool sellGetReady = microTrend == "BEARISH 🔴" and not isAboveEMA and not na(eqPrice) and close > eqPrice and close < lastPH and score >= (minScore - 1) and sessionOK and not sellSetup

alertcondition(buyGetReady,  title="SIAP-SIAP BUY",  message="🔔 Scalping Matrix: Siap-siap BUY, hampir matang!")
alertcondition(sellGetReady, title="SIAP-SIAP SELL/TP", message="🔔 Scalping Matrix: Siap-siap SELL / TAKE PROFIT, hampir matang!")

alertcondition(currentAlerts.internalBullishBOS,        'Struktur Internal Tembus Naik',          'Tembus Struktur Naik Terbentuk')
alertcondition(currentAlerts.internalBullishCHoCH,      'Arah Internal Ganti Naik',               'Ganti Arah Naik Terbentuk')
alertcondition(currentAlerts.internalBearishBOS,        'Struktur Internal Tembus Turun',         'Tembus Struktur Turun Terbentuk')
alertcondition(currentAlerts.internalBearishCHoCH,      'Arah Internal Ganti Turun',              'Ganti Arah Turun Terbentuk')
alertcondition(currentAlerts.swingBullishBOS,           'Struktur Utama Tembus Naik',             'Tembus Struktur Naik Terbentuk')
alertcondition(currentAlerts.swingBullishCHoCH,         'Arah Utama Ganti Naik',                  'Ganti Arah Naik Terbentuk')
alertcondition(currentAlerts.swingBearishBOS,           'Struktur Utama Tembus Turun',            'Tembus Struktur Turun Terbentuk')
alertcondition(currentAlerts.swingBearishCHoCH,         'Arah Utama Ganti Turun',                 'Ganti Arah Turun Terbentuk')
alertcondition(currentAlerts.internalBullishOrderBlock, 'Tembus OB Internal Naik',                'Harga menembus OB internal naik')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Tembus OB Internal Turun',               'Harga menembus OB internal turun')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Tembus OB Utama Naik',                   'Harga menembus OB utama naik')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Tembus OB Utama Turun',                  'Harga menembus OB utama turun')
alertcondition(currentAlerts.equalHighs,                'Puncak Kembar',                          'Puncak Kembar Terdeteksi')
alertcondition(currentAlerts.equalLows,                 'Lembah Kembar',                          'Lembah Kembar Terdeteksi')
alertcondition(currentAlerts.bullishFairValueGap,       'FVG Naik',                               'FVG Naik Terbentuk')
alertcondition(currentAlerts.bearishFairValueGap,       'FVG Turun',                              'FVG Turun Terbentuk')

// =====================================================================================================================
// 🌟 BAGIAN 9.6: DASHBOARD ZONA S&D DINAMIS + ALERT ZONE ENGINE — BARU (ADDITIVE)
// =====================================================================================================================
// TOKEN-FIX (CE10117): dashboard zona dihapus — status zona sudah tampil di box zona (Zone Status Engine) & panel 🚀.

// FITUR 15 — ALERT ZONE ENGINE
bool freshEntryReady = (buySetup and inQualifiedDemand) or (sellSetup and inQualifiedSupply)

alertcondition(freshDemandCreatedAlert, title='Fresh Demand Created', message='🟩 Zone Engine: Fresh DEMAND baru terbentuk — pantau retest untuk BUY.')
alertcondition(freshSupplyCreatedAlert, title='Fresh Supply Created', message='🟥 Zone Engine: Fresh SUPPLY baru terbentuk — pantau retest untuk SELL.')
alertcondition(demandBrokenAlert,       title='Demand Broken',        message='⚫ Zone Engine: DEMAND ditembus close penuh (Bearish BOS) — zona dihapus, cari zona baru.')
alertcondition(supplyBrokenAlert,       title='Supply Broken',        message='⚫ Zone Engine: SUPPLY ditembus close penuh (Bullish BOS) — zona dihapus, cari zona baru.')
alertcondition(zoneExpiredAlert,        title='Zone Expired',         message='⏳ Zone Engine: Zona kadaluarsa (tidak terpakai) — dihapus otomatis.')
alertcondition(freshEntryReady,         title='Fresh Entry Ready',    message='🎯 Zone Engine: Sinyal entry di zona FRESH berkualitas — cek SL/TP & lot sekarang!')

// =====================================================================================================================
// 🌟 BAGIAN 9.7: SNIPER SIGNAL, DASHBOARD INSTITUTIONAL & ALERT PHASE 2 — BARU (ADDITIVE)
// =====================================================================================================================
// FITUR 28 — SNIPER ENTRY: buySetup/sellSetup kini sudah lolos SEMUA gerbang institusional + Confidence >= minimum
bool sniperBuyNow  = instEngineOn and buySetup
bool sniperSellNow = instEngineOn and sellSetup

var array<label> sniperLabels = array.new<label>()
if showSniperBig and barstate.isconfirmed and debugMode
    if sniperBuyNow
        if sniperLabels.size() >= 10
            label.delete(sniperLabels.pop())
        sniperLabels.unshift(label.new(bar_index, low - atrVal * 2.5, "🎯 SNIPER BUY 🎯\nConfidence " + str.tostring(confBuy) + "%", style = label.style_label_up, color = color.new(color.teal, 0), textcolor = color.white, size = size.large))
    if sniperSellNow
        if sniperLabels.size() >= 10
            label.delete(sniperLabels.pop())
        sniperLabels.unshift(label.new(bar_index, high + atrVal * 2.5, "🎯 SNIPER SELL 🎯\nConfidence " + str.tostring(confSell) + "%", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.large))

// TOKEN-FIX (CE10117): panel 🏛 Institutional dihapus — liquidity/OTE/OB/Smart SL-TP sudah tampil di panel 🚀 & Compact.

// FITUR 32 — ALERT PHASE 2
bool oteEntryFlag       = instEngineOn and barstate.isconfirmed and ((inOTEBuy and not inOTEBuy[1] and microTrend == "BULLISH 🟢") or (inOTESell and not inOTESell[1] and microTrend == "BEARISH 🔴"))
bool highConfluenceFlag = barstate.isconfirmed and highConfluenceNow and not highConfluenceNow[1]
bool conf95Flag         = instEngineOn and barstate.isconfirmed and math.max(confBuy, confSell) >= 95 and math.max(confBuy[1], confSell[1]) < 95

alertcondition(liqSweepAlertFlag,  title='Liquidity Sweep',   message='💧 Institutional: Liquidity diambil (sweep) — pantau pembalikan arah.')
alertcondition(oteEntryFlag,       title='OTE Entry',         message='📐 Institutional: Harga masuk OTE Zone (0.618–0.786) — area entry optimal.')
alertcondition(highConfluenceFlag, title='High Confluence',   message='⭐ Institutional: HIGH CONFLUENCE — Fresh S&D + Fresh OB + OTE + FVG saling overlap!')
alertcondition(sniperBuyNow,       title='SNIPER BUY',        message='🎯 Institutional: SNIPER BUY — semua filter institusional lolos + Confidence tinggi!')
alertcondition(sniperSellNow,      title='SNIPER SELL',       message='🎯 Institutional: SNIPER SELL — semua filter institusional lolos + Confidence tinggi!')
alertcondition(conf95Flag,         title='Confidence > 95%',  message='🔥 Institutional: Confidence menembus 95% — momen SNIPER ★★★★★.')

// =====================================================================================================================
// 🌟 BAGIAN 9.8: SMART TRADE MANAGEMENT, EXPLANATION, PERFORMA & PANEL AI (PHASE 3) — BARU (ADDITIVE)
// =====================================================================================================================

// ---------- FITUR 44 : ENTRY EXPLANATION ENGINE (setiap BUY/SELL punya alasan) ----------
f_buildReason(bool isBuy) =>
    string rE = ""
    rE += (isBuy ? recentBullBOS : recentBearBOS) ? (isBuy ? "✓ Bullish BOS\n" : "✓ Bearish BOS\n") : ""
    rE += (isBuy ? inQualifiedDemand : inQualifiedSupply) ? (isBuy ? "✓ Fresh Demand\n" : "✓ Fresh Supply\n") : ""
    rE += (isBuy ? sslSweptRecent : bslSweptRecent) ? "✓ Liquidity Sweep\n" : ""
    rE += (isBuy ? inOTEBuy : inOTESell) ? "✓ OTE\n" : ""
    rE += hasFVG ? "✓ FVG\n" : ""
    rE += (isBuy ? inDiscount : inPremium) ? (isBuy ? "✓ Discount Zone\n" : "✓ Premium Zone\n") : ""
    rE += sessionScore >= 5 ? "✓ " + (inOverlapSess ? "Overlap Session" : inLondonSess ? "London Session" : "New York Session") + "\n" : ""
    rE += "✓ Grade " + f_grade(isBuy ? confBuy : confSell)
    rE

// ---------- FITUR 46 : REPLAY ANALYSIS — alasan PENOLAKAN entry (urut sesuai gerbang filter) ----------
// SCOPE-FIX + COMPILE-FIX: assignment berurutan dangkal (dibalik) — urutan cek & seluruh teks identik
f_rejectReason(bool isBuy) =>
    string rr = "Filter dasar (skor/EQ/rejection)"
    rr := (isBuy ? not eqOkBuy : not eqOkSell) ? "Candle: " + (isBuy ? eqReasonBuy : eqReasonSell) : rr
    rr := (isBuy ? not confOkBuy : not confOkSell) ? "Confidence " + str.tostring(isBuy ? confBuy : confSell) + "% < minimum" : rr
    rr := not spreadOk ? "Spread mahal" : rr
    rr := not atrOk ? "Low ATR" : rr
    rr := (isBuy ? not pdOkBuy : not pdOkSell) ? (isBuy ? "Bukan zona Discount" : "Bukan zona Premium") : rr
    rr := (isBuy ? not oteOkBuy : not oteOkSell) ? "Di luar OTE Zone" : rr
    rr := (isBuy ? not liqOkBuy : not liqOkSell) ? (isBuy ? "Belum ada Liquidity Sweep (SSL)" : "Belum ada Liquidity Sweep (BSL)") : rr
    rr := (isBuy ? not zoneOkBuy : not zoneOkSell) ? "Di luar Fresh Zone berkualitas" : rr
    rr := (isBuy ? not obOkBuy : not obOkSell) ? "Di luar Order Block" : rr
    rr

var string lastEntryReason  = "—"
var string lastEntryInfo    = "Belum ada entry"
var string lastRejectReason = "—"

if barstate.isconfirmed and instEngineOn and aiEngineOn
    if buySetup
        lastEntryReason := f_buildReason(true)
        lastEntryInfo   := "BUY @ " + str.tostring(close, format.mintick)
    if sellSetup
        lastEntryReason := f_buildReason(false)
        lastEntryInfo   := "SELL @ " + str.tostring(close, format.mintick)
    if buySetupRaw and not buySetup
        lastRejectReason := "BUY ditolak: " + f_rejectReason(true)
    if sellSetupRaw and not sellSetup
        lastRejectReason := "SELL ditolak: " + f_rejectReason(false)

// ---------- FITUR 41 : SMART TRADE MANAGEMENT (rekomendasi BE & trailing — WR engine lama tidak diubah) ----------
var int    mgmtDir     = 0
var float  mgmtEntryPx = na
var float  mgmtTP1     = na
var float  mgmtTP2     = na
var bool   mgmtTP1Hit  = false
var bool   mgmtTP2Hit  = false
var string mgmtStatus  = "— Tidak ada posisi"

bool mgmtTP1HitNow = false
bool mgmtTP2HitNow = false
if barstate.isconfirmed
    if buySetup or sellSetup
        mgmtDir     := buySetup ? 1 : -1
        mgmtEntryPx := close
        mgmtTP1     := buySetup ? smartBuyTP1 : smartSellTP1
        mgmtTP2     := buySetup ? smartBuyTP2 : smartSellTP2
        mgmtTP1Hit  := false
        mgmtTP2Hit  := false
        mgmtStatus  := (buySetup ? "🟢 LONG" : "🔴 SHORT") + " aktif — SL awal normal"
    else if mgmtDir != 0
        if not mgmtTP1Hit and ((mgmtDir == 1 and high >= mgmtTP1) or (mgmtDir == -1 and low <= mgmtTP1))
            mgmtTP1Hit    := true
            mgmtTP1HitNow := true
            mgmtStatus    := "✅ TP1 tercapai — PINDAHKAN SL KE BREAK EVEN (" + str.tostring(mgmtEntryPx, format.mintick) + ")"
        if mgmtTP1Hit and not mgmtTP2Hit and ((mgmtDir == 1 and high >= mgmtTP2) or (mgmtDir == -1 and low <= mgmtTP2))
            mgmtTP2Hit    := true
            mgmtTP2HitNow := true
            mgmtStatus    := "✅ TP2 tercapai — AKTIFKAN TRAILING ATR (" + str.tostring(atrVal, format.mintick) + ")"
        if activePos == 0
            mgmtDir    := 0
            mgmtStatus := mgmtTP2Hit ? "🏁 Selesai (TP2+)" : mgmtTP1Hit ? "🏁 Selesai setelah TP1" : "🏁 Selesai (SL/TP) — flat"

alertcondition(mgmtTP1HitNow, title='TP1 Hit - Move SL to BE',    message='🛡 AI Engine: TP1 tercapai — rekomendasi: pindahkan Stop Loss ke Break Even.')
alertcondition(mgmtTP2HitNow, title='TP2 Hit - Trailing ATR',     message='🚀 AI Engine: TP2 tercapai — rekomendasi: aktifkan Trailing Stop berbasis ATR.')

// ---------- FITUR 45 : PERFORMANCE DASHBOARD (statistik — WR engine lama hanya dibaca, tidak diubah) ----------
var int   todayTradesAI    = 0
var int   todayWinsAI      = 0
var int   todayLossAI      = 0
var float confSumEntries   = 0.0
var int   confCountEntries = 0
var int   bestConfEntry    = 0

bool newDayP3 = ta.change(time("D")) != 0
if barstate.isconfirmed
    if newDayP3
        todayTradesAI := 0
        todayWinsAI   := 0
        todayLossAI   := 0
    if buySetup or sellSetup
        todayTradesAI += 1
        int cNow = buySetup ? confBuy : confSell
        confSumEntries   += cNow
        confCountEntries += 1
        if cNow > bestConfEntry
            bestConfEntry := cNow
    if winTrades > nz(winTrades[1])
        todayWinsAI += winTrades - nz(winTrades[1])
    if lossTrades > nz(lossTrades[1])
        todayLossAI += lossTrades - nz(lossTrades[1])

float wrRRUsed = wrTargetMode == "TP1 (0.5R)" ? tp1RR : wrTargetMode == "TP2 (1.0R)" ? tp2RR : tpRR
float avgRRAI = totalTrades > 0 ? (winTrades * wrRRUsed - lossTrades) / totalTrades : 0.0
float avgConfEntries = confCountEntries > 0 ? confSumEntries / confCountEntries : 0.0

// TOKEN-FIX (CE10117): panel 🤖 AI dihapus — regime/grade/bias/TP dinamis tampil di panel 🧠 + 🚀 + Compact.

// =====================================================================================================================
// 🌟 BAGIAN 9.9: DECISION CORE — STATUS FINAL, PANEL 🧠 & SIGNAL LOCK (PHASE 3.5) — BARU (ADDITIVE)
// =====================================================================================================================
// FITUR 50/54 — output final HANYA: BUY / SELL / WAIT. Tidak ada status lain.
string dcState = buySetup ? "BUY" : sellSetup ? "SELL" : "WAIT"

// Arah acuan untuk penjelasan WAIT: ikut HTF Bias, fallback ke trigger chart
bool dcDirBull = biasDir == 1 ? true : biasDir == -1 ? false : microTrend != "BEARISH 🔴"

// FITUR 56 — NEXT ACTION ENGINE
string dcWaitReasonRaw = dcDirBull ? dcBuyFailReason : dcSellFailReason
string dcWaitNextRaw   = dcDirBull ? dcBuyNextAction : dcSellNextAction
string dcWaitReason = dcWaitReasonRaw == "" ? "Menunggu trigger pattern (rejection + volume + skor)" : dcWaitReasonRaw
string dcNextAction = dcState != "WAIT" ? "Eksekusi — kelola SL/TP (lihat panel AI)" : dcWaitNextRaw == "" ? "Wait Setup Trigger di Zona" : dcWaitNextRaw

// FITUR 55 — REASON ENGINE: checklist lengkap ✓/❌ mengikuti hierarki (dihitung hanya saat islast — FITUR 60)
f_dcChecklist(bool isBuy) =>
    string s = ""
    s += (isBuy ? biasDir == 1 : biasDir == -1) ? (isBuy ? "✓ HTF Bullish\n" : "✓ HTF Bearish\n") : "❌ HTF Bias\n"
    s += (isBuy ? regimeOkBuy : regimeOkSell) ? "✓ Regime " + regimeName + "\n" : "❌ Regime Melawan\n"
    s += (isBuy ? inQualifiedDemand : inQualifiedSupply) ? (isBuy ? "✓ Fresh Demand\n" : "✓ Fresh Supply\n") : (isBuy ? "❌ Fresh Demand\n" : "❌ Fresh Supply\n")
    s += dcConflictOn and (isBuy ? inQualifiedSupply : inQualifiedDemand) ? (isBuy ? "❌ Inside Supply\n" : "❌ Inside Demand\n") : "✓ Tanpa Konflik Zona\n"
    s += (isBuy ? sslSweptRecent : bslSweptRecent) ? "✓ Liquidity Sweep\n" : "❌ No Liquidity Sweep\n"
    s += (isBuy ? inOTEBuy : inOTESell) ? "✓ OTE\n" : "❌ Outside OTE\n"
    s += (isBuy ? inBullishOB : inBearishOB) ? "✓ Fresh Order Block\n" : "❌ Order Block\n"
    s += hasFVG ? "✓ FVG\n" : "❌ FVG\n"
    s += (isBuy ? inDiscount : inPremium) ? (isBuy ? "✓ Discount\n" : "✓ Premium\n") : (isBuy ? "❌ Discount\n" : "❌ Premium\n")
    s += (isBuy ? eqOkBuy : eqOkSell) ? "✓ Entry Quality\n" : "❌ " + (isBuy ? eqReasonBuy : eqReasonSell) + "\n"
    s += (isBuy ? confOkBuy : confOkSell) ? "✓ Grade " + f_grade(isBuy ? confBuy : confSell) + " (" + str.tostring(isBuy ? confBuy : confSell) + "%)" : "❌ Confidence Too Low (" + str.tostring(isBuy ? confBuy : confSell) + "%)"
    s

// FITUR 58 — PANEL 🧠 DECISION CORE (bawah-tengah; 1 tabel var — object reuse, FITUR 60)
var table dcDash = table.new(position.bottom_center, 2, 16, bgcolor=C_BG, border_width=1, border_color=C_BORDER, frame_width=2, frame_color=C_BORDER)
// R1.1 REFACTOR (MODUL 3)
f_drawDecisionDashboard() =>
    color dcStateCol = dcState == "BUY" ? color.new(color.teal, 10) : dcState == "SELL" ? color.new(color.red, 10) : C_NEUTRAL
    string dcChecklist = f_dcChecklist(dcDirBull)

    string dcZoneStr = "—"
    int dcBestIdx = f_bestZoneIdx()
    if dcBestIdx >= 0
        sdZone zDC = sdZones.get(dcBestIdx)
        dcZoneStr := (zDC.bias == BULLISH ? "🟩 DEMAND " : "🟥 SUPPLY ") + str.tostring(zDC.bottom, format.mintick) + "–" + str.tostring(zDC.top, format.mintick)

    string dcLiqStr = "SSL " + (sslSweptRecent ? "Swept ✓" : "—") + " | BSL " + (bslSweptRecent ? "Swept ✓" : "—")
    string dcOTEStr = (dcDirBull ? inOTEBuy : inOTESell) ? "✓ Di Dalam OTE" : "✗ Di Luar OTE"
    string dcOBStr  = inBullishOB ? "Di Bull OB ✓" : inBearishOB ? "Di Bear OB ✓" : "Di Luar OB"
    string dcEQStr  = (dcDirBull ? eqOkBuy : eqOkSell) ? "OK ✓" : (dcDirBull ? eqReasonBuy : eqReasonSell)
    string dcConflictStr = conflictActiveNow ? "⚠ ACTIVE — " + lastConflictText : "None ✓ (total " + str.tostring(conflictCount) + ")"

    table.cell(dcDash, 0, 0, "🧠  DECISION CORE (HAKIM AKHIR)", text_color=color.white, text_size=size.normal, bgcolor=C_HEADER, text_halign=text.align_left)
    table.cell(dcDash, 1, 0, dcState, text_color=color.white, text_size=size.normal, bgcolor=C_HEADER, text_halign=text.align_right)

    table.cell(dcDash, 0, 1, "  Current State", text_color=color.white, text_halign=text.align_left, bgcolor=dcStateCol, text_size=size.small)
    table.cell(dcDash, 1, 1, dcState == "WAIT" ? "⏸ WAIT" : "🎯 " + dcState, text_color=color.white, bgcolor=dcStateCol, text_halign=text.align_right, text_size=size.large)

    table.cell(dcDash, 0, 2, "  Decision Grade", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 2, gradeActive + " (" + str.tostring(confActive) + "%)", text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 3, "  Current Conflict", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 3, dcConflictStr, text_color=C_VALUE, bgcolor=conflictActiveNow ? C_BEAR : C_NEUTRAL, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 4, "  Next Action", text_color=color.white, text_halign=text.align_left, bgcolor=C_ACCENT, text_size=size.small)
    table.cell(dcDash, 1, 4, dcNextAction, text_color=color.white, bgcolor=C_ACCENT, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 5, "  Market Regime", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 5, regimeName + " • " + volState, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 6, "  Confidence", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 6, str.tostring(confActive) + "% • " + f_confStars(confActive), text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 7, "  Institutional Bias", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 7, orderFlowBias + " (" + str.tostring(biasStrengthPct) + "%)", text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 8, "  Current Zone", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 8, dcZoneStr, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 9, "  Liquidity Status", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 9, dcLiqStr, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 10, "  OTE Status", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 10, dcOTEStr, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 11, "  Order Block Status", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 11, dcOBStr, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 12, "  FVG Status", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 12, hasFVG ? "🔥 Ada" : "—", text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 13, "  Premium/Discount", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 13, na(pdEquilibrium) ? "—" : inDiscount ? "Discount 🟢" : inPremium ? "Premium 🔴" : "Equilibrium ⚪", text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 14, "  Entry Quality", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(dcDash, 1, 14, dcEQStr, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(dcDash, 0, 15, "  Decision Reason", text_color=C_LABEL, text_halign=text.align_left, text_size=size.tiny)
    table.cell(dcDash, 1, 15, dcChecklist, text_color=C_VALUE, text_halign=text.align_right, text_size=size.tiny)

if barstate.islast and showDCDash and dcEngineOn and proMode and debugMode
    f_drawDecisionDashboard()

// FITUR 53 — SIGNAL LOCK (TOKEN-FIX: sinkronisasi panel status lama dihapus bersama panelnya — status final di Compact)
if barstate.islast and dcEngineOn
    if dcSignalLock and dcState == "WAIT" and not na(bigSignal)
        label.delete(bigSignal)
        bigSignal := na

// =====================================================================================================================
// 🌟 BAGIAN 10: FINAL RELEASE — SIMPLE MODE, AUTO HIDE, SMART ALERT, WIZARD, SCORE & HEALTH — BARU (ADDITIVE)
// =====================================================================================================================

// ---------- FITUR 8 : SETUP SCORE (0–100) ----------
// TOKEN-FIX: f_progressBar dihapus bersama panel pemakainya; setupScore tetap dipakai Smart Alert WAIT.
int setupScore = 0
if instEngineOn
    setupScore += (dcDirBull ? biasDir == 1 : biasDir == -1) ? 10 : 0            // Trend
    setupScore += (dcDirBull ? inQualifiedDemand : inQualifiedSupply) ? 15 : 0   // Zona
    setupScore += (dcDirBull ? sslSweptRecent : bslSweptRecent) ? 15 : 0         // Liquidity
    setupScore += (dcDirBull ? inBullishOB : inBearishOB) ? 10 : 0               // Order Block
    setupScore += (dcDirBull ? inOTEBuy : inOTESell) ? 10 : 0                    // OTE
    setupScore += hasFVG ? 10 : 0                                                // FVG
    setupScore += (dcDirBull ? eqOkBuy : eqOkSell) ? 10 : 0                      // Entry Quality
    setupScore += sessionScore >= 5 ? 5 : sessionScore >= 3 ? 3 : 0              // Session
    setupScore += highVolume ? 5 : 0                                             // Volume
    setupScore += math.round(confActive / 10.0)                                  // Confidence (0-10)

// ---------- FITUR 11 : alasan singkat berbahasa sederhana ----------
// SCOPE-FIX: counter + if diganti concat ternary — batas 3 alasan pertama tetap sama
f_simpleReason(bool isBuy) =>
    bool r1 = isBuy ? biasDir == 1 : biasDir == -1
    bool r2 = isBuy ? inQualifiedDemand : inQualifiedSupply
    bool r3 = isBuy ? sslSweptRecent : bslSweptRecent
    bool r4 = isBuy ? eqOkBuy : eqOkSell
    string rS = (r1 ? (isBuy ? "Trend naik • " : "Trend turun • ") : "") + (r2 ? "Zona fresh • " : "") + (r3 ? "Sapuan likuiditas • " : "") + (r4 and not (r1 and r2 and r3) ? "Momentum kuat • " : "")
    rS == "" ? "Belum ada konfluens kuat" : rS

// ---------- FITUR 9 : ERROR CHECKER (deteksi pengaturan terlalu ketat / bertentangan + rekomendasi) ----------
int strictCount = (requireOBEntry ? 1 : 0) + (useZoneEntry ? 1 : 0) + (requireLiqSweep ? 1 : 0) + (requireOTE ? 1 : 0) + (requirePremDisc ? 1 : 0) + (entryQualityOn ? 1 : 0)
string warnStrict = minConfidence >= 95 and strictCount >= 5 ? "⚠ Pengaturan sangat ketat (Keyakinan " + str.tostring(minConfidence) + " + " + str.tostring(strictCount) + " filter wajib) — sinyal akan sangat jarang. Saran: turunkan Keyakinan Minimal ke 80–85." : minConfidence >= 90 and strictCount >= 6 ? "⚠ Pengaturan ketat — sinyal jarang. Saran: longgarkan 1–2 filter wajib." : ""
string warnWR   = wrTargetMode == "TP1 (0.5R)" ? "⚠ Backtest diukur di TP1 — win rate tampak lebih tinggi dari realita. Saran: pakai TP Final." : ""
string warnTP   = tp1RR >= tpRR ? "⚠ TP1 ≥ TP Final — pengaturan target R:R bertentangan. Saran: TP1 < TP2 < TP Final." : ""
string warnRisk = riskPct > 3 ? "⚠ Risiko per trade " + str.tostring(riskPct, "#.#") + "% terlalu agresif. Saran: maksimal 1–2%." : ""
string topWarning = warnStrict != "" ? warnStrict : warnWR != "" ? warnWR : warnTP != "" ? warnTP : warnRisk

// ---------- FITUR 10 : HEALTH CHECK (status semua engine) ----------
string engineOffList = (zoneEngineOn ? "" : "🟩 Zona Dinamis • ") + (instEngineOn ? "" : "🏦 Analisis Institusi • ") + (aiEngineOn ? "" : "🤖 Analisis Pintar • ") + (dcEngineOn ? "" : "🧠 Keputusan Akhir • ") + (useConfirmedClose ? "" : "Anti-Repaint • ")
bool allEnginesOn = engineOffList == ""
string healthStr = allEnginesOn ? "✅ Semua Engine Aktif" : "⚠ OFF: " + engineOffList

// TOKEN-FIX: teks wizard/preset dipindah ke tooltip input 🧭 (BAGIAN 1F) — function & panelnya dihapus.

// ---------- FITUR 3 : SMART ALERT ----------
// Plot tersembunyi agar alertcondition bisa menyertakan angka via placeholder {{plot("...")}}
plot(buySetup or sellSetup ? close : na, title="Harga Sinyal", display=display.none)
plot(buySetup ? smartBuySL : sellSetup ? smartSellSL : na, title="SL Sinyal", display=display.none)
plot(buySetup ? smartBuyTP1 : sellSetup ? smartSellTP1 : na, title="TP Sinyal", display=display.none)
plot(buySetup ? confBuy : sellSetup ? confSell : na, title="Keyakinan Sinyal", display=display.none)

alertcondition(buySetup,  title='📢 Smart Alert — 🟢 SIAP BELI',  message='📢 {{ticker}} {{interval}}\n🟢 SIAP BELI\nHarga: {{plot("Harga Sinyal")}}\n🛑 SL: {{plot("SL Sinyal")}}\n🎯 TP: {{plot("TP Sinyal")}}\n🎯 Tingkat Keyakinan: {{plot("Keyakinan Sinyal")}}%')
alertcondition(sellSetup, title='📢 Smart Alert — 🔴 SIAP JUAL',  message='📢 {{ticker}} {{interval}}\n🔴 SIAP JUAL\nHarga: {{plot("Harga Sinyal")}}\n🛑 SL: {{plot("SL Sinyal")}}\n🎯 TP: {{plot("TP Sinyal")}}\n🎯 Tingkat Keyakinan: {{plot("Keyakinan Sinyal")}}%')

// alert() dinamis: pesan lengkap + alasan (aktifkan via "Any alert() function call" saat membuat alert)
// R1.1 REFACTOR (MODUL 5)
f_updateAlerts() =>
    if buySetup
        alert("📢 " + syminfo.ticker + " " + timeframe.period + "\n🟢 SIAP BELI\nHarga: " + str.tostring(close, format.mintick) + "\n🛑 SL: " + str.tostring(smartBuySL, format.mintick) + "\n🎯 TP1: " + str.tostring(smartBuyTP1, format.mintick) + " | TP Akhir: " + str.tostring(dynBuyTPF, format.mintick) + "\n🎯 Tingkat Keyakinan: " + str.tostring(confBuy) + "% (⭐ " + f_grade(confBuy) + ")\nAlasan: " + f_simpleReason(true), alert.freq_once_per_bar_close)
    if sellSetup
        alert("📢 " + syminfo.ticker + " " + timeframe.period + "\n🔴 SIAP JUAL\nHarga: " + str.tostring(close, format.mintick) + "\n🛑 SL: " + str.tostring(smartSellSL, format.mintick) + "\n🎯 TP1: " + str.tostring(smartSellTP1, format.mintick) + " | TP Akhir: " + str.tostring(dynSellTPF, format.mintick) + "\n🎯 Tingkat Keyakinan: " + str.tostring(confSell) + "% (⭐ " + f_grade(confSell) + ")\nAlasan: " + f_simpleReason(false), alert.freq_once_per_bar_close)
    if waitAlertOn and dcEngineOn and dcState == "WAIT" and dcNextAction != dcNextAction[1]
        alert("⏸ " + syminfo.ticker + " " + timeframe.period + " — BELUM ADA ENTRY\n📌 Sedang menunggu: " + dcNextAction + "\nSETUP SCORE: " + str.tostring(setupScore) + "%", alert.freq_once_per_bar_close)

if smartAlertOn and barstate.isconfirmed
    f_updateAlerts()

// ---------- FITUR 2 : AUTO HIDE (chart bersih — objek arah berlawanan diredupkan, objek entry hilang saat WAIT) ----------
if autoHideOn and dcEngineOn and barstate.islast
    // SCOPE-FIX: guard "if not na(...)" dihapus — line/label/box.delete(na) adalah no-op yang aman di Pine
    if dcState == "WAIT"
        line.delete(slLine)
        slLine := na
        line.delete(tpLine)
        tpLine := na
        label.delete(slLabel)
        slLabel := na
        label.delete(tpLabel)
        tpLabel := na
        box.delete(oteBox)
        oteBox := na
        line.delete(oteMidLine)
        oteMidLine := na
    if dcState != "WAIT" and sdZones.size() > 0
        for z in sdZones
            if not na(z.zBox) and ((dcState == "BUY" and z.bias == BEARISH) or (dcState == "SELL" and z.bias == BULLISH))
                box.set_bgcolor(z.zBox, color.new(color.gray, 97))
                box.set_border_color(z.zBox, color.new(color.gray, 92))
                box.set_text_color(z.zBox, color.new(color.gray, 95))

// TOKEN-FIX (CE10117): panel Simple lama & panel ⚙ Sistem dihapus — digantikan Dashboard Compact
// (status, SL/TP, confidence, statistik, optimizer, health & peringatan) dalam SATU panel.

// =====================================================================================================================
// 🌟 BAGIAN 11: CATATAN REFACTOR R1.1 (MAIN BODY OUTPUT)
// =====================================================================================================================
// Seluruh dashboard (MODUL 3), visual zona (MODUL 4), dan smart alert (MODUL 5) kini berada di dalam function
// dan hanya DIPANGGIL 1 baris dari main body di lokasi aslinya — urutan eksekusi & hasil 100% identik.
// Blok engine yang menulis state global (WR engine, zone/liquidity tracker, Yata S&R, theme, auto-hide, dsb.)
// sengaja tetap di main body karena Pine v5 melarang function meng-assign variabel global (:=).
// Memindahkannya butuh restrukturisasi state ke object (Phase R2) — berisiko regresi, dilakukan terpisah bila
// error "main body too long" masih muncul setelah R1.1.

// =====================================================================================================================
// 🌟 BAGIAN 9.11 (PHASE 4): ZONE STATUS, PANEL 🚀 EKSEKUSI, BEGINNER PANEL & BEST ENTRY — BARU (ADDITIVE)
// =====================================================================================================================

// ---------- FITUR 65 : ZONE STATUS ENGINE (READY / WAIT RETEST / MITIGATED / WEAK / BROKEN / INVALID) ----------
f_zoneStatusText(sdZone z) =>
    bool insideZ = math.min(high, z.top) - math.max(low, z.bottom) > 0
    z.broken ? "BROKEN" : (bar_index - z.createdBar) > maxZoneAgeInput ? "INVALID" : f_zoneQuality(z) <= 25 ? "WEAK" : z.touchCount >= 1 ? "MITIGATED" : insideZ ? "READY" : "WAIT RETEST"

f_applyZoneStatus() =>
    for z in sdZones
        if not na(z.zBox)
            bool hiddenByAutoHide = autoHideOn and dcEngineOn and ((dcState == "BUY" and z.bias == BEARISH) or (dcState == "SELL" and z.bias == BULLISH))
            if not hiddenByAutoHide and not z.broken
                string zStat = f_zoneStatusText(z)
                int zq = f_zoneQuality(z)
                box.set_text(z.zBox, (z.bias == BULLISH ? "DEMAND " : "SUPPLY ") + f_qualityEmoji(zq) + " " + str.tostring(zq) + "% • " + str.tostring(z.touchCount) + "x • " + zStat)
                if zStat == "READY"
                    box.set_border_width(z.zBox, 3)
                else if zStat == "WAIT RETEST"
                    box.set_border_style(z.zBox, line.style_dashed)
                else if zStat == "INVALID" or zStat == "WEAK"
                    box.set_border_style(z.zBox, line.style_dotted)
                    box.set_bgcolor(z.zBox, color.new(color.gray, 94))

if execEngineOn and showZoneEngine and sdZones.size() > 0 and (barstate.isconfirmed or barstate.islast)
    f_applyZoneStatus()

// TOKEN-FIX: override beginner dihapus bersama panel Simple — bahasa mentor kini ada di panel 🚀 baris "Kenapa?".

// ---------- FITUR 64/68/69/70/71/73/74 : PANEL 🚀 EKSEKUSI FINAL (kanan-tengah) ----------
var table execDash = table.new(position.middle_right, 2, 16, bgcolor=C_BG, border_width=1, border_color=C_BORDER, frame_width=2, frame_color=C_BORDER)

f_execRow(int rowIdx, string nameR, bool okR) =>
    table.cell(execDash, 0, rowIdx, "  " + nameR, text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(execDash, 1, rowIdx, okR ? "✅" : "❌", text_color=okR ? color.lime : color.red, text_halign=text.align_right, text_size=size.small)

f_drawExecDashboard() =>
    bool exDir = dcDirBull
    int  exProg = exDir ? progressBuy : progressSell
    int  exProb = exDir ? probBuy : probSell
    string exState = dcState == "BUY" ? "EXECUTE 🟢" : dcState == "SELL" ? "EXECUTE 🔴" : exProg >= 7 ? "🔥 READY" : "WAIT " + str.tostring(exProg) + "/7"
    color exStateCol = dcState != "WAIT" ? (dcState == "BUY" ? C_BULL : C_BEAR) : exProg >= 7 ? C_ACCENT : C_NEUTRAL

    string zActiveStr = "—"
    int zBI = f_bestZoneIdx()
    if zBI >= 0
        sdZone zBE = sdZones.get(zBI)
        zActiveStr := (zBE.bias == BULLISH ? "🟩 " : "🟥 ") + f_zoneStatusText(zBE) + " @ " + str.tostring(zBE.bottom, format.mintick) + "–" + str.tostring(zBE.top, format.mintick)

    table.cell(execDash, 0, 0, "🚀  EKSEKUSI FINAL", text_color=color.white, text_size=size.normal, bgcolor=C_HEADER, text_halign=text.align_left)
    table.cell(execDash, 1, 0, exState, text_color=color.white, text_size=size.normal, bgcolor=exStateCol, text_halign=text.align_right)

    table.cell(execDash, 0, 1, "  Progress Entry (FITUR 64)", text_color=color.white, text_halign=text.align_left, bgcolor=C_ACCENT, text_size=size.small)
    table.cell(execDash, 1, 1, str.tostring(exProg) + " / 7" + (exProg >= 7 ? " — 🔥 READY TO " + (exDir ? "BUY" : "SELL") : ""), text_color=color.white, bgcolor=C_ACCENT, text_halign=text.align_right, text_size=size.small)

    f_execRow(2, "Trend", exDir ? biasDir == 1 : biasDir == -1)
    f_execRow(3, "🟩 Zona Fresh (Zona Aktif)", exDir ? inQualifiedDemand : inQualifiedSupply)
    f_execRow(4, "💧 Likuiditas Sudah Diambil", exDir ? sslSweptRecent : bslSweptRecent)
    f_execRow(5, "OTE (Area " + (exDir ? "Murah" : "Mahal") + ")", exDir ? inOTEBuy : inOTESell)
    f_execRow(6, "🕯 Trigger Candle", exDir ? triggerBuy : triggerSell)
    f_execRow(7, "EMA Pullback", exDir ? pullbackBuy : pullbackSell)
    f_execRow(8, "Volume", highVolume)

    table.cell(execDash, 0, 9, "  Trigger Aktif", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(execDash, 1, 9, f_triggerName(exDir), text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(execDash, 0, 10, "  Probabilitas Entry", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(execDash, 1, 10, str.tostring(exProb) + "% " + f_probStars(exProb), text_color=C_VALUE, bgcolor=exProb >= 80 ? C_BULL : exProb >= 60 ? C_WARN : C_NEUTRAL, text_halign=text.align_right, text_size=size.small)

    table.cell(execDash, 0, 11, "  ⭐ Rating Entry", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(execDash, 1, 11, f_entryRating(exProb, confActive), text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(execDash, 0, 12, "  Zona Aktif", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(execDash, 1, 12, zActiveStr, text_color=C_VALUE, text_halign=text.align_right, text_size=size.tiny)

    table.cell(execDash, 0, 13, "  Fake Break / Retest", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(execDash, 1, 13, fakeBreakStatus + ((exDir ? retestDoneBuy : retestDoneSell) ? " • Retest ✓" : pendingRetestDir != 0 ? " • Tunggu Retest" : ""), text_color=C_VALUE, text_halign=text.align_right, text_size=size.tiny)

    table.cell(execDash, 0, 14, "  Retry / Exit", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(execDash, 1, 14, retryBlockBuy or retryBlockSell ? retryMsg : earlyExitMsg, text_color=C_VALUE, bgcolor=(retryBlockBuy or retryBlockSell or earlyExitNow) ? C_WARN : C_NEUTRAL, text_halign=text.align_right, text_size=size.tiny)

    table.cell(execDash, 0, 15, "  Kenapa? (Mentor)", text_color=C_LABEL, text_halign=text.align_left, text_size=size.tiny)
    table.cell(execDash, 1, 15, dcState == "WAIT" ? "WAIT karena: " + dcWaitReason + " → Sisa: " + f_execMissing(exDir) : (dcState == "BUY" ? "WHY BUY: " : "WHY SELL: ") + f_simpleReason(dcState == "BUY"), text_color=C_VALUE, text_halign=text.align_right, text_size=size.tiny)

if barstate.islast and showExecDash and execEngineOn and proMode and debugMode
    f_drawExecDashboard()

// ---------- FITUR 72 : 🎯 BEST ENTRY (muncul sekali per sinyal saat SEMUA engine setuju) ----------
var array<label> bestEntryLabels = array.new<label>()
bool bestEntryBuyNow  = showBestEntry and execEngineOn and barstate.isconfirmed and buySetup  and progressBuy  >= 7 and probBuy  >= 90
bool bestEntrySellNow = showBestEntry and execEngineOn and barstate.isconfirmed and sellSetup and progressSell >= 7 and probSell >= 90
if (bestEntryBuyNow or bestEntrySellNow) and debugMode
    if bestEntryLabels.size() >= 6
        label.delete(bestEntryLabels.pop())
    float rrVal = bestEntryBuyNow ? (buyTP - close) / math.max(close - smartBuySL, syminfo.mintick) : (close - sellTP) / math.max(smartSellSL - close, syminfo.mintick)
    string beTxt = "🎯 BEST ENTRY " + (bestEntryBuyNow ? "BUY" : "SELL") + "\nProbability " + str.tostring(bestEntryBuyNow ? probBuy : probSell) + "% • Confidence " + str.tostring(bestEntryBuyNow ? confBuy : confSell) + "%\nRR 1:" + str.tostring(rrVal, "#.#")
    bestEntryLabels.unshift(label.new(bar_index, bestEntryBuyNow ? low - atrVal * 3.5 : high + atrVal * 3.5, beTxt, style = bestEntryBuyNow ? label.style_label_up : label.style_label_down, color = color.new(#FFD700, 10), textcolor = color.black, size = size.large))

// =====================================================================================================================
// 🌟 BAGIAN 9.12 (PHASE 4): EXECUTION ALERTS — BARU (ADDITIVE)
// =====================================================================================================================
bool readyBuyNow   = execEngineOn and barstate.isconfirmed and progressBuy >= 7 and nz(progressBuy[1]) < 7
bool readySellNow  = execEngineOn and barstate.isconfirmed and progressSell >= 7 and nz(progressSell[1]) < 7
bool retryStartNow = execEngineOn and barstate.isconfirmed and ((retryBlockBuy and not retryBlockBuy[1]) or (retryBlockSell and not retryBlockSell[1]))

alertcondition(readyBuyNow,      title='🔥 READY TO BUY',            message='🔥 Execution Engine: 7/7 syarat BUY lengkap — trigger candle terkonfirmasi, siap eksekusi.')
alertcondition(readySellNow,     title='🔥 READY TO SELL',           message='🔥 Execution Engine: 7/7 syarat SELL lengkap — trigger candle terkonfirmasi, siap eksekusi.')
alertcondition(bestEntryBuyNow,  title='🎯 BEST ENTRY BUY',          message='🎯 Execution Engine: BEST ENTRY BUY — semua engine setuju (Probability & Confidence tinggi).')
alertcondition(bestEntrySellNow, title='🎯 BEST ENTRY SELL',         message='🎯 Execution Engine: BEST ENTRY SELL — semua engine setuju (Probability & Confidence tinggi).')
alertcondition(earlyExitNow,     title='⚠ EXIT EARLY',               message='⚠ Execution Engine: kondisi berbalik melawan posisi — pertimbangkan keluar lebih awal.')
alertcondition(retryStartNow,    title='⏳ Entry Gagal - Tunggu Retest', message='⏳ Execution Engine: entry terakhir kena SL — jangan balik arah, tunggu retest baru.')

// =====================================================================================================================
// 🌟 BAGIAN 12 (OPTIMIZATION UPDATE): STATISTICS ENGINE, TRADE PLAN & DASHBOARD COMPACT
// =====================================================================================================================

// ---------- PART 8 : STATISTICS ENGINE — snapshot faktor saat entry + atribusi menang/kalah per faktor ----------
var bool  snapFVG = false
var bool  snapOTE = false
var bool  snapOB  = false
var bool  snapVOL = false
var float eqR     = 0.0
var float eqPeakR = 0.0
var float maxDDR  = 0.0
if barstate.isconfirmed
    if buySetup or sellSetup
        snapFVG := hasFVG
        snapOTE := buySetup ? inOTEBuy : inOTESell
        snapOB  := buySetup ? inBullishOB : inBearishOB
        snapVOL := highVolume
    int dW = winTrades - nz(winTrades[1])
    int dL = lossTrades - nz(lossTrades[1])
    if dW > 0
        eqR += wrRRUsed * dW
        statFvgW += snapFVG ? dW : 0
        statOteW += snapOTE ? dW : 0
        statObW  += snapOB ? dW : 0
        statVolW += snapVOL ? dW : 0
    if dL > 0
        eqR -= dL
        statFvgL += snapFVG ? dL : 0
        statOteL += snapOTE ? dL : 0
        statObL  += snapOB ? dL : 0
        statVolL += snapVOL ? dL : 0
    eqPeakR := math.max(eqPeakR, eqR)
    maxDDR  := math.max(maxDDR, eqPeakR - eqR)

float profitFactorR = lossTrades > 0 ? winTrades * wrRRUsed / lossTrades : winTrades > 0 ? 99.9 : 0.0
float falseSigPct   = totalTrades > 0 ? 100.0 * lossTrades / totalTrades : 0.0
// Expectancy per trade (R) = avgRRAI (sudah dihitung di BAGIAN 9.8 — satu sumber kebenaran, tanpa duplikasi)

// ---------- PART 6 : TRADE PLAN — SATU set objek reuse: ENTRY / STOP LOSS / TP1 / TP2 / TP3 ----------
var line  planEntryLn = line.new(na, na, na, na, color=color.new(#90A4AE, 0), width=2)
var line  planSLLn    = line.new(na, na, na, na, color=color.new(color.red, 0), width=1, style=line.style_dashed)
var line  planTP1Ln   = line.new(na, na, na, na, color=color.new(color.teal, 20), width=1, style=line.style_dotted)
var line  planTP2Ln   = line.new(na, na, na, na, color=color.new(color.teal, 0), width=1, style=line.style_dotted)
var line  planTP3Ln   = line.new(na, na, na, na, color=color.new(color.green, 0), width=2, style=line.style_dotted)
var label planEntryLb = label.new(na, na, "", style=label.style_label_left, textcolor=color.white, color=color.new(#90A4AE, 20), size=size.small)
var label planSLLb    = label.new(na, na, "", style=label.style_label_left, textcolor=color.white, color=color.new(color.red, 20), size=size.small)
var label planTP1Lb   = label.new(na, na, "", style=label.style_label_left, textcolor=color.white, color=color.new(color.teal, 40), size=size.small)
var label planTP2Lb   = label.new(na, na, "", style=label.style_label_left, textcolor=color.white, color=color.new(color.teal, 20), size=size.small)
var label planTP3Lb   = label.new(na, na, "", style=label.style_label_left, textcolor=color.white, color=color.new(color.green, 20), size=size.small)

if showTradePlan and barstate.isconfirmed and (buySetup or sellSetup)
    bool  tpb = buySetup
    float pE  = close
    float pSL = tpb ? smartBuySL : smartSellSL
    float pT1 = tpb ? smartBuyTP1 : smartSellTP1
    float pT2 = tpb ? smartBuyTP2 : smartSellTP2
    float pT3 = tpb ? dynBuyTPF : dynSellTPF
    int   xR  = bar_index + 15
    line.set_xy1(planEntryLn, bar_index, pE)
    line.set_xy2(planEntryLn, xR, pE)
    line.set_xy1(planSLLn, bar_index, pSL)
    line.set_xy2(planSLLn, xR, pSL)
    line.set_xy1(planTP1Ln, bar_index, pT1)
    line.set_xy2(planTP1Ln, xR, pT1)
    line.set_xy1(planTP2Ln, bar_index, pT2)
    line.set_xy2(planTP2Ln, xR, pT2)
    line.set_xy1(planTP3Ln, bar_index, pT3)
    line.set_xy2(planTP3Ln, xR, pT3)
    label.set_xy(planEntryLb, xR, pE)
    label.set_text(planEntryLb, "ENTRY " + str.tostring(pE, format.mintick))
    label.set_xy(planSLLb, xR, pSL)
    label.set_text(planSLLb, "STOP LOSS " + str.tostring(pSL, format.mintick))
    label.set_xy(planTP1Lb, xR, pT1)
    label.set_text(planTP1Lb, "TP1 " + str.tostring(pT1, format.mintick))
    label.set_xy(planTP2Lb, xR, pT2)
    label.set_text(planTP2Lb, "TP2 " + str.tostring(pT2, format.mintick))
    label.set_xy(planTP3Lb, xR, pT3)
    label.set_text(planTP3Lb, "TP3 " + str.tostring(pT3, format.mintick))

// ---------- PART 4/12 : DASHBOARD COMPACT — SATU panel, jelas dalam 10 detik ----------
var table cleanDash = table.new(f_panelPos(simplePosInput), 2, 14, bgcolor=C_BG, border_width=1, border_color=C_BORDER, frame_width=2, frame_color=C_BORDER)

f_drawCleanDashboard() =>
    bool cdBull = mgmtDir != 0 ? mgmtDir == 1 : dcDirBull
    int  shownConf = useSimplePipeline ? (cdBull ? coreConfBuy : coreConfSell) : confActive
    string cdState = dcState == "BUY" ? "🟢 BUY" : dcState == "SELL" ? "🔴 SELL" : "⏸ WAIT"
    color  cdCol   = dcState == "BUY" ? C_BULL : dcState == "SELL" ? C_BEAR : C_WARN
    string structTxt = (recentBullBOS or recentBullChoch) and not (recentBearBOS or recentBearChoch) ? "Bullish 🟢" : (recentBearBOS or recentBearChoch) and not (recentBullBOS or recentBullChoch) ? "Bearish 🔴" : "Netral ⚪"
    float cdSL  = cdBull ? smartBuySL : smartSellSL
    float cdTP1 = cdBull ? smartBuyTP1 : smartSellTP1
    float cdTP2 = cdBull ? smartBuyTP2 : smartSellTP2
    float cdTP3 = cdBull ? dynBuyTPF : dynSellTPF
    string optStat = not autoOptimizerOn ? "Optimizer OFF" : (fvgMult == 0.0 ? "FVG: cuti (rugi)" : fvgMult > 1.0 ? "FVG: bobot ↑" : "FVG: normal") + " • " + (oteMult == 0.0 ? "OTE: cuti (rugi)" : oteMult > 1.0 ? "OTE: bobot ↑" : "OTE: normal")

    table.cell(cleanDash, 0, 0, cdState, text_color=color.white, text_size=size.large, bgcolor=cdCol, text_halign=text.align_left)
    table.cell(cleanDash, 1, 0, "Confidence " + str.tostring(shownConf) + "% • " + f_coreBand(shownConf), text_color=color.white, text_size=size.small, bgcolor=cdCol, text_halign=text.align_right)

    table.cell(cleanDash, 0, 1, "  Mode", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 1, tradeModeInput + (useSimplePipeline ? " • SIMPLE" : " • LEGACY"), text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 2, "  Trend", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 2, biasTrend, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 3, "  Structure", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 3, structTxt, text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 4, "  Liquidity Sweep", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 4, (cdBull ? sslSweptRecent : bslSweptRecent) ? "✔" : "—", text_color=C_VALUE, bgcolor=(cdBull ? sslSweptRecent : bslSweptRecent) ? C_BULL : C_NEUTRAL, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 5, "  Entry", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 5, mgmtDir != 0 ? str.tostring(mgmtEntryPx, format.mintick) : str.tostring(close, format.mintick) + " (live)", text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 6, "  SL", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 6, str.tostring(cdSL, format.mintick), text_color=color.white, bgcolor=C_BEAR, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 7, "  TP1", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 7, str.tostring(cdTP1, format.mintick), text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 8, "  TP2", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 8, str.tostring(cdTP2, format.mintick), text_color=C_VALUE, text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 9, "  TP3", text_color=C_LABEL, text_halign=text.align_left, text_size=size.small)
    table.cell(cleanDash, 1, 9, str.tostring(cdTP3, format.mintick), text_color=color.white, bgcolor=color.new(color.green, 30), text_halign=text.align_right, text_size=size.small)

    table.cell(cleanDash, 0, 10, "  Statistik", text_color=C_LABEL, text_halign=text.align_left, text_size=size.tiny)
    table.cell(cleanDash, 1, 10, "WR " + str.tostring(overallWR, "#.#") + "% • PF " + str.tostring(profitFactorR, "#.##") + " • Exp " + str.tostring(avgRRAI, "#.##") + "R", text_color=C_VALUE, text_halign=text.align_right, text_size=size.tiny)

    table.cell(cleanDash, 0, 11, "  Risiko", text_color=C_LABEL, text_halign=text.align_left, text_size=size.tiny)
    table.cell(cleanDash, 1, 11, "DD " + str.tostring(maxDDR, "#.#") + "R • " + str.tostring(totalTrades) + " trade • FalseSig " + str.tostring(falseSigPct, "#.#") + "%", text_color=C_VALUE, text_halign=text.align_right, text_size=size.tiny)

    table.cell(cleanDash, 0, 12, "  Auto Optimizer", text_color=C_LABEL, text_halign=text.align_left, text_size=size.tiny)
    table.cell(cleanDash, 1, 12, optStat, text_color=C_VALUE, text_halign=text.align_right, text_size=size.tiny)

    table.cell(cleanDash, 0, 13, debugMode ? "  Kontribusi Faktor" : "  Kesehatan Sistem", text_color=C_LABEL, text_halign=text.align_left, text_size=size.tiny)
    table.cell(cleanDash, 1, 13, debugMode ? "FVG " + (fvgWRStat < 0 ? "n/a" : str.tostring(fvgWRStat, "#.#") + "%") + " • OTE " + (oteWRStat < 0 ? "n/a" : str.tostring(oteWRStat, "#.#") + "%") + " • Total " + str.tostring(overallWR, "#.#") + "%" : topWarning != "" ? topWarning : healthStr, text_color=C_VALUE, bgcolor=(not debugMode and topWarning != "") ? C_WARN : na, text_halign=text.align_right, text_size=size.tiny)

if barstate.islast and showCleanDash
    f_drawCleanDashboard()
